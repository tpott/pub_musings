---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Trevor Pottinger - About">
  <section class="hero">
    <h1>Hi, I'm Trevor</h1>
    <p class="tagline">Dad of two, cargo bike rider, and software engineer who likes to tinker.</p>
  </section>

  <section class="about">
    <h2>About Me</h2>
    <p>
      I'm a software engineer based near Seattle. Over the years I've worked on
      anti-abuse systems at Facebook and helped scale core products at Plaid &mdash;
      including an early version of Signal, fallback authentication flows for Auth
      and Identity, and developer efficiency tooling.
    </p>
    <p>
      I like building things and tinkering with side projects, especially as the
      landscape of software engineering keeps shifting in interesting ways. Outside
      of work, you'll find me cargo e-biking around the greater Seattle area with
      my two kids.
    </p>
  </section>

  <section class="links">
    <h2>Find Me Online</h2>
    <ul>
      <li><a href="https://github.com/tpott" target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--spacing-xl) 0;
    text-align: center;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }

  .about, .links {
    margin-bottom: var(--spacing-xl);
  }

  .links ul {
    list-style: none;
    display: flex;
    gap: var(--spacing-lg);
  }
</style>
