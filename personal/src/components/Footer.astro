---
const currentYear = new Date().getFullYear();
---

<footer>
  <p>&copy; {currentYear} Trevor Pottinger. All rights reserved.</p>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-top: auto;
  }

  p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-align: center;
    margin: 0;
  }
</style>
