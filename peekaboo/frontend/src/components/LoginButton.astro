---
// LoginButton - Shows a login button when the user is NOT authenticated.
// Checks /api/auth/me on load to determine auth state.
// Placed in top-left corner of the page (same position as LogoutButton, mutually exclusive).
---

<a
  class="login-btn hidden"
  data-testid="login-button"
  href="/login"
  aria-label="Log in"
>
  <!-- Login icon (door with inward arrow) -->
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
    <path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/>
  </svg>
</a>

<script>
  import { checkAuth } from '../lib/auth';

  document.addEventListener('DOMContentLoaded', async () => {
    const btn = document.querySelector('[data-testid="login-button"]') as HTMLAnchorElement;
    if (!btn) return;

    const isAuthenticated = await checkAuth();
    if (!isAuthenticated) {
      btn.classList.remove('hidden');
    }
  });
</script>

<style>
  .login-btn {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
    z-index: 999;
    text-decoration: none;
  }

  .login-btn:hover {
    background: var(--bg-surface-alt);
    color: var(--text-primary);
    transform: scale(1.05);
  }

  .login-btn:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .login-btn:focus:not(:focus-visible) {
    outline: none;
  }

  .login-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .login-btn.hidden {
    display: none;
  }
</style>
