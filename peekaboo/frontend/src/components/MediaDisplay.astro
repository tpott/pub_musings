---
// MediaDisplay - Area to show photos/videos in response to voice commands
---

<div class="media-display" data-testid="media-display" role="region" aria-label="Media display area" aria-live="polite">
  <div class="placeholder">
    <p>Say something like "show me a cat"</p>
  </div>
</div>
<div class="transcript-display" data-testid="transcript-display" role="log" aria-live="polite" aria-label="Voice command history">
</div>

<style>
  .media-display {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 4 / 3;
    background: var(--bg-media);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .placeholder {
    color: var(--text-muted);
    text-align: center;
    padding: 1rem;
    font-size: 1.125rem;
  }

  .media-display :global(img),
  .media-display :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-display :global(.audio-blocked-indicator) {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--audio-blocked-bg);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .media-display :global(.audio-blocked-indicator:hover),
  .media-display :global(.audio-blocked-indicator:focus) {
    background: var(--audio-blocked-hover);
    outline: 2px solid var(--audio-blocked-focus);
  }

  .transcript-display {
    width: 100%;
    max-width: 500px;
    max-height: 100px;
    overflow-y: auto;
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: var(--transcript-bg);
    border-radius: 8px;
  }

  .transcript-display:empty {
    display: none;
  }

  .transcript-display :global(.transcript-entry) {
    color: var(--transcript-text);
    font-size: 0.875rem;
    line-height: 1.4;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--transcript-border);
  }

  .transcript-display :global(.transcript-entry:last-child) {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .media-display {
      max-width: 600px;
    }

    .placeholder {
      font-size: 1.25rem;
    }

    .transcript-display {
      max-width: 600px;
    }
  }
</style>
