---
// MediaDisplay - Area to show photos/videos in response to voice commands
---

<div class="media-display" data-testid="media-display" role="region" aria-label="Media display area" aria-live="polite">
  <div class="placeholder">
    <p>Say something like "show me a cat"</p>
  </div>
</div>

<style>
  .media-display {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 4 / 3;
    background: #2a2a4a;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .placeholder {
    color: #888;
    text-align: center;
    padding: 1rem;
    font-size: 1.125rem;
  }

  .media-display :global(img),
  .media-display :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-display :global(.audio-blocked-indicator) {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .media-display :global(.audio-blocked-indicator:hover),
  .media-display :global(.audio-blocked-indicator:focus) {
    background: rgba(0, 0, 0, 0.95);
    outline: 2px solid #4a9eff;
  }

  @media (min-width: 768px) {
    .media-display {
      max-width: 600px;
    }

    .placeholder {
      font-size: 1.25rem;
    }
  }
</style>
