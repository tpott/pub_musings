---
// MicButton - Large touch-friendly microphone button for voice input
---

<button class="mic-button" data-testid="mic-button" aria-label="Press to record voice command">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mic-icon">
    <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z"/>
    <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
  </svg>
</button>

<script>
  import { AudioRecorder, transcribeAudio } from '../lib/audio-recorder';

  const button = document.querySelector('[data-testid="mic-button"]') as HTMLButtonElement;
  const recorder = new AudioRecorder();

  if (!AudioRecorder.isSupported()) {
    button.disabled = true;
    button.title = 'Microphone not supported in this browser';
  }

  button.addEventListener('mousedown', startRecording);
  button.addEventListener('touchstart', startRecording, { passive: true });
  button.addEventListener('mouseup', stopRecording);
  button.addEventListener('touchend', stopRecording);
  button.addEventListener('mouseleave', stopRecording);

  async function startRecording(event: Event) {
    if (recorder.isRecording()) return;

    try {
      await recorder.startRecording();
      button.classList.add('recording');
    } catch (error) {
      console.error('Failed to start recording:', error);
    }
  }

  async function stopRecording(event: Event) {
    if (!recorder.isRecording()) return;

    button.classList.remove('recording');

    try {
      const { blob } = await recorder.stopRecording();

      // Dispatch event with the audio blob for the app to handle
      const audioEvent = new CustomEvent('peekaboo:audio-recorded', {
        bubbles: true,
        detail: { blob }
      });
      button.dispatchEvent(audioEvent);

      // Send to transcription API
      const transcript = await transcribeAudio(blob);

      // Dispatch event with transcription result
      const transcriptEvent = new CustomEvent('peekaboo:transcript', {
        bubbles: true,
        detail: { text: transcript }
      });
      button.dispatchEvent(transcriptEvent);
    } catch (error) {
      console.error('Recording/transcription error:', error);

      // Dispatch error event
      const errorEvent = new CustomEvent('peekaboo:error', {
        bubbles: true,
        detail: { error: error instanceof Error ? error.message : 'Unknown error' }
      });
      button.dispatchEvent(errorEvent);
    }
  }
</script>

<style>
  .mic-button {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .mic-button:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
  }

  .mic-button:active {
    transform: scale(0.95);
  }

  .mic-button.recording {
    animation: pulse 1.5s infinite;
    background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
  }

  .mic-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @keyframes pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(245, 87, 108, 0.7);
    }
    50% {
      box-shadow: 0 0 0 20px rgba(245, 87, 108, 0);
    }
  }

  .mic-icon {
    width: 48px;
    height: 48px;
  }

  @media (min-width: 768px) {
    .mic-button {
      width: 150px;
      height: 150px;
    }

    .mic-icon {
      width: 60px;
      height: 60px;
    }
  }
</style>
