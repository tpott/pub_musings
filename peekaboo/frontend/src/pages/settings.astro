---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/theme.css';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Peekaboo account settings" />
    <title>Settings - Peekaboo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeInit />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <ThemeToggle />
    <main id="main-content" tabindex="-1">
      <div class="settings-card">
        <h1 class="settings-title">Account Settings</h1>

        <!-- Loading state -->
        <div id="loading" class="loading">Loading...</div>

        <!-- Load error (shown on network failure) -->
        <div id="load-error" class="hidden load-error">
          <p id="load-error-message">Failed to load account info.</p>
          <button type="button" class="btn-secondary" id="retry-load-btn">Retry</button>
        </div>

        <!-- Account info (shown after load) -->
        <div id="account-info" class="hidden">
          <section class="settings-section">
            <h2>Account</h2>
            <div class="info-row">
              <span class="info-label">Email</span>
              <span class="info-value" id="user-email"></span>
            </div>
            <div class="info-row">
              <span class="info-label">Email verified</span>
              <span class="info-value" id="email-verified"></span>
            </div>
            <div class="info-row">
              <span class="info-label">Member since</span>
              <span class="info-value" id="created-at"></span>
            </div>
          </section>

          <section class="settings-section">
            <h2>Two-Factor Authentication</h2>
            <div class="info-row">
              <span class="info-label">Status</span>
              <span class="info-value" id="totp-status"></span>
            </div>

            <!-- TOTP disabled: show setup button -->
            <div id="totp-setup-area" class="hidden">
              <button type="button" class="btn-secondary" id="setup-totp-btn">
                Set up 2FA
              </button>
            </div>

            <!-- TOTP enabled: show disable button -->
            <div id="totp-disable-area" class="hidden">
              <button type="button" class="btn-danger" id="disable-totp-btn">
                Disable 2FA
              </button>
            </div>
          </section>

          <!-- TOTP success message (outside flow so it stays visible after flow hides) -->
          <div class="form-success hidden" id="setup-success" role="status"></div>

          <!-- TOTP setup flow -->
          <section id="totp-setup-flow" class="settings-section hidden">
            <h2>Set Up Two-Factor Authentication</h2>

            <div class="form-error hidden" id="setup-error" role="alert"></div>

            <div id="qr-step">
              <p class="setup-instructions">
                Scan the QR code below with your authenticator app (Google Authenticator, Authy, etc.):
              </p>

              <div class="qr-container" id="qr-container">
                <p class="loading">Generating...</p>
              </div>

              <details class="secret-backup">
                <summary>Can't scan? Enter code manually</summary>
                <code id="totp-secret-display"></code>
              </details>

              <form id="totp-verify-form" novalidate>
                <div class="form-group">
                  <label for="totp-code">Enter the 6-digit code from your app</label>
                  <input
                    type="text"
                    id="totp-code"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    maxlength="6"
                    autocomplete="one-time-code"
                    placeholder="000000"
                  />
                  <div class="field-error hidden" id="totp-code-error"></div>
                </div>

                <div class="form-group">
                  <label for="setup-password">Confirm your password</label>
                  <input
                    type="password"
                    id="setup-password"
                    autocomplete="current-password"
                    placeholder="Enter your password"
                  />
                  <div class="field-error hidden" id="setup-password-error"></div>
                </div>

                <button type="submit" class="btn-submit" id="verify-totp-btn">
                  Enable 2FA
                </button>
              </form>

              <button type="button" class="btn-text" id="cancel-setup-btn">
                Cancel
              </button>
            </div>
          </section>

          <!-- TOTP disable flow -->
          <section id="totp-disable-flow" class="settings-section hidden">
            <h2>Disable Two-Factor Authentication</h2>

            <div class="form-error hidden" id="disable-error" role="alert"></div>

            <form id="totp-disable-form" novalidate>
              <div class="form-group">
                <label for="disable-password">Confirm your password</label>
                <input
                  type="password"
                  id="disable-password"
                  autocomplete="current-password"
                  placeholder="Enter your password"
                />
                <div class="field-error hidden" id="disable-password-error"></div>
              </div>

              <button type="submit" class="btn-danger" id="confirm-disable-btn">
                Disable 2FA
              </button>
            </form>

            <button type="button" class="btn-text" id="cancel-disable-btn">
              Cancel
            </button>
          </section>
        </div>

        <div class="settings-links">
          <a href="/">Back to Peekaboo</a>
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import { getCSRFHeaders, fetchCSRFToken } from '../lib/csrf';

  interface MeUser {
    id: string;
    email: string;
    totp_enabled: boolean;
    email_verified: boolean;
    created_at: string;
  }

  interface MeResponse {
    user?: MeUser;
    error?: string;
  }

  interface TOTPSetupResponse {
    secret?: string;
    uri?: string;
    error?: string;
  }

  interface TOTPActionResponse {
    message?: string;
    error?: string;
  }

  // DOM elements
  const loading = document.getElementById('loading') as HTMLDivElement;
  const loadError = document.getElementById('load-error') as HTMLDivElement;
  const loadErrorMessage = document.getElementById('load-error-message') as HTMLParagraphElement;
  const retryLoadBtn = document.getElementById('retry-load-btn') as HTMLButtonElement;
  const accountInfo = document.getElementById('account-info') as HTMLDivElement;
  const userEmail = document.getElementById('user-email') as HTMLSpanElement;
  const emailVerified = document.getElementById('email-verified') as HTMLSpanElement;
  const createdAt = document.getElementById('created-at') as HTMLSpanElement;
  const totpStatus = document.getElementById('totp-status') as HTMLSpanElement;
  const totpSetupArea = document.getElementById('totp-setup-area') as HTMLDivElement;
  const totpDisableArea = document.getElementById('totp-disable-area') as HTMLDivElement;
  const setupTotpBtn = document.getElementById('setup-totp-btn') as HTMLButtonElement;
  const disableTotpBtn = document.getElementById('disable-totp-btn') as HTMLButtonElement;

  // TOTP setup flow elements
  const totpSetupFlow = document.getElementById('totp-setup-flow') as HTMLElement;
  const setupError = document.getElementById('setup-error') as HTMLDivElement;
  const setupSuccess = document.getElementById('setup-success') as HTMLDivElement;
  const qrContainer = document.getElementById('qr-container') as HTMLDivElement;
  const totpSecretDisplay = document.getElementById('totp-secret-display') as HTMLElement;
  const totpVerifyForm = document.getElementById('totp-verify-form') as HTMLFormElement;
  const totpCodeInput = document.getElementById('totp-code') as HTMLInputElement;
  const totpCodeError = document.getElementById('totp-code-error') as HTMLDivElement;
  const setupPasswordInput = document.getElementById('setup-password') as HTMLInputElement;
  const setupPasswordError = document.getElementById('setup-password-error') as HTMLDivElement;
  const verifyTotpBtn = document.getElementById('verify-totp-btn') as HTMLButtonElement;
  const cancelSetupBtn = document.getElementById('cancel-setup-btn') as HTMLButtonElement;

  // TOTP disable flow elements
  const totpDisableFlow = document.getElementById('totp-disable-flow') as HTMLElement;
  const disableError = document.getElementById('disable-error') as HTMLDivElement;
  const totpDisableForm = document.getElementById('totp-disable-form') as HTMLFormElement;
  const disablePasswordInput = document.getElementById('disable-password') as HTMLInputElement;
  const disablePasswordError = document.getElementById('disable-password-error') as HTMLDivElement;
  const confirmDisableBtn = document.getElementById('confirm-disable-btn') as HTMLButtonElement;
  const cancelDisableBtn = document.getElementById('cancel-disable-btn') as HTMLButtonElement;

  function showError(el: HTMLDivElement, message: string): void {
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function hideError(el: HTMLDivElement): void {
    el.textContent = '';
    el.classList.add('hidden');
  }

  function showFieldError(el: HTMLDivElement, message: string): void {
    el.textContent = message;
    el.classList.remove('hidden');
  }

  function clearFieldError(el: HTMLDivElement): void {
    el.textContent = '';
    el.classList.add('hidden');
  }

  function updateTOTPDisplay(enabled: boolean): void {
    totpStatus.textContent = enabled ? 'Enabled' : 'Disabled';
    if (enabled) {
      totpSetupArea.classList.add('hidden');
      totpDisableArea.classList.remove('hidden');
    } else {
      totpSetupArea.classList.remove('hidden');
      totpDisableArea.classList.add('hidden');
    }
  }

  function hideAllFlows(): void {
    totpSetupFlow.classList.add('hidden');
    totpDisableFlow.classList.add('hidden');
    hideError(setupError);
    hideError(disableError);
    setupSuccess.classList.add('hidden');
  }

  function showLoadError(message: string): void {
    loading.classList.add('hidden');
    loadErrorMessage.textContent = message;
    loadError.classList.remove('hidden');
  }

  // Load user info
  async function loadUserInfo(): Promise<void> {
    loading.classList.remove('hidden');
    loadError.classList.add('hidden');
    accountInfo.classList.add('hidden');

    let response: Response;
    try {
      response = await fetch('/api/auth/me', {
        credentials: 'same-origin',
      });
    } catch {
      showLoadError('Network error. Please check your connection and try again.');
      return;
    }

    if (response.status === 401 || response.status === 403) {
      window.location.href = '/login';
      return;
    }

    if (!response.ok) {
      showLoadError('Failed to load account info. Please try again.');
      return;
    }

    let data: MeResponse;
    try {
      data = await response.json();
    } catch {
      showLoadError('Unexpected server response. Please try again.');
      return;
    }

    if (!data.user) {
      window.location.href = '/login';
      return;
    }

    const user = data.user;
    userEmail.textContent = user.email;
    emailVerified.textContent = user.email_verified ? 'Yes' : 'No';

    const date = new Date(user.created_at);
    createdAt.textContent = date.toLocaleDateString();

    updateTOTPDisplay(user.totp_enabled);

    loading.classList.add('hidden');
    accountInfo.classList.remove('hidden');
  }

  // Generate QR code using the otpauth URI
  function generateQRCode(uri: string): void {
    // Use an img element pointing to a QR code API
    // The URI is the data to encode, not a URL to fetch
    const img = document.createElement('img');
    img.alt = 'QR code for authenticator app';
    img.width = 200;
    img.height = 200;
    // Generate QR code inline using a canvas-based approach
    // Since we can't add dependencies, we'll display the URI as a manual entry
    // and create a simple visual representation
    qrContainer.replaceChildren();

    // For QR code generation without external deps, show the URI for manual entry
    // The secret is shown in the details/summary below
    const p = document.createElement('p');
    p.className = 'qr-placeholder';
    p.textContent = 'Open your authenticator app and add a new account using the code below.';
    qrContainer.appendChild(p);
  }

  // Setup TOTP button click
  setupTotpBtn.addEventListener('click', async () => {
    hideAllFlows();
    setupTotpBtn.disabled = true;

    try {
      await fetchCSRFToken();

      const response = await fetch('/api/auth/totp/setup', {
        method: 'POST',
        headers: getCSRFHeaders({ 'Content-Type': 'application/json' }),
        credentials: 'same-origin',
      });

      let data: TOTPSetupResponse;
      try {
        data = await response.json();
      } catch {
        showError(setupError, 'Unexpected server response');
        setupTotpBtn.disabled = false;
        return;
      }

      if (!response.ok) {
        showError(setupError, data.error || 'Failed to set up TOTP');
        setupTotpBtn.disabled = false;
        return;
      }

      if (data.uri) {
        generateQRCode(data.uri);
      }
      if (data.secret) {
        totpSecretDisplay.textContent = data.secret;
      }

      totpSetupFlow.classList.remove('hidden');
      totpCodeInput.focus();
    } catch {
      showError(setupError, 'Network error. Please try again.');
    } finally {
      setupTotpBtn.disabled = false;
    }
  });

  // Verify TOTP code and enable
  totpVerifyForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError(setupError);
    clearFieldError(totpCodeError);
    clearFieldError(setupPasswordError);

    const code = totpCodeInput.value.trim();
    const password = setupPasswordInput.value;

    if (!code || code.length !== 6 || !/^\d{6}$/.test(code)) {
      showFieldError(totpCodeError, 'Enter a 6-digit code');
      totpCodeInput.focus();
      return;
    }

    if (!password) {
      showFieldError(setupPasswordError, 'Password is required');
      setupPasswordInput.focus();
      return;
    }

    verifyTotpBtn.disabled = true;
    verifyTotpBtn.textContent = 'Verifying...';

    try {
      const response = await fetch('/api/auth/totp/enable', {
        method: 'POST',
        headers: getCSRFHeaders({ 'Content-Type': 'application/json' }),
        credentials: 'same-origin',
        body: JSON.stringify({ code, password }),
      });

      let data: TOTPActionResponse;
      try {
        data = await response.json();
      } catch {
        showError(setupError, 'Unexpected server response');
        verifyTotpBtn.disabled = false;
        verifyTotpBtn.textContent = 'Enable 2FA';
        return;
      }

      if (!response.ok) {
        showError(setupError, data.error || 'Failed to enable TOTP');
        verifyTotpBtn.disabled = false;
        verifyTotpBtn.textContent = 'Enable 2FA';
        return;
      }

      // Success
      hideAllFlows();
      updateTOTPDisplay(true);
      setupSuccess.textContent = 'Two-factor authentication enabled successfully.';
      setupSuccess.classList.remove('hidden');
    } catch {
      showError(setupError, 'Network error. Please try again.');
      verifyTotpBtn.disabled = false;
      verifyTotpBtn.textContent = 'Enable 2FA';
    }
  });

  // Cancel setup
  cancelSetupBtn.addEventListener('click', () => {
    hideAllFlows();
    totpCodeInput.value = '';
    setupPasswordInput.value = '';
  });

  // Disable TOTP button click
  disableTotpBtn.addEventListener('click', () => {
    hideAllFlows();
    totpDisableFlow.classList.remove('hidden');
    disablePasswordInput.focus();
  });

  // Confirm disable
  totpDisableForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError(disableError);
    clearFieldError(disablePasswordError);

    const password = disablePasswordInput.value;
    if (!password) {
      showFieldError(disablePasswordError, 'Password is required');
      disablePasswordInput.focus();
      return;
    }

    confirmDisableBtn.disabled = true;
    confirmDisableBtn.textContent = 'Disabling...';

    try {
      const response = await fetch('/api/auth/totp/disable', {
        method: 'POST',
        headers: getCSRFHeaders({ 'Content-Type': 'application/json' }),
        credentials: 'same-origin',
        body: JSON.stringify({ password }),
      });

      let data: TOTPActionResponse;
      try {
        data = await response.json();
      } catch {
        showError(disableError, 'Unexpected server response');
        confirmDisableBtn.disabled = false;
        confirmDisableBtn.textContent = 'Disable 2FA';
        return;
      }

      if (!response.ok) {
        showError(disableError, data.error || 'Failed to disable TOTP');
        confirmDisableBtn.disabled = false;
        confirmDisableBtn.textContent = 'Disable 2FA';
        return;
      }

      // Success
      hideAllFlows();
      updateTOTPDisplay(false);
      disablePasswordInput.value = '';
    } catch {
      showError(disableError, 'Network error. Please try again.');
      confirmDisableBtn.disabled = false;
      confirmDisableBtn.textContent = 'Disable 2FA';
    }
  });

  // Cancel disable
  cancelDisableBtn.addEventListener('click', () => {
    hideAllFlows();
    disablePasswordInput.value = '';
  });

  // Clear field errors on input
  totpCodeInput.addEventListener('input', () => clearFieldError(totpCodeError));
  setupPasswordInput.addEventListener('input', () => clearFieldError(setupPasswordError));
  disablePasswordInput.addEventListener('input', () => clearFieldError(disablePasswordError));

  retryLoadBtn.addEventListener('click', () => loadUserInfo());

  // Initialize
  fetchCSRFToken();
  loadUserInfo();
</script>

<style>
  main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 1rem;
  }

  .settings-card {
    background: var(--bg-surface);
    border-radius: 1rem;
    padding: 2rem;
    width: 100%;
    max-width: 480px;
    box-shadow: var(--shadow-card);
  }

  .settings-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .settings-section {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .settings-section:last-of-type {
    border-bottom: none;
  }

  .settings-section h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.375rem 0;
  }

  .info-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .info-value {
    font-size: 0.875rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .loading {
    text-align: center;
    color: var(--text-secondary);
    padding: 2rem 0;
  }

  .load-error {
    text-align: center;
    padding: 2rem 0;
    color: var(--error-text, #dc2626);
  }

  .load-error .btn-secondary {
    margin-top: 0.75rem;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 0.375rem;
  }

  .form-group input {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border-input);
    border-radius: 0.5rem;
    font-size: 1rem;
    font-family: inherit;
    background: var(--bg-surface);
    color: var(--text-primary);
    box-sizing: border-box;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--focus-ring-shadow);
  }

  .form-group input::placeholder {
    color: var(--text-secondary);
    opacity: 0.6;
  }

  .field-error {
    font-size: 0.8125rem;
    color: var(--error-text);
    margin-top: 0.25rem;
  }

  .form-error {
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error-text);
    padding: 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .form-success {
    background: var(--success-bg);
    border: 1px solid var(--success-border);
    color: var(--success-text);
    padding: 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .btn-submit {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    background: var(--accent);
    border: none;
    color: var(--text-on-accent);
    margin-top: 0.5rem;
  }

  .btn-submit:hover {
    background: var(--accent-hover);
  }

  .btn-submit:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-secondary {
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    background: var(--bg-surface-alt);
    border: 1px solid var(--border);
    color: var(--text-primary);
    margin-top: 0.75rem;
  }

  .btn-secondary:hover {
    background: var(--bg-surface);
    border-color: var(--accent);
  }

  .btn-secondary:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .btn-secondary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-danger {
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    background: var(--error-text);
    border: none;
    color: white;
    margin-top: 0.75rem;
  }

  .btn-danger:hover {
    opacity: 0.9;
  }

  .btn-danger:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .btn-danger:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    padding: 0.5rem;
    margin-top: 0.5rem;
  }

  .btn-text:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .setup-instructions {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .qr-container {
    text-align: center;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .qr-placeholder {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-style: italic;
  }

  .secret-backup {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .secret-backup summary {
    cursor: pointer;
    margin-bottom: 0.5rem;
  }

  .secret-backup code {
    display: block;
    background: var(--bg-surface-alt);
    padding: 0.75rem;
    border-radius: 0.375rem;
    font-family: monospace;
    font-size: 0.875rem;
    word-break: break-all;
    color: var(--text-primary);
    margin-top: 0.5rem;
  }

  .settings-links {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .settings-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .settings-links a:hover {
    text-decoration: underline;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 480px) {
    .settings-card {
      padding: 1.5rem;
    }

    .form-group input {
      padding: 0.75rem;
      font-size: 1rem;
    }

    .btn-submit,
    .btn-danger {
      padding: 0.875rem 1rem;
      font-size: 1.0625rem;
    }
  }
</style>
