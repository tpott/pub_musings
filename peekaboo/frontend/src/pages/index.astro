---
import MicButton from '../components/MicButton.astro';
import MediaDisplay from '../components/MediaDisplay.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Voice-controlled media display for kids" />
    <title>Peekaboo</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <h1 class="title">Peekaboo!</h1>
      <MediaDisplay />
      <MicButton />
    </main>
  </body>
</html>

<script>
  import { PeekabooFlow } from '../lib/peekaboo-flow';
  import { AudioRecorder } from '../lib/audio-recorder';

  /**
   * Show a visible error message when the browser doesn't support voice recording
   */
  function showBrowserSupportError(container: HTMLElement): void {
    container.innerHTML = `
      <div class="browser-error" role="alert">
        <h2>Browser Not Supported</h2>
        <p>Your browser doesn't support voice recording.</p>
        <p>Please try one of these browsers:</p>
        <ul>
          <li>Chrome (version 49+)</li>
          <li>Firefox (version 25+)</li>
          <li>Safari (version 14.1+)</li>
          <li>Edge (version 79+)</li>
        </ul>
      </div>
    `;
    container.setAttribute('aria-label', 'Browser not supported error');
  }

  // Initialize the flow when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const micButton = document.querySelector('[data-testid="mic-button"]') as HTMLButtonElement;
    const mediaContainer = document.querySelector('[data-testid="media-display"]') as HTMLElement;

    if (!micButton || !mediaContainer) {
      console.error('Peekaboo: Required elements not found');
      return;
    }

    // Check if microphone is supported
    if (!AudioRecorder.isSupported()) {
      micButton.disabled = true;
      micButton.title = 'Microphone not supported in this browser';
      micButton.setAttribute('aria-label', 'Microphone not supported');

      // Show visible error banner instead of just a tooltip
      showBrowserSupportError(mediaContainer);
      return;
    }

    // WebSocket mode is enabled by default for continuous listening UX
    // Can be disabled via query param: ?useWebSocket=false
    const urlParams = new URLSearchParams(window.location.search);
    const useWebSocket = urlParams.get('useWebSocket') !== 'false' &&
                        (window as any).__PEEKABOO_USE_WEBSOCKET__ !== false;

    // Initialize the full flow
    new PeekabooFlow({
      micButton,
      mediaContainer,
      useWebSocket,
      onStateChange: (state) => {
        console.log('Peekaboo state:', state);
      },
      onError: (error) => {
        console.error('Peekaboo error:', error);
      },
    });
  });
</script>

<style>
  .title {
    font-size: 2.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 3rem;
    }
  }

  /* Browser support error styling */
  .browser-error {
    text-align: center;
    padding: 2rem;
    background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
    border-radius: 1rem;
    color: #991b1b;
    max-width: 400px;
    margin: 0 auto;
  }

  .browser-error h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
  }

  .browser-error p {
    margin: 0.5rem 0;
    font-size: 1rem;
  }

  .browser-error ul {
    text-align: left;
    display: inline-block;
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .browser-error li {
    margin: 0.25rem 0;
  }
</style>
