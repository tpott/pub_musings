# Peekaboo Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080                           # HTTP server port

# Database
DB_PATH=data/peekaboo.db            # SQLite database path
DB_MAX_OPEN_CONNS=1                 # Max open connections (default: 1, recommended for SQLite)
DB_MAX_IDLE_CONNS=1                 # Max idle connections (default: 1)

# Media Files
MEDIA_DIR=data/media                # Directory containing media files

# Encryption (Optional)
AGE_KEY_FILE=data/age.key           # Path to age encryption key file
                                    # If not present, media served unencrypted

# LLM Provider Configuration
LLM_PROVIDER=anthropic              # "anthropic" or "openai"

# API Keys (provide one based on LLM_PROVIDER)
ANTHROPIC_API_KEY=                  # Required if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                     # Required if LLM_PROVIDER=openai

# External Services
WHISPER_SERVER_URL=http://127.0.0.1:8765  # URL to whisper-server for transcription
PIPER_SERVER_URL=                         # URL to Piper TTS server (optional)
                                          # e.g., http://localhost:5000

# CORS Configuration
ALLOWED_ORIGIN=*                    # Allowed origin for CORS
                                    # Set to specific origin in production
                                    # e.g., https://peekaboo.example.com

# Logging Configuration
LOG_LEVEL=info                      # Log level: debug, info, warn, error
LOG_FORMAT=text                     # Log format: text (default), json (production)
