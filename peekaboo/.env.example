# Peekaboo Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080                           # HTTP server port

# Database
DB_PATH=data/peekaboo.db            # SQLite database path
DB_MAX_OPEN_CONNS=1                 # Max open connections (default: 1, recommended for SQLite)
DB_MAX_IDLE_CONNS=1                 # Max idle connections (default: 1)

# Media Files
MEDIA_DIR=data/media                # Directory containing media files

# Encryption (Optional)
AGE_KEY_FILE=data/age.key           # Path to age encryption key file
                                    # If not present, media served unencrypted

# LLM Provider Configuration
LLM_PROVIDER=anthropic              # "anthropic" or "openai"

# API Keys (provide one based on LLM_PROVIDER)
ANTHROPIC_API_KEY=                  # Required if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                     # Required if LLM_PROVIDER=openai

# External Services
WHISPER_SERVER_URL=http://127.0.0.1:8765  # URL to whisper-server for transcription
PIPER_SERVER_URL=                         # URL to Piper TTS server (optional)
                                          # e.g., http://localhost:8051

# Proxy Configuration
# TRUST_PROXY_HEADERS=false         # Trust X-Forwarded-For/X-Real-IP headers
                                    # Set to true only when behind a trusted reverse proxy
                                    # Default: false (uses RemoteAddr for rate limiting)

# CORS Configuration
ALLOWED_ORIGIN=*                    # Allowed origin for CORS
                                    # Set to specific origin in production
                                    # e.g., https://peekaboo.example.com

# WebSocket Configuration
WEBSOCKET_IDLE_TIMEOUT_SECS=300     # WebSocket idle timeout in seconds (default: 300)
WEBSOCKET_MAX_CONNECTIONS=100       # Max concurrent WebSocket connections (default: 100)

# Logging Configuration
LOG_LEVEL=info                      # Log level: debug, info, warn, error
LOG_FORMAT=text                     # Log format: text (default), json (production)

# Development-only: Frontend Log Forwarding
# FORWARD_FRONTEND_LOGS=true        # Enable POST /api/log endpoint (backend)
                                    # Also set VITE_FORWARD_LOGS=true in frontend

# Admin Access
# TRUSTED_USERS=                    # Comma-separated user IDs for admin endpoints

# Feedback Fetch (for scripts/fetch-feedback.py)
# PROD_HOST=https://peekaboo.example.com
# API_SESSION_ID=                   # Session token from production
