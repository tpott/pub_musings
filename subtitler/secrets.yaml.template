# Subtitler Secrets Template
# DO NOT commit this file with actual values
# Use: cp secrets.yaml.template secrets.yaml, fill in values, then encrypt with sops

# GitHub Webhook
WEBHOOK_SECRET: "generate-with: openssl rand -base64 32"

# Backend JWT
JWT_SECRET: "generate-with: openssl rand -base64 32"

# Email (Resend API)
RESEND_API_KEY: "re_xxxxx"  # Get from https://resend.com/api-keys
EMAIL_FROM: "noreply@yourdomain.com"

# URLs
FRONTEND_URL: "https://subtitler.yourdomain.com"
PUBLIC_API_URL: "https://api.subtitler.yourdomain.com"

# Encryption workflow:
# 1. cp secrets.yaml.template secrets.yaml
# 2. Fill in actual values in secrets.yaml
# 3. sops -e secrets.yaml > secrets.enc.yaml
# 4. rm secrets.yaml
# 5. git add secrets.enc.yaml && git commit -m "Add encrypted secrets"
