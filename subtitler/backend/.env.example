# Subtitler Backend Environment Variables
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env files to git

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the backend server listens on
SERVER_PORT=8080

# CORS: Frontend URL for cross-origin requests
# In production, set to your actual frontend URL (e.g., https://subtitler.example.com)
FRONTEND_URL=http://localhost:4321

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT secret for signing tokens
# CRITICAL: Generate a secure random value for production:
#   openssl rand -base64 32
JWT_SECRET=dev-secret-change-in-production

# Set to true when serving over HTTPS (production)
# Required for secure cookie transmission
COOKIE_SECURE=false

# =============================================================================
# DATABASE
# =============================================================================

# Path to SQLite database file
# Created automatically on first run
DATABASE_PATH=./data/db/subtitler.db

# Root directory for all data files (database, uploads, results)
DATA_DIR=./data

# =============================================================================
# EMAIL (via Resend API)
# =============================================================================

# Enable email notifications (job completion, etc.)
ENABLE_EMAIL=false

# Resend API key (get from https://resend.com/api-keys)
RESEND_API_KEY=

# From address for outgoing emails
# Must be verified in Resend dashboard
EMAIL_FROM=noreply@subtitler.example.com

# =============================================================================
# WHISPER.CPP CONFIGURATION
# =============================================================================

# Path to whisper-server binary
WHISPER_SERVER_PATH=/home/trevor/Github/whisper.cpp/build/bin/whisper-server

# Path to whisper model file
# Available models: tiny, base, small, medium, large
# Recommended: medium for balance of speed and accuracy
WHISPER_MODEL_PATH=/home/trevor/Github/whisper.cpp/models/ggml-medium.bin

# Port for whisper-server HTTP API (internal use)
WHISPER_SERVER_PORT=9090

# Number of CPU threads for whisper transcription
# Recommended: number of CPU cores / 2
WHISPER_THREADS=4

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum auth attempts (login/register) per minute per IP
RATE_LIMIT_AUTH_PER_MIN=5

# Maximum file uploads per hour per user
RATE_LIMIT_UPLOAD_PER_HOUR=10

# Maximum requests per minute for public endpoints
RATE_LIMIT_PUBLIC_PER_MIN=100

# Default rate limit for other endpoints per minute
RATE_LIMIT_DEFAULT_PER_MIN=60

# =============================================================================
# ADVANCED (usually don't need to change)
# =============================================================================

# Directory for temporary files during transcription
# Uses system temp directory by default
# TEMP_DIR=/tmp
