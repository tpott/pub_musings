# Subtitler Frontend Environment Variables
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env files to git

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# In development, the frontend proxies /api requests to the backend
# via Vite's proxy configuration in astro.config.mjs
# No environment variables are needed for local development

# =============================================================================
# PRODUCTION CONFIGURATION (optional)
# =============================================================================

# If you need to configure the API URL differently in production,
# you can add PUBLIC_* prefixed variables here.
# See Astro docs: https://docs.astro.build/en/guides/environment-variables/

# Example (if needed in the future):
# PUBLIC_API_URL=https://api.subtitler.example.com

# =============================================================================
# CI/TESTING
# =============================================================================

# Set CI=true in CI environments to:
# - Enable strict mode for Playwright tests (forbidOnly)
# - Add retries for flaky tests
# - Use single worker for deterministic execution
# CI=true
