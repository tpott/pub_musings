---
import Nav from '../components/Nav.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>500 - Server Error | Subtitler</title>
		<style>
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				min-height: 100vh;
				padding: 20px;
			}

			.page-wrapper {
				max-width: 900px;
				margin: 0 auto;
			}

			.main-content {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: calc(100vh - 120px);
			}

			.container {
				background: white;
				border-radius: 12px;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
				padding: 60px 40px;
				max-width: 500px;
				width: 100%;
				text-align: center;
			}

			.error-code {
				font-size: 120px;
				font-weight: 700;
				color: #e53e3e;
				line-height: 1;
				margin-bottom: 16px;
			}

			h1 {
				color: #333;
				margin-bottom: 16px;
				font-size: 24px;
			}

			.description {
				color: #666;
				margin-bottom: 32px;
				font-size: 16px;
				line-height: 1.5;
			}

			.actions {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}

			.btn {
				display: inline-block;
				padding: 14px 24px;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 600;
				text-decoration: none;
				transition: all 0.3s ease;
				cursor: pointer;
				border: none;
			}

			.btn-primary {
				background: #667eea;
				color: white;
			}

			.btn-primary:hover {
				background: #764ba2;
			}

			.btn-secondary {
				background: white;
				color: #667eea;
				border: 2px solid #667eea;
			}

			.btn-secondary:hover {
				background: #667eea;
				color: white;
			}
		</style>
	</head>
	<body>
		<div class="page-wrapper">
			<Nav />
			<div class="main-content">
				<div class="container">
					<div class="error-code">500</div>
					<h1>Something Went Wrong</h1>
					<p class="description">
						We're having trouble processing your request. Please try again in a few moments.
					</p>
					<div class="actions">
						<button class="btn btn-primary" onclick="window.location.reload()">Try Again</button>
						<a href="/" class="btn btn-secondary">Go to Homepage</a>
					</div>
				</div>
			</div>
		</div>

		<script>
			import { trackPageView, trackEvent } from '../lib/analytics';

			// Track page view
			trackPageView();
			trackEvent('error_page_viewed', { error_type: '500', path: window.location.pathname });
		</script>
	</body>
</html>
