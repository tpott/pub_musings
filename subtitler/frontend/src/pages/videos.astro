---
import DevConsoleForwarder from '../components/DevConsoleForwarder.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/theme.css';
---

<html lang="en">
	<head>
		<ThemeInit />
		<DevConsoleForwarder />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>My Videos - Subtitler</title>
		<style>
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 2rem;
			}
			.header-left {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.back-link {
				text-decoration: none;
				color: var(--text-color);
				font-size: 1.5rem;
			}
			.back-link:focus {
				outline: 2px solid var(--accent-color);
				outline-offset: 2px;
			}
			h1 {
				font-size: 2rem;
				font-weight: 600;
			}
			.upload-btn {
				display: inline-block;
				background-color: var(--accent-color);
				color: white;
				padding: 0.75rem 1.5rem;
				border-radius: 6px;
				text-decoration: none;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.upload-btn:hover {
				background-color: var(--accent-hover);
			}
			.loading {
				text-align: center;
				padding: 3rem;
				color: var(--text-secondary);
			}
			.error {
				text-align: center;
				padding: 2rem;
				background-color: var(--error-bg);
				border: 1px solid var(--error-border);
				color: var(--error-color);
				border-radius: 8px;
			}
			.empty-state {
				text-align: center;
				padding: 4rem 2rem;
				background-color: var(--secondary-bg);
				border-radius: 12px;
				border: 2px dashed var(--border-color);
			}
			.empty-icon {
				font-size: 3rem;
				margin-bottom: 1rem;
			}
			.empty-text {
				font-size: 1.25rem;
				color: var(--text-secondary);
				margin-bottom: 1.5rem;
			}
			.video-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.video-card {
				background-color: var(--secondary-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 1.25rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				transition: box-shadow 0.2s;
			}
			.video-card:hover {
				box-shadow: 0 2px 8px var(--card-shadow);
			}
			.video-icon {
				font-size: 2rem;
				flex-shrink: 0;
			}
			.video-thumbnail {
				width: 80px;
				height: 45px;
				object-fit: cover;
				border-radius: 4px;
				background-color: var(--border-color);
				flex-shrink: 0;
			}
			.video-thumbnail-placeholder {
				width: 80px;
				height: 45px;
				background-color: var(--border-color);
				border-radius: 4px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.5rem;
				flex-shrink: 0;
			}
			.video-info {
				flex: 1;
				min-width: 0;
			}
			.video-filename {
				font-weight: 500;
				font-size: 1rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				margin-bottom: 0.25rem;
			}
			.video-meta {
				font-size: 0.875rem;
				color: var(--text-secondary);
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
			}
			.video-actions {
				display: flex;
				gap: 0.5rem;
				flex-shrink: 0;
			}
			.btn {
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 4px;
				text-decoration: none;
				font-size: 0.875rem;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.btn-primary {
				background-color: var(--accent-color);
				color: white;
			}
			.btn-primary:hover {
				background-color: var(--accent-hover);
			}
			.btn-secondary {
				background-color: var(--bg-color);
				color: var(--text-color);
				border: 1px solid var(--border-color);
			}
			.btn-secondary:hover {
				background-color: var(--btn-secondary-hover);
			}
			.btn-retry {
				background-color: var(--btn-danger-color);
				color: white;
				border: none;
				cursor: pointer;
			}
			.btn-retry:hover {
				background-color: var(--btn-danger-hover);
			}
			.btn-retry:disabled {
				background-color: var(--badge-pending-bg);
				color: var(--text-secondary);
				cursor: not-allowed;
			}
			.btn-delete {
				background-color: var(--btn-danger-color);
				color: white;
				border: none;
				cursor: pointer;
			}
			.btn-delete:hover {
				background-color: var(--btn-danger-hover);
			}
			.btn-delete:disabled {
				background-color: var(--badge-pending-bg);
				color: var(--text-secondary);
				cursor: not-allowed;
			}
			.status-badge {
				display: inline-block;
				padding: 0.125rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: 500;
				text-transform: uppercase;
			}
			.status-complete {
				background-color: var(--badge-complete-bg);
				color: var(--badge-complete-text);
			}
			.status-processing {
				background-color: var(--badge-processing-bg);
				color: var(--badge-processing-text);
			}
			.status-pending {
				background-color: var(--badge-pending-bg);
				color: var(--badge-pending-text);
			}
			.status-error {
				background-color: var(--badge-error-bg);
				color: var(--badge-error-text);
			}
			.status-none {
				background-color: var(--badge-none-bg);
				color: var(--badge-none-text);
			}
			.retention-badge {
				display: inline-block;
				padding: 0.125rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: 500;
			}
			.retention-info {
				background-color: var(--retention-info-bg);
				color: var(--retention-info-text);
			}
			.retention-warning {
				background-color: var(--retention-warning-bg);
				color: var(--retention-warning-text);
			}
			.retention-expired {
				background-color: var(--retention-expired-bg);
				color: var(--retention-expired-text);
			}
			.nav {
				display: flex;
				justify-content: flex-end;
				padding: 1rem 2rem;
				gap: 1rem;
			}
			.nav-link {
				color: var(--text-color);
				text-decoration: none;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				transition: background-color 0.2s;
			}
			.nav-link:hover {
				background-color: var(--border-color);
			}
			.nav-user {
				color: var(--text-secondary);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
			}
			.nav-logout {
				background: none;
				border: none;
				color: var(--text-color);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.nav-logout:hover {
				background-color: var(--border-color);
			}
			/* Pagination styles */
			.pagination {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.5rem;
				margin-top: 1.5rem;
				padding: 1rem;
			}
			.pagination-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.5rem 1rem;
				border: 1px solid var(--border-color);
				background: var(--card-bg);
				color: var(--text-color);
				border-radius: 4px;
				font-size: 0.875rem;
				cursor: pointer;
				transition: background-color 0.2s, border-color 0.2s;
			}
			.pagination-btn:hover:not(:disabled) {
				background-color: var(--border-color);
			}
			.pagination-btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
			.pagination-info {
				color: var(--text-secondary);
				font-size: 0.875rem;
				padding: 0 1rem;
			}
			/* Mobile responsive styles */
			@media (max-width: 480px) {
				.nav {
					padding: 0.75rem 1rem;
					gap: 0.5rem;
					flex-wrap: wrap;
				}
				.nav-link, .nav-logout {
					padding: 0.5rem 0.75rem;
					font-size: 0.85rem;
					min-height: 44px;
					display: flex;
					align-items: center;
				}
				.container {
					padding: 1rem;
				}
				.header {
					flex-direction: column;
					align-items: flex-start;
					gap: 1rem;
				}
				.header-left {
					width: 100%;
				}
				h1 {
					font-size: 1.5rem;
				}
				.upload-btn {
					width: 100%;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
				.video-card {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.75rem;
				}
				.video-thumbnail, .video-thumbnail-placeholder {
					width: 100%;
					height: auto;
					aspect-ratio: 16 / 9;
					max-height: 180px;
				}
				.video-info {
					width: 100%;
				}
				.video-filename {
					white-space: normal;
					word-break: break-word;
				}
				.video-meta {
					font-size: 0.8rem;
				}
				.video-actions {
					width: 100%;
					flex-wrap: wrap;
				}
				.btn {
					flex: 1;
					min-width: 70px;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
				.empty-state {
					padding: 2rem 1rem;
				}
				.empty-text {
					font-size: 1rem;
				}
			}
			@media (max-width: 375px) {
				h1 {
					font-size: 1.25rem;
				}
				.container {
					padding: 0.75rem;
				}
				.video-actions {
					flex-direction: column;
				}
				.btn {
					width: 100%;
				}
			}
			/* Video player modal styles */
			.modal-overlay {
				display: none;
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-color: rgba(0, 0, 0, 0.8);
				z-index: 1000;
				overflow-y: auto;
				padding: 1rem;
			}
			.modal-overlay.visible {
				display: flex;
				align-items: flex-start;
				justify-content: center;
			}
			.modal-content {
				background-color: var(--bg-color);
				border-radius: 12px;
				max-width: 900px;
				width: 100%;
				margin: 2rem auto;
				position: relative;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			}
			.modal-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1rem 1.5rem;
				border-bottom: 1px solid var(--border-color);
			}
			.modal-title {
				font-size: 1.25rem;
				font-weight: 600;
				margin: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				max-width: calc(100% - 40px);
			}
			.modal-close {
				background: none;
				border: none;
				font-size: 1.5rem;
				color: var(--text-secondary);
				cursor: pointer;
				padding: 0.25rem 0.5rem;
				line-height: 1;
				border-radius: 4px;
				transition: background-color 0.2s, color 0.2s;
			}
			.modal-close:hover {
				background-color: var(--border-color);
				color: var(--text-color);
			}
			.modal-close:focus {
				outline: 2px solid var(--accent-color);
				outline-offset: 2px;
			}
			.modal-body {
				padding: 1.5rem;
			}
			.modal-video {
				width: 100%;
				border-radius: 8px;
				background-color: #000;
			}
			.modal-current-subtitle {
				margin-top: 1rem;
				padding: 1rem;
				background-color: var(--subtitle-bg);
				color: var(--subtitle-text);
				border-radius: 8px;
				font-size: 1.25rem;
				text-align: center;
				min-height: 3.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.modal-segments {
				margin-top: 1rem;
				/* Height to show approximately 3 segments with current centered */
				height: 180px;
				overflow-y: auto;
				border: 1px solid var(--border-color);
				border-radius: 8px;
				scroll-behavior: smooth;
			}
			.modal-segment {
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--border-color);
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.modal-segment:hover {
				background-color: var(--hover-bg);
			}
			.modal-segment:last-child {
				border-bottom: none;
			}
			.modal-segment.active {
				background-color: var(--active-segment-bg);
				border-left: 3px solid var(--accent-color);
			}
			.modal-segment-time {
				font-size: 0.75rem;
				color: var(--text-tertiary);
				font-family: monospace;
				margin-bottom: 0.25rem;
			}
			.modal-segment-text {
				font-size: 0.95rem;
			}
			.modal-actions {
				margin-top: 1.5rem;
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.modal-download-btn {
				display: inline-block;
				padding: 0.75rem 1.25rem;
				background-color: var(--accent-color);
				color: white;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.modal-download-btn:hover {
				background-color: var(--accent-hover);
			}
			.modal-download-btn-secondary {
				background-color: var(--text-secondary);
			}
			.modal-download-btn-secondary:hover {
				background-color: var(--text-color);
			}
			.modal-edit-link {
				display: inline-block;
				padding: 0.75rem 1.25rem;
				background-color: var(--btn-secondary-bg);
				color: var(--text-color);
				text-decoration: none;
				border: 1px solid var(--border-color);
				border-radius: 6px;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.modal-edit-link:hover {
				background-color: var(--btn-secondary-hover);
			}
			.modal-loading {
				text-align: center;
				padding: 2rem;
				color: var(--text-secondary);
			}
			.modal-error {
				text-align: center;
				padding: 2rem;
				color: var(--error-color);
			}
			@media (max-width: 480px) {
				.modal-overlay {
					padding: 0.5rem;
				}
				.modal-content {
					margin: 0.5rem auto;
					border-radius: 8px;
				}
				.modal-header {
					padding: 0.75rem 1rem;
				}
				.modal-title {
					font-size: 1rem;
				}
				.modal-body {
					padding: 1rem;
				}
				.modal-current-subtitle {
					font-size: 1rem;
					min-height: 3rem;
					padding: 0.75rem;
				}
				.modal-segments {
					height: 150px; /* Slightly smaller for mobile */
				}
				.modal-segment {
					padding: 0.5rem 0.75rem;
				}
				.modal-actions {
					flex-direction: column;
				}
				.modal-download-btn, .modal-edit-link {
					width: 100%;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<nav class="nav" id="nav">
			<ThemeToggle />
			<a href="/login" class="nav-link" id="loginLink">Log in</a>
			<a href="/register" class="nav-link" id="registerLink">Sign up</a>
		</nav>
		<div class="container">
			<div class="header">
				<div class="header-left">
					<a href="/" class="back-link" aria-label="Back to home">&larr;</a>
					<h1>My Videos</h1>
				</div>
				<a href="/upload" class="upload-btn">Upload Video</a>
			</div>

			<div id="loading" class="loading" role="status" aria-live="polite">Loading videos...</div>
			<div id="error" class="error" style="display: none;" role="alert" aria-live="assertive"></div>
			<div id="empty" class="empty-state" style="display: none;">
				<div class="empty-icon">📹</div>
				<p class="empty-text">No videos yet. Upload your first video to get started!</p>
				<a href="/upload" class="upload-btn">Upload Video</a>
			</div>
			<div id="videoList" class="video-list" style="display: none;"></div>
			<div id="pagination" class="pagination" style="display: none;">
				<button class="pagination-btn" id="prevPage" disabled>← Previous</button>
				<span class="pagination-info" id="pageInfo">Page 1</span>
				<button class="pagination-btn" id="nextPage" disabled>Next →</button>
			</div>
		</div>

		<!-- Video player modal -->
		<div class="modal-overlay" id="videoModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
			<div class="modal-content">
				<div class="modal-header">
					<h2 class="modal-title" id="modalTitle">Video</h2>
					<button class="modal-close" id="modalClose" aria-label="Close modal">&times;</button>
				</div>
				<div class="modal-body">
					<div class="modal-loading" id="modalLoading">Loading video...</div>
					<div class="modal-error" id="modalError" style="display: none;"></div>
					<div id="modalVideoContainer" style="display: none;">
						<video class="modal-video" id="modalVideo" controls></video>
						<div class="modal-current-subtitle" id="modalCurrentSubtitle"></div>
						<div class="modal-segments" id="modalSegments"></div>
						<div class="modal-actions">
							<a href="#" class="modal-download-btn modal-download-btn-secondary" id="modalDownloadSrt" target="_blank" rel="noopener" aria-label="Download subtitles in SRT format">SRT</a>
							<a href="#" class="modal-download-btn modal-download-btn-secondary" id="modalDownloadVtt" target="_blank" rel="noopener" aria-label="Download subtitles in VTT format">VTT</a>
							<a href="#" class="modal-download-btn modal-download-btn-secondary" id="modalDownloadJson" target="_blank" rel="noopener" aria-label="Download subtitles in JSON format">JSON</a>
							<a href="#" class="modal-edit-link" id="modalEditLink" aria-label="Edit subtitles">Edit</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
			import { csrfFetch, fetchCsrfToken, clearCsrfToken } from '../utils/csrf';
			import { getOrCreateSessionId } from '../utils/session';
			import { escapeHtml } from '../utils/html';
			import { downloadSRT, downloadVTT, downloadJSON } from '../utils/subtitles';
			import type { TranscriptionSegment } from '../types/transcription';

			const loading = document.getElementById('loading') as HTMLElement;
			const error = document.getElementById('error') as HTMLElement;
			const empty = document.getElementById('empty') as HTMLElement;
			const videoList = document.getElementById('videoList') as HTMLElement;

			interface Video {
				id: string;
				filename: string;
				size: number;
				content_type: string;
				created_at: string;
				transcription_status: string;
				user_id?: string;
				expires_at?: string;
				thumbnail_path?: string;
			}

			function formatBytes(bytes: number): string {
				if (bytes < 1024) return bytes + ' B';
				if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
				return (bytes / 1024 / 1024).toFixed(1) + ' MB';
			}

			function formatDate(dateStr: string): string {
				const date = new Date(dateStr);
				return date.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
					hour: '2-digit',
					minute: '2-digit'
				});
			}

			function formatRetention(video: Video): string {
				if (!video.expires_at) return '';

				const expiresAt = new Date(video.expires_at);
				const now = new Date();
				const msRemaining = expiresAt.getTime() - now.getTime();

				// If already expired
				if (msRemaining <= 0) {
					return '<span class="retention-badge retention-expired">Expired</span>';
				}

				const hoursRemaining = Math.ceil(msRemaining / (1000 * 60 * 60));
				const daysRemaining = Math.ceil(msRemaining / (1000 * 60 * 60 * 24));

				// Anonymous videos (48 hour retention) - show hours
				if (!video.user_id) {
					if (hoursRemaining <= 6) {
						return `<span class="retention-badge retention-warning">Expires in ${hoursRemaining}h</span>`;
					}
					return `<span class="retention-badge retention-info">Expires in ${hoursRemaining}h</span>`;
				}

				// Registered users (90 day retention) - show days
				if (daysRemaining <= 7) {
					return `<span class="retention-badge retention-warning">Expires in ${daysRemaining}d</span>`;
				}
				return `<span class="retention-badge retention-info">${daysRemaining}d remaining</span>`;
			}

			function getStatusBadge(status: string): string {
				const statusLabels: Record<string, string> = {
					complete: 'Complete',
					processing: 'Processing',
					pending: 'Pending',
					error: 'Error',
					none: 'Not Started'
				};
				const label = statusLabels[status] || status;
				return `<span class="status-badge status-${status}">${label}</span>`;
			}

			function renderVideo(video: Video): string {
				const showViewBtn = video.transcription_status === 'complete';
				const showDownloadBtn = video.transcription_status === 'complete';
				const showRetryBtn = video.transcription_status === 'error';
				const hasThumbnail = video.thumbnail_path && video.thumbnail_path !== '';

				return `
					<div class="video-card" data-video-id="${video.id}">
						${hasThumbnail
							? `<img class="video-thumbnail${showViewBtn ? ' clickable-thumbnail' : ''}" src="/api/videos/${video.id}/thumbnail" alt="Thumbnail for ${escapeHtml(video.filename)}" loading="lazy" ${showViewBtn ? `data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}" role="button" tabindex="0" aria-label="Play video: ${escapeHtml(video.filename)}" style="cursor: pointer;"` : ''} />`
							: `<div class="video-thumbnail-placeholder${showViewBtn ? ' clickable-thumbnail' : ''}" ${showViewBtn ? `data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}" role="button" tabindex="0" aria-label="Play video: ${escapeHtml(video.filename)}" style="cursor: pointer;"` : ''}>🎬</div>`
						}
						<div class="video-info">
							<div class="video-filename">${escapeHtml(video.filename)}</div>
							<div class="video-meta">
								<span>${formatBytes(video.size)}</span>
								<span>${formatDate(video.created_at)}</span>
								${getStatusBadge(video.transcription_status)}
								${formatRetention(video)}
							</div>
						</div>
						<div class="video-actions">
							${showViewBtn ? `<button class="btn btn-primary btn-view" data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}">View</button>` : ''}
							${showDownloadBtn ? `<button class="btn btn-secondary btn-download-srt" data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}" aria-label="Download subtitles in SRT format">SRT</button>` : ''}
							${showDownloadBtn ? `<button class="btn btn-secondary btn-download-vtt" data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}" aria-label="Download subtitles in VTT format">VTT</button>` : ''}
							${showDownloadBtn ? `<button class="btn btn-secondary btn-download-json" data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}" aria-label="Download subtitles in JSON format">JSON</button>` : ''}
							${video.transcription_status === 'pending' || video.transcription_status === 'none' ? `<a href="/upload?id=${video.id}" class="btn btn-primary">Transcribe</a>` : ''}
							${showRetryBtn ? `<button class="btn btn-retry" data-video-id="${video.id}">Retry</button>` : ''}
							<button class="btn btn-delete" data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}" aria-label="Delete ${escapeHtml(video.filename)}">Delete</button>
						</div>
					</div>
				`;
			}

			async function reprocessVideo(videoId: string, button: HTMLButtonElement) {
				button.disabled = true;
				button.textContent = 'Retrying...';

				try {
					// For anonymous users, include session_id
					let url = `/api/videos/${videoId}/reprocess`;
					if (!isAuthenticated) {
						const sessionId = getOrCreateSessionId();
						url = `/api/videos/${videoId}/reprocess?session_id=${encodeURIComponent(sessionId)}`;
					}

					const response = await csrfFetch(url, { method: 'POST' });
					const data = await response.json();

					if (!response.ok) {
						alert(`Failed to retry: ${data.error || 'Unknown error'}`);
						button.disabled = false;
						button.textContent = 'Retry';
						return;
					}

					// Redirect to upload page to see progress
					window.location.href = `/upload?id=${videoId}`;
				} catch (err) {
					alert(`Failed to retry: ${err instanceof Error ? err.message : 'Unknown error'}`);
					button.disabled = false;
					button.textContent = 'Retry';
				}
			}

			async function deleteVideo(videoId: string, filename: string, button: HTMLButtonElement) {
				// Confirm deletion
				if (!confirm(`Are you sure you want to delete "${filename}"? This cannot be undone.`)) {
					return;
				}

				button.disabled = true;
				button.textContent = 'Deleting...';

				try {
					// For anonymous users, include session_id
					let url = `/api/videos/${videoId}`;
					if (!isAuthenticated) {
						const sessionId = getOrCreateSessionId();
						url = `/api/videos/${videoId}?session_id=${encodeURIComponent(sessionId)}`;
					}

					const response = await csrfFetch(url, { method: 'DELETE' });
					const data = await response.json();

					if (!response.ok) {
						alert(`Failed to delete: ${data.error || 'Unknown error'}`);
						button.disabled = false;
						button.textContent = 'Delete';
						return;
					}

					// Remove the video card from the DOM
					const videoCard = button.closest('.video-card');
					if (videoCard) {
						videoCard.remove();
					}

					// Check if there are any videos left, show empty state if not
					const remainingVideos = videoList.querySelectorAll('.video-card');
					if (remainingVideos.length === 0) {
						videoList.innerHTML = `
							<div class="empty-state">
								<div class="empty-icon">📹</div>
								<p class="empty-text">No videos found</p>
								<a href="/upload" class="upload-btn">Upload Your First Video</a>
							</div>
						`;
					}
				} catch (err) {
					alert(`Failed to delete: ${err instanceof Error ? err.message : 'Unknown error'}`);
					button.disabled = false;
					button.textContent = 'Delete';
				}
			}

			function attachDeleteHandlers() {
				const deleteButtons = videoList.querySelectorAll('.btn-delete');
				deleteButtons.forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const button = e.target as HTMLButtonElement;
						const videoId = button.dataset.videoId;
						const filename = button.dataset.filename;
						if (videoId) {
							deleteVideo(videoId, filename || 'this video', button);
						}
					});
				});
			}

			function attachRetryHandlers() {
				const retryButtons = videoList.querySelectorAll('.btn-retry');
				retryButtons.forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const button = e.target as HTMLButtonElement;
						const videoId = button.dataset.videoId;
						if (videoId) {
							reprocessVideo(videoId, button);
						}
					});
				});
			}

			function attachViewHandlers() {
				const viewButtons = videoList.querySelectorAll('.btn-view');
				viewButtons.forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const button = e.target as HTMLButtonElement;
						const videoId = button.dataset.videoId;
						const filename = button.dataset.filename;
						if (videoId) {
							modalTriggerElement = button;
							openVideoModal(videoId, filename || 'Video');
						}
					});
				});
			}

			function attachThumbnailHandlers() {
				const thumbnails = videoList.querySelectorAll('.clickable-thumbnail');
				thumbnails.forEach((thumb) => {
					const el = thumb as HTMLElement;
					const handler = () => {
						const videoId = el.dataset.videoId;
						const filename = el.dataset.filename;
						if (videoId) {
							modalTriggerElement = el;
							openVideoModal(videoId, filename || 'Video');
						}
					};
					el.addEventListener('click', handler);
					el.addEventListener('keydown', (e) => {
						if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
							e.preventDefault();
							handler();
						}
					});
				});
			}

			// Cache for loaded transcription data to avoid refetching
			const transcriptionCache: Map<string, TranscriptionSegment[]> = new Map();

			// Helper to get segments from cache or fetch from server
			async function getSubtitleSegments(videoId: string): Promise<TranscriptionSegment[]> {
				// Check cache first
				if (transcriptionCache.has(videoId)) {
					return transcriptionCache.get(videoId)!;
				}

				// Fetch from server
				const response = await fetch(`/api/transcribe/${videoId}`);
				const data = await response.json();

				if (!response.ok) {
					throw new Error(data.error || 'Failed to load transcription');
				}

				if (data.status !== 'complete' || !data.result) {
					throw new Error('Transcription not available');
				}

				const segments = data.result.segments || [];
				transcriptionCache.set(videoId, segments);
				return segments;
			}

			// Attach download button handlers (for inline video card buttons)
			function attachDownloadHandlers() {
				const handleDownload = async (
					button: HTMLButtonElement,
					format: 'srt' | 'vtt' | 'json'
				) => {
					const videoId = button.dataset.videoId;
					const filename = button.dataset.filename || videoId || 'subtitles';

					if (!videoId) return;

					button.disabled = true;
					const originalText = button.textContent;
					button.textContent = '...';

					try {
						const segments = await getSubtitleSegments(videoId);
						if (segments.length === 0) {
							alert('No subtitles available');
							return;
						}

						if (format === 'srt') {
							downloadSRT(segments, filename);
						} else if (format === 'vtt') {
							downloadVTT(segments, filename);
						} else {
							downloadJSON(segments, filename);
						}
					} catch (err) {
						alert(`Error: ${err instanceof Error ? err.message : 'Failed to download'}`);
					} finally {
						button.disabled = false;
						button.textContent = originalText;
					}
				};

				// SRT buttons
				videoList.querySelectorAll('.btn-download-srt').forEach((btn) => {
					btn.addEventListener('click', () => handleDownload(btn as HTMLButtonElement, 'srt'));
				});

				// VTT buttons
				videoList.querySelectorAll('.btn-download-vtt').forEach((btn) => {
					btn.addEventListener('click', () => handleDownload(btn as HTMLButtonElement, 'vtt'));
				});

				// JSON buttons
				videoList.querySelectorAll('.btn-download-json').forEach((btn) => {
					btn.addEventListener('click', () => handleDownload(btn as HTMLButtonElement, 'json'));
				});
			}

			// Modal elements
			const videoModal = document.getElementById('videoModal') as HTMLElement;
			const modalClose = document.getElementById('modalClose') as HTMLButtonElement;
			const modalTitle = document.getElementById('modalTitle') as HTMLElement;
			const modalLoading = document.getElementById('modalLoading') as HTMLElement;
			const modalError = document.getElementById('modalError') as HTMLElement;
			const modalVideoContainer = document.getElementById('modalVideoContainer') as HTMLElement;
			const modalVideo = document.getElementById('modalVideo') as HTMLVideoElement;
			const modalCurrentSubtitle = document.getElementById('modalCurrentSubtitle') as HTMLElement;
			const modalSegments = document.getElementById('modalSegments') as HTMLElement;
			const modalDownloadSrt = document.getElementById('modalDownloadSrt') as HTMLAnchorElement;
			const modalDownloadVtt = document.getElementById('modalDownloadVtt') as HTMLAnchorElement;
			const modalDownloadJson = document.getElementById('modalDownloadJson') as HTMLAnchorElement;
			const modalEditLink = document.getElementById('modalEditLink') as HTMLAnchorElement;

			let currentModalVideoId: string | null = null;
			let modalSubtitleSegments: TranscriptionSegment[] = [];
			let modalSubtitleSyncActive = false;
			let modalTriggerElement: HTMLElement | null = null;
			let modalKeydownController: AbortController | null = null;

			// Event delegation for modal segments - add single listeners to the container
			// This prevents memory leaks from repeatedly adding/removing per-element handlers
			function activateSegment(segmentEl: HTMLElement) {
				const start = parseFloat(segmentEl.getAttribute('data-start') || '0');
				modalVideo.currentTime = start;
				modalVideo.play();
			}

			modalSegments.addEventListener('click', (e) => {
				const target = e.target as HTMLElement;
				// Find the closest .modal-segment ancestor (handles clicks on child elements too)
				const segmentEl = target.closest('.modal-segment') as HTMLElement | null;
				if (segmentEl) {
					activateSegment(segmentEl);
				}
			});

			// Keyboard support: Enter and Space activate segments
			modalSegments.addEventListener('keydown', (e) => {
				if (e.key !== 'Enter' && e.key !== ' ') {
					return;
				}
				const target = e.target as HTMLElement;
				const segmentEl = target.closest('.modal-segment') as HTMLElement | null;
				if (segmentEl) {
					e.preventDefault(); // Prevent Space from scrolling
					activateSegment(segmentEl);
				}
			});

			function formatTime(seconds: number): string {
				const hrs = Math.floor(seconds / 3600);
				const mins = Math.floor((seconds % 3600) / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 1000);

				if (hrs > 0) {
					return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
				}
				return `${mins}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
			}

			function setupModalKeyboardHandlers() {
				// Clean up any existing listeners
				if (modalKeydownController) {
					modalKeydownController.abort();
				}
				modalKeydownController = new AbortController();

				// Add keydown listener with AbortController for cleanup
				document.addEventListener('keydown', handleModalKeydown, { signal: modalKeydownController.signal });
			}

			function handleModalKeydown(e: KeyboardEvent) {
				if (e.key === 'Escape') {
					closeVideoModal();
					return;
				}

				// Trap focus inside modal when Tab is pressed
				if (e.key === 'Tab') {
					const focusableElements = videoModal.querySelectorAll<HTMLElement>(
						'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
					);
					const focusableArray = Array.from(focusableElements).filter(
						el => el.offsetParent !== null // Only visible elements
					);

					if (focusableArray.length === 0) {
						e.preventDefault();
						return;
					}

					const firstFocusable = focusableArray[0];
					const lastFocusable = focusableArray[focusableArray.length - 1];
					const activeElement = document.activeElement as HTMLElement;

					if (e.shiftKey) {
						// Shift+Tab: if at first element, wrap to last
						if (activeElement === firstFocusable || !focusableArray.includes(activeElement)) {
							e.preventDefault();
							lastFocusable.focus();
						}
					} else {
						// Tab: if at last element, wrap to first
						if (activeElement === lastFocusable || !focusableArray.includes(activeElement)) {
							e.preventDefault();
							firstFocusable.focus();
						}
					}
				}
			}

			async function openVideoModal(videoId: string, filename: string) {
				currentModalVideoId = videoId;
				modalSubtitleSegments = [];

				// Reset modal state
				modalTitle.textContent = filename;
				modalLoading.style.display = 'block';
				modalError.style.display = 'none';
				modalVideoContainer.style.display = 'none';
				modalCurrentSubtitle.textContent = '';
				modalSegments.innerHTML = '';

				// Show modal
				videoModal.classList.add('visible');
				document.body.style.overflow = 'hidden';

				// Set up keyboard handlers (Escape to close, Tab trapping)
				setupModalKeyboardHandlers();

				// Move focus to close button for keyboard navigation
				modalClose.focus();

				// Download links will be handled by click handlers using loaded segment data
				modalEditLink.href = `/upload?id=${videoId}`;

				// Store videoId for downloads
				currentModalVideoId = videoId;

				try {
					// Load video
					modalVideo.src = `/api/videos/${videoId}/video`;

					// Load transcription
					const response = await fetch(`/api/transcribe/${videoId}`);
					const data = await response.json();

					if (!response.ok) {
						throw new Error(data.error || 'Failed to load transcription');
					}

					if (data.status !== 'complete' || !data.result) {
						throw new Error('Transcription not available');
					}

					modalSubtitleSegments = data.result.segments || [];

					// Render segments
					renderModalSegments();

					// Set up subtitle sync
					setupModalSubtitleSync();

					// Show video container
					modalLoading.style.display = 'none';
					modalVideoContainer.style.display = 'block';

				} catch (err) {
					modalLoading.style.display = 'none';
					modalError.textContent = `Error: ${err instanceof Error ? err.message : 'Unknown error'}`;
					modalError.style.display = 'block';
				}
			}

			function renderModalSegments() {
				// Render segments - click/keyboard handling is done via event delegation on modalSegments
				// (set up once on page load, not per-render, to prevent memory leaks)
				// Segments have tabindex="0" and role="button" for keyboard accessibility
				modalSegments.innerHTML = modalSubtitleSegments.map((seg, index) => `
					<div class="modal-segment" data-index="${index}" data-start="${seg.start}" data-end="${seg.end}"
						tabindex="0" role="button" aria-label="Seek to ${formatTime(seg.start)}: ${escapeHtml(seg.text.substring(0, 50))}${seg.text.length > 50 ? '...' : ''}">
						<div class="modal-segment-time">${formatTime(seg.start)} - ${formatTime(seg.end)}</div>
						<div class="modal-segment-text">${escapeHtml(seg.text)}</div>
					</div>
				`).join('');
			}

			function setupModalSubtitleSync() {
				if (modalSubtitleSyncActive) {
					modalVideo.removeEventListener('timeupdate', updateModalSubtitle);
				}
				modalVideo.addEventListener('timeupdate', updateModalSubtitle);
				modalSubtitleSyncActive = true;
			}

			function updateModalSubtitle() {
				const currentTime = modalVideo.currentTime;

				// Find the current segment
				let currentSeg: TranscriptionSegment | null = null;
				let currentIndex = -1;

				for (let i = 0; i < modalSubtitleSegments.length; i++) {
					const seg = modalSubtitleSegments[i];
					if (currentTime >= seg.start && currentTime <= seg.end) {
						currentSeg = seg;
						currentIndex = i;
						break;
					}
				}

				// Update the current subtitle display
				if (currentSeg) {
					modalCurrentSubtitle.textContent = currentSeg.text.trim();
				} else {
					modalCurrentSubtitle.textContent = '';
				}

				// Update active segment highlighting
				modalSegments.querySelectorAll('.modal-segment').forEach((el, idx) => {
					if (idx === currentIndex) {
						el.classList.add('active');
						// Center the active segment in the container (not at bottom)
						const container = modalSegments;
						const segmentEl = el as HTMLElement;

						// Calculate scroll position to center the segment
						const containerHeight = container.clientHeight;
						const segmentTop = segmentEl.offsetTop;
						const segmentHeight = segmentEl.offsetHeight;

						// Target: position segment in the center of the container
						const targetScrollTop = segmentTop - (containerHeight / 2) + (segmentHeight / 2);
						container.scrollTop = Math.max(0, targetScrollTop);
					} else {
						el.classList.remove('active');
					}
				});
			}

			function closeVideoModal() {
				videoModal.classList.remove('visible');
				document.body.style.overflow = '';

				// Stop video playback
				modalVideo.pause();
				modalVideo.src = '';

				// Clean up subtitle sync
				if (modalSubtitleSyncActive) {
					modalVideo.removeEventListener('timeupdate', updateModalSubtitle);
					modalSubtitleSyncActive = false;
				}

				// Clean up keyboard listeners
				if (modalKeydownController) {
					modalKeydownController.abort();
					modalKeydownController = null;
				}

				currentModalVideoId = null;
				modalSubtitleSegments = [];

				// Restore focus to the trigger element
				if (modalTriggerElement) {
					modalTriggerElement.focus();
					modalTriggerElement = null;
				}
			}

			// Modal download handlers - generate files client-side from loaded segments
			// No server request needed since segments are already in memory
			modalDownloadSrt.addEventListener('click', (e) => {
				e.preventDefault();
				if (modalSubtitleSegments.length === 0) {
					alert('No subtitles available to download');
					return;
				}
				const filename = currentModalVideoId || 'subtitles';
				downloadSRT(modalSubtitleSegments, filename);
			});

			modalDownloadVtt.addEventListener('click', (e) => {
				e.preventDefault();
				if (modalSubtitleSegments.length === 0) {
					alert('No subtitles available to download');
					return;
				}
				const filename = currentModalVideoId || 'subtitles';
				downloadVTT(modalSubtitleSegments, filename);
			});

			modalDownloadJson.addEventListener('click', (e) => {
				e.preventDefault();
				if (modalSubtitleSegments.length === 0) {
					alert('No subtitles available to download');
					return;
				}
				const filename = currentModalVideoId || 'subtitles';
				downloadJSON(modalSubtitleSegments, filename);
			});

			// Modal close handlers
			modalClose.addEventListener('click', closeVideoModal);

			// Close on clicking overlay background
			videoModal.addEventListener('click', (e) => {
				if (e.target === videoModal) {
					closeVideoModal();
				}
			});

			// Note: Escape key and Tab trapping handlers are set up dynamically via
			// setupModalKeyboardHandlers() when the modal opens, and cleaned up when it closes.
			// This prevents the listener from persisting when the modal isn't visible.

			// Track if user is authenticated (set by checkAuth)
			let isAuthenticated = false;

			// Pagination state
			const VIDEOS_PER_PAGE = 20;
			let currentPage = 0;
			let totalVideos = 0;
			let hasMore = false;

			// Pagination elements
			const pagination = document.getElementById('pagination') as HTMLElement;
			const prevPageBtn = document.getElementById('prevPage') as HTMLButtonElement;
			const nextPageBtn = document.getElementById('nextPage') as HTMLButtonElement;
			const pageInfo = document.getElementById('pageInfo') as HTMLElement;

			function updatePaginationUI() {
				if (totalVideos <= VIDEOS_PER_PAGE) {
					pagination.style.display = 'none';
					return;
				}

				pagination.style.display = 'flex';
				prevPageBtn.disabled = currentPage === 0;
				nextPageBtn.disabled = !hasMore;

				const startItem = currentPage * VIDEOS_PER_PAGE + 1;
				const endItem = Math.min(startItem + VIDEOS_PER_PAGE - 1, totalVideos);
				pageInfo.textContent = `${startItem}-${endItem} of ${totalVideos}`;
			}

			async function loadVideos(page: number = 0) {
				try {
					currentPage = page;
					const offset = page * VIDEOS_PER_PAGE;

					// For anonymous users, include session_id in request
					// Authenticated users are filtered by user_id on backend
					let url = `/api/videos?limit=${VIDEOS_PER_PAGE}&offset=${offset}`;
					if (!isAuthenticated) {
						const sessionId = getOrCreateSessionId();
						url += `&session_id=${encodeURIComponent(sessionId)}`;
					}

					const response = await fetch(url);
					if (!response.ok) {
						const data = await response.json().catch(() => ({}));
						throw new Error(data.error || `HTTP ${response.status}`);
					}
					const data = await response.json();

					loading.style.display = 'none';

					// Store pagination metadata
					totalVideos = data.total_count || 0;
					hasMore = data.has_more || false;

					if (!data.videos || data.videos.length === 0) {
						if (page === 0) {
							empty.style.display = 'block';
							pagination.style.display = 'none';
						}
						return;
					}

					videoList.innerHTML = data.videos.map(renderVideo).join('');
					videoList.style.display = 'flex';
					attachRetryHandlers();
					attachViewHandlers();
					attachThumbnailHandlers();
					attachDownloadHandlers();
					attachDeleteHandlers();
					updatePaginationUI();

				} catch (err) {
					loading.style.display = 'none';
					error.textContent = `Failed to load videos: ${err instanceof Error ? err.message : err}`;
					error.style.display = 'block';
				}
			}

			// Pagination event handlers
			prevPageBtn.addEventListener('click', () => {
				if (currentPage > 0) {
					loading.style.display = 'block';
					videoList.style.display = 'none';
					loadVideos(currentPage - 1);
				}
			});

			nextPageBtn.addEventListener('click', () => {
				if (hasMore) {
					loading.style.display = 'block';
					videoList.style.display = 'none';
					loadVideos(currentPage + 1);
				}
			});

			// Don't load videos immediately - wait for auth check

			// Auth handling
			const nav = document.getElementById('nav') as HTMLElement;
			const loginLink = document.getElementById('loginLink') as HTMLElement;
			const registerLink = document.getElementById('registerLink') as HTMLElement;

			async function checkAuth() {
				try {
					const response = await fetch('/api/auth/me');
					if (response.ok) {
						const data = await response.json();
						if (data.user) {
							isAuthenticated = true;
							loginLink.style.display = 'none';
							registerLink.style.display = 'none';

							// Fetch CSRF token for authenticated requests
							await fetchCsrfToken();

							const userSpan = document.createElement('span');
							userSpan.className = 'nav-user';
							userSpan.textContent = data.user.email;
							nav.appendChild(userSpan);

							const securityLink = document.createElement('a');
							securityLink.href = '/security';
							securityLink.className = 'nav-link';
							securityLink.textContent = 'Security';
							nav.appendChild(securityLink);

							const logoutBtn = document.createElement('button');
							logoutBtn.className = 'nav-logout';
							logoutBtn.textContent = 'Log out';
							logoutBtn.addEventListener('click', logout);
							nav.appendChild(logoutBtn);
						}
					}
				} catch (err) {
					// Not logged in
				}

				// Now load videos with correct filtering
				loadVideos();
			}

			async function logout() {
				try {
					await csrfFetch('/api/auth/logout', { method: 'POST' });
					clearCsrfToken();
					window.location.reload();
				} catch (err) {
					console.error('Logout failed:', err);
				}
			}

			// Start auth check (which will then load videos)
			checkAuth();
		</script>
		<CookieConsent />
	</body>
</html>
