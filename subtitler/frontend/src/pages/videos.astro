---
import DevConsoleForwarder from '../components/DevConsoleForwarder.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/theme.css';
---

<html lang="en">
	<head>
		<ThemeInit />
		<DevConsoleForwarder />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>My Videos - Subtitler</title>
		<style>
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			.header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 2rem;
			}
			.header-left {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.back-link {
				text-decoration: none;
				color: var(--text-color);
				font-size: 1.5rem;
			}
			.back-link:focus {
				outline: 2px solid var(--accent-color);
				outline-offset: 2px;
			}
			h1 {
				font-size: 2rem;
				font-weight: 600;
			}
			.upload-btn {
				display: inline-block;
				background-color: var(--accent-color);
				color: white;
				padding: 0.75rem 1.5rem;
				border-radius: 6px;
				text-decoration: none;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.upload-btn:hover {
				background-color: var(--accent-hover);
			}
			.loading {
				text-align: center;
				padding: 3rem;
				color: var(--text-secondary);
			}
			.error {
				text-align: center;
				padding: 2rem;
				background-color: var(--error-bg);
				border: 1px solid var(--error-border);
				color: var(--error-color);
				border-radius: 8px;
			}
			.empty-state {
				text-align: center;
				padding: 4rem 2rem;
				background-color: var(--secondary-bg);
				border-radius: 12px;
				border: 2px dashed var(--border-color);
			}
			.empty-icon {
				font-size: 3rem;
				margin-bottom: 1rem;
			}
			.empty-text {
				font-size: 1.25rem;
				color: var(--text-secondary);
				margin-bottom: 1.5rem;
			}
			.video-list {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.video-card {
				background-color: var(--secondary-bg);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 1.25rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				transition: box-shadow 0.2s;
			}
			.video-card:hover {
				box-shadow: 0 2px 8px var(--card-shadow);
			}
			.video-icon {
				font-size: 2rem;
				flex-shrink: 0;
			}
			.video-info {
				flex: 1;
				min-width: 0;
			}
			.video-filename {
				font-weight: 500;
				font-size: 1rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				margin-bottom: 0.25rem;
			}
			.video-meta {
				font-size: 0.875rem;
				color: var(--text-secondary);
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
			}
			.video-actions {
				display: flex;
				gap: 0.5rem;
				flex-shrink: 0;
			}
			.btn {
				display: inline-block;
				padding: 0.5rem 1rem;
				border-radius: 4px;
				text-decoration: none;
				font-size: 0.875rem;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.btn-primary {
				background-color: var(--accent-color);
				color: white;
			}
			.btn-primary:hover {
				background-color: var(--accent-hover);
			}
			.btn-secondary {
				background-color: var(--bg-color);
				color: var(--text-color);
				border: 1px solid var(--border-color);
			}
			.btn-secondary:hover {
				background-color: var(--btn-secondary-hover);
			}
			.btn-retry {
				background-color: var(--btn-danger-color);
				color: white;
				border: none;
				cursor: pointer;
			}
			.btn-retry:hover {
				background-color: var(--btn-danger-hover);
			}
			.btn-retry:disabled {
				background-color: var(--badge-pending-bg);
				color: var(--text-secondary);
				cursor: not-allowed;
			}
			.status-badge {
				display: inline-block;
				padding: 0.125rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: 500;
				text-transform: uppercase;
			}
			.status-complete {
				background-color: var(--badge-complete-bg);
				color: var(--badge-complete-text);
			}
			.status-processing {
				background-color: var(--badge-processing-bg);
				color: var(--badge-processing-text);
			}
			.status-pending {
				background-color: var(--badge-pending-bg);
				color: var(--badge-pending-text);
			}
			.status-error {
				background-color: var(--badge-error-bg);
				color: var(--badge-error-text);
			}
			.status-none {
				background-color: var(--badge-none-bg);
				color: var(--badge-none-text);
			}
			.retention-badge {
				display: inline-block;
				padding: 0.125rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: 500;
			}
			.retention-info {
				background-color: var(--retention-info-bg);
				color: var(--retention-info-text);
			}
			.retention-warning {
				background-color: var(--retention-warning-bg);
				color: var(--retention-warning-text);
			}
			.retention-expired {
				background-color: var(--retention-expired-bg);
				color: var(--retention-expired-text);
			}
			.nav {
				display: flex;
				justify-content: flex-end;
				padding: 1rem 2rem;
				gap: 1rem;
			}
			.nav-link {
				color: var(--text-color);
				text-decoration: none;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				transition: background-color 0.2s;
			}
			.nav-link:hover {
				background-color: var(--border-color);
			}
			.nav-user {
				color: var(--text-secondary);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
			}
			.nav-logout {
				background: none;
				border: none;
				color: var(--text-color);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.nav-logout:hover {
				background-color: var(--border-color);
			}
			/* Mobile responsive styles */
			@media (max-width: 480px) {
				.nav {
					padding: 0.75rem 1rem;
					gap: 0.5rem;
					flex-wrap: wrap;
				}
				.nav-link, .nav-logout {
					padding: 0.5rem 0.75rem;
					font-size: 0.85rem;
					min-height: 44px;
					display: flex;
					align-items: center;
				}
				.container {
					padding: 1rem;
				}
				.header {
					flex-direction: column;
					align-items: flex-start;
					gap: 1rem;
				}
				.header-left {
					width: 100%;
				}
				h1 {
					font-size: 1.5rem;
				}
				.upload-btn {
					width: 100%;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
				.video-card {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.75rem;
				}
				.video-info {
					width: 100%;
				}
				.video-filename {
					white-space: normal;
					word-break: break-word;
				}
				.video-meta {
					font-size: 0.8rem;
				}
				.video-actions {
					width: 100%;
					flex-wrap: wrap;
				}
				.btn {
					flex: 1;
					min-width: 70px;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
				.empty-state {
					padding: 2rem 1rem;
				}
				.empty-text {
					font-size: 1rem;
				}
			}
			@media (max-width: 375px) {
				h1 {
					font-size: 1.25rem;
				}
				.container {
					padding: 0.75rem;
				}
				.video-actions {
					flex-direction: column;
				}
				.btn {
					width: 100%;
				}
			}
			/* Video player modal styles */
			.modal-overlay {
				display: none;
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-color: rgba(0, 0, 0, 0.8);
				z-index: 1000;
				overflow-y: auto;
				padding: 1rem;
			}
			.modal-overlay.visible {
				display: flex;
				align-items: flex-start;
				justify-content: center;
			}
			.modal-content {
				background-color: var(--bg-color);
				border-radius: 12px;
				max-width: 900px;
				width: 100%;
				margin: 2rem auto;
				position: relative;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			}
			.modal-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1rem 1.5rem;
				border-bottom: 1px solid var(--border-color);
			}
			.modal-title {
				font-size: 1.25rem;
				font-weight: 600;
				margin: 0;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				max-width: calc(100% - 40px);
			}
			.modal-close {
				background: none;
				border: none;
				font-size: 1.5rem;
				color: var(--text-secondary);
				cursor: pointer;
				padding: 0.25rem 0.5rem;
				line-height: 1;
				border-radius: 4px;
				transition: background-color 0.2s, color 0.2s;
			}
			.modal-close:hover {
				background-color: var(--border-color);
				color: var(--text-color);
			}
			.modal-close:focus {
				outline: 2px solid var(--accent-color);
				outline-offset: 2px;
			}
			.modal-body {
				padding: 1.5rem;
			}
			.modal-video {
				width: 100%;
				border-radius: 8px;
				background-color: #000;
			}
			.modal-current-subtitle {
				margin-top: 1rem;
				padding: 1rem;
				background-color: var(--subtitle-bg);
				color: var(--subtitle-text);
				border-radius: 8px;
				font-size: 1.25rem;
				text-align: center;
				min-height: 3.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.modal-segments {
				margin-top: 1rem;
				max-height: 250px;
				overflow-y: auto;
				border: 1px solid var(--border-color);
				border-radius: 8px;
			}
			.modal-segment {
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--border-color);
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.modal-segment:hover {
				background-color: var(--hover-bg);
			}
			.modal-segment:last-child {
				border-bottom: none;
			}
			.modal-segment.active {
				background-color: var(--active-segment-bg);
				border-left: 3px solid var(--accent-color);
			}
			.modal-segment-time {
				font-size: 0.75rem;
				color: var(--text-tertiary);
				font-family: monospace;
				margin-bottom: 0.25rem;
			}
			.modal-segment-text {
				font-size: 0.95rem;
			}
			.modal-actions {
				margin-top: 1.5rem;
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
			}
			.modal-download-btn {
				display: inline-block;
				padding: 0.75rem 1.25rem;
				background-color: var(--accent-color);
				color: white;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.modal-download-btn:hover {
				background-color: var(--accent-hover);
			}
			.modal-download-btn-secondary {
				background-color: var(--text-secondary);
			}
			.modal-download-btn-secondary:hover {
				background-color: var(--text-color);
			}
			.modal-edit-link {
				display: inline-block;
				padding: 0.75rem 1.25rem;
				background-color: var(--btn-secondary-bg);
				color: var(--text-color);
				text-decoration: none;
				border: 1px solid var(--border-color);
				border-radius: 6px;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.modal-edit-link:hover {
				background-color: var(--btn-secondary-hover);
			}
			.modal-loading {
				text-align: center;
				padding: 2rem;
				color: var(--text-secondary);
			}
			.modal-error {
				text-align: center;
				padding: 2rem;
				color: var(--error-color);
			}
			@media (max-width: 480px) {
				.modal-overlay {
					padding: 0.5rem;
				}
				.modal-content {
					margin: 0.5rem auto;
					border-radius: 8px;
				}
				.modal-header {
					padding: 0.75rem 1rem;
				}
				.modal-title {
					font-size: 1rem;
				}
				.modal-body {
					padding: 1rem;
				}
				.modal-current-subtitle {
					font-size: 1rem;
					min-height: 3rem;
					padding: 0.75rem;
				}
				.modal-segments {
					max-height: 200px;
				}
				.modal-segment {
					padding: 0.5rem 0.75rem;
				}
				.modal-actions {
					flex-direction: column;
				}
				.modal-download-btn, .modal-edit-link {
					width: 100%;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<nav class="nav" id="nav">
			<ThemeToggle />
			<a href="/login" class="nav-link" id="loginLink">Log in</a>
			<a href="/register" class="nav-link" id="registerLink">Sign up</a>
		</nav>
		<div class="container">
			<div class="header">
				<div class="header-left">
					<a href="/" class="back-link" aria-label="Back to home">&larr;</a>
					<h1>My Videos</h1>
				</div>
				<a href="/upload" class="upload-btn">Upload Video</a>
			</div>

			<div id="loading" class="loading" role="status" aria-live="polite">Loading videos...</div>
			<div id="error" class="error" style="display: none;" role="alert" aria-live="assertive"></div>
			<div id="empty" class="empty-state" style="display: none;">
				<div class="empty-icon">📹</div>
				<p class="empty-text">No videos yet. Upload your first video to get started!</p>
				<a href="/upload" class="upload-btn">Upload Video</a>
			</div>
			<div id="videoList" class="video-list" style="display: none;"></div>
		</div>

		<!-- Video player modal -->
		<div class="modal-overlay" id="videoModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
			<div class="modal-content">
				<div class="modal-header">
					<h2 class="modal-title" id="modalTitle">Video</h2>
					<button class="modal-close" id="modalClose" aria-label="Close modal">&times;</button>
				</div>
				<div class="modal-body">
					<div class="modal-loading" id="modalLoading">Loading video...</div>
					<div class="modal-error" id="modalError" style="display: none;"></div>
					<div id="modalVideoContainer" style="display: none;">
						<video class="modal-video" id="modalVideo" controls></video>
						<div class="modal-current-subtitle" id="modalCurrentSubtitle"></div>
						<div class="modal-segments" id="modalSegments"></div>
						<div class="modal-actions">
							<a href="#" class="modal-download-btn" id="modalDownloadSrt">Download SRT</a>
							<a href="#" class="modal-download-btn modal-download-btn-secondary" id="modalDownloadVtt">VTT</a>
							<a href="#" class="modal-download-btn modal-download-btn-secondary" id="modalDownloadJson">JSON</a>
							<a href="#" class="modal-edit-link" id="modalEditLink">Edit Subtitles</a>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script>
			import { csrfFetch, fetchCsrfToken, clearCsrfToken } from '../utils/csrf';
			import { getOrCreateSessionId } from '../utils/session';

			const loading = document.getElementById('loading') as HTMLElement;
			const error = document.getElementById('error') as HTMLElement;
			const empty = document.getElementById('empty') as HTMLElement;
			const videoList = document.getElementById('videoList') as HTMLElement;

			interface Video {
				id: string;
				filename: string;
				size: number;
				content_type: string;
				created_at: string;
				transcription_status: string;
				user_id?: string;
				expires_at?: string;
			}

			function formatBytes(bytes: number): string {
				if (bytes < 1024) return bytes + ' B';
				if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
				return (bytes / 1024 / 1024).toFixed(1) + ' MB';
			}

			function formatDate(dateStr: string): string {
				const date = new Date(dateStr);
				return date.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
					hour: '2-digit',
					minute: '2-digit'
				});
			}

			function formatRetention(video: Video): string {
				if (!video.expires_at) return '';

				const expiresAt = new Date(video.expires_at);
				const now = new Date();
				const msRemaining = expiresAt.getTime() - now.getTime();

				// If already expired
				if (msRemaining <= 0) {
					return '<span class="retention-badge retention-expired">Expired</span>';
				}

				const hoursRemaining = Math.ceil(msRemaining / (1000 * 60 * 60));
				const daysRemaining = Math.ceil(msRemaining / (1000 * 60 * 60 * 24));

				// Anonymous videos (48 hour retention) - show hours
				if (!video.user_id) {
					if (hoursRemaining <= 6) {
						return `<span class="retention-badge retention-warning">Expires in ${hoursRemaining}h</span>`;
					}
					return `<span class="retention-badge retention-info">Expires in ${hoursRemaining}h</span>`;
				}

				// Registered users (90 day retention) - show days
				if (daysRemaining <= 7) {
					return `<span class="retention-badge retention-warning">Expires in ${daysRemaining}d</span>`;
				}
				return `<span class="retention-badge retention-info">${daysRemaining}d remaining</span>`;
			}

			function getStatusBadge(status: string): string {
				const statusLabels: Record<string, string> = {
					complete: 'Complete',
					processing: 'Processing',
					pending: 'Pending',
					error: 'Error',
					none: 'Not Started'
				};
				const label = statusLabels[status] || status;
				return `<span class="status-badge status-${status}">${label}</span>`;
			}

			function renderVideo(video: Video): string {
				const showViewBtn = video.transcription_status === 'complete';
				const showDownloadBtn = video.transcription_status === 'complete';
				const showRetryBtn = video.transcription_status === 'error';

				return `
					<div class="video-card" data-video-id="${video.id}">
						<div class="video-icon">🎬</div>
						<div class="video-info">
							<div class="video-filename">${escapeHtml(video.filename)}</div>
							<div class="video-meta">
								<span>${formatBytes(video.size)}</span>
								<span>${formatDate(video.created_at)}</span>
								${getStatusBadge(video.transcription_status)}
								${formatRetention(video)}
							</div>
						</div>
						<div class="video-actions">
							${showViewBtn ? `<button class="btn btn-primary btn-view" data-video-id="${video.id}" data-filename="${escapeHtml(video.filename)}">View</button>` : ''}
							${showDownloadBtn ? `<a href="/api/videos/${video.id}/subtitles.srt" class="btn btn-secondary">SRT</a>` : ''}
							${showDownloadBtn ? `<a href="/api/videos/${video.id}/subtitles.vtt" class="btn btn-secondary">VTT</a>` : ''}
							${showDownloadBtn ? `<a href="/api/videos/${video.id}/subtitles.json" class="btn btn-secondary">JSON</a>` : ''}
							${video.transcription_status === 'pending' || video.transcription_status === 'none' ? `<a href="/upload?id=${video.id}" class="btn btn-primary">Transcribe</a>` : ''}
							${showRetryBtn ? `<button class="btn btn-retry" data-video-id="${video.id}">Retry</button>` : ''}
						</div>
					</div>
				`;
			}

			function escapeHtml(text: string): string {
				const div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			async function reprocessVideo(videoId: string, button: HTMLButtonElement) {
				button.disabled = true;
				button.textContent = 'Retrying...';

				try {
					// For anonymous users, include session_id
					let url = `/api/videos/${videoId}/reprocess`;
					if (!isAuthenticated) {
						const sessionId = getOrCreateSessionId();
						url = `/api/videos/${videoId}/reprocess?session_id=${encodeURIComponent(sessionId)}`;
					}

					const response = await csrfFetch(url, { method: 'POST' });
					const data = await response.json();

					if (!response.ok) {
						alert(`Failed to retry: ${data.error || 'Unknown error'}`);
						button.disabled = false;
						button.textContent = 'Retry';
						return;
					}

					// Redirect to upload page to see progress
					window.location.href = `/upload?id=${videoId}`;
				} catch (err) {
					alert(`Failed to retry: ${err instanceof Error ? err.message : 'Unknown error'}`);
					button.disabled = false;
					button.textContent = 'Retry';
				}
			}

			function attachRetryHandlers() {
				const retryButtons = videoList.querySelectorAll('.btn-retry');
				retryButtons.forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const button = e.target as HTMLButtonElement;
						const videoId = button.dataset.videoId;
						if (videoId) {
							reprocessVideo(videoId, button);
						}
					});
				});
			}

			function attachViewHandlers() {
				const viewButtons = videoList.querySelectorAll('.btn-view');
				viewButtons.forEach((btn) => {
					btn.addEventListener('click', (e) => {
						const button = e.target as HTMLButtonElement;
						const videoId = button.dataset.videoId;
						const filename = button.dataset.filename;
						if (videoId) {
							openVideoModal(videoId, filename || 'Video');
						}
					});
				});
			}

			// Modal elements
			const videoModal = document.getElementById('videoModal') as HTMLElement;
			const modalClose = document.getElementById('modalClose') as HTMLButtonElement;
			const modalTitle = document.getElementById('modalTitle') as HTMLElement;
			const modalLoading = document.getElementById('modalLoading') as HTMLElement;
			const modalError = document.getElementById('modalError') as HTMLElement;
			const modalVideoContainer = document.getElementById('modalVideoContainer') as HTMLElement;
			const modalVideo = document.getElementById('modalVideo') as HTMLVideoElement;
			const modalCurrentSubtitle = document.getElementById('modalCurrentSubtitle') as HTMLElement;
			const modalSegments = document.getElementById('modalSegments') as HTMLElement;
			const modalDownloadSrt = document.getElementById('modalDownloadSrt') as HTMLAnchorElement;
			const modalDownloadVtt = document.getElementById('modalDownloadVtt') as HTMLAnchorElement;
			const modalDownloadJson = document.getElementById('modalDownloadJson') as HTMLAnchorElement;
			const modalEditLink = document.getElementById('modalEditLink') as HTMLAnchorElement;

			interface TranscriptionSegment {
				id: number;
				start: number;
				end: number;
				text: string;
			}

			let currentModalVideoId: string | null = null;
			let modalSubtitleSegments: TranscriptionSegment[] = [];
			let modalSubtitleSyncActive = false;

			function formatTime(seconds: number): string {
				const hrs = Math.floor(seconds / 3600);
				const mins = Math.floor((seconds % 3600) / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 1000);

				if (hrs > 0) {
					return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
				}
				return `${mins}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
			}

			async function openVideoModal(videoId: string, filename: string) {
				currentModalVideoId = videoId;
				modalSubtitleSegments = [];

				// Reset modal state
				modalTitle.textContent = filename;
				modalLoading.style.display = 'block';
				modalError.style.display = 'none';
				modalVideoContainer.style.display = 'none';
				modalCurrentSubtitle.textContent = '';
				modalSegments.innerHTML = '';

				// Show modal
				videoModal.classList.add('visible');
				document.body.style.overflow = 'hidden';

				// Set download links
				modalDownloadSrt.href = `/api/videos/${videoId}/subtitles.srt`;
				modalDownloadVtt.href = `/api/videos/${videoId}/subtitles.vtt`;
				modalDownloadJson.href = `/api/videos/${videoId}/subtitles.json`;
				modalEditLink.href = `/upload?id=${videoId}`;

				try {
					// Load video
					modalVideo.src = `/api/videos/${videoId}/video`;

					// Load transcription
					const response = await fetch(`/api/transcribe/${videoId}`);
					const data = await response.json();

					if (!response.ok) {
						throw new Error(data.error || 'Failed to load transcription');
					}

					if (data.status !== 'complete' || !data.result) {
						throw new Error('Transcription not available');
					}

					modalSubtitleSegments = data.result.segments || [];

					// Render segments
					renderModalSegments();

					// Set up subtitle sync
					setupModalSubtitleSync();

					// Show video container
					modalLoading.style.display = 'none';
					modalVideoContainer.style.display = 'block';

				} catch (err) {
					modalLoading.style.display = 'none';
					modalError.textContent = `Error: ${err instanceof Error ? err.message : 'Unknown error'}`;
					modalError.style.display = 'block';
				}
			}

			function renderModalSegments() {
				modalSegments.innerHTML = modalSubtitleSegments.map((seg, index) => `
					<div class="modal-segment" data-index="${index}" data-start="${seg.start}" data-end="${seg.end}">
						<div class="modal-segment-time">${formatTime(seg.start)} - ${formatTime(seg.end)}</div>
						<div class="modal-segment-text">${escapeHtml(seg.text)}</div>
					</div>
				`).join('');

				// Add click handlers to seek video
				modalSegments.querySelectorAll('.modal-segment').forEach(el => {
					el.addEventListener('click', () => {
						const start = parseFloat(el.getAttribute('data-start') || '0');
						modalVideo.currentTime = start;
						modalVideo.play();
					});
				});
			}

			function setupModalSubtitleSync() {
				if (modalSubtitleSyncActive) {
					modalVideo.removeEventListener('timeupdate', updateModalSubtitle);
				}
				modalVideo.addEventListener('timeupdate', updateModalSubtitle);
				modalSubtitleSyncActive = true;
			}

			function updateModalSubtitle() {
				const currentTime = modalVideo.currentTime;

				// Find the current segment
				let currentSeg: TranscriptionSegment | null = null;
				let currentIndex = -1;

				for (let i = 0; i < modalSubtitleSegments.length; i++) {
					const seg = modalSubtitleSegments[i];
					if (currentTime >= seg.start && currentTime <= seg.end) {
						currentSeg = seg;
						currentIndex = i;
						break;
					}
				}

				// Update the current subtitle display
				if (currentSeg) {
					modalCurrentSubtitle.textContent = currentSeg.text.trim();
				} else {
					modalCurrentSubtitle.textContent = '';
				}

				// Update active segment highlighting
				modalSegments.querySelectorAll('.modal-segment').forEach((el, idx) => {
					if (idx === currentIndex) {
						el.classList.add('active');
						// Scroll the segment into view if needed
						el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					} else {
						el.classList.remove('active');
					}
				});
			}

			function closeVideoModal() {
				videoModal.classList.remove('visible');
				document.body.style.overflow = '';

				// Stop video playback
				modalVideo.pause();
				modalVideo.src = '';

				// Clean up subtitle sync
				if (modalSubtitleSyncActive) {
					modalVideo.removeEventListener('timeupdate', updateModalSubtitle);
					modalSubtitleSyncActive = false;
				}

				currentModalVideoId = null;
				modalSubtitleSegments = [];
			}

			// Modal close handlers
			modalClose.addEventListener('click', closeVideoModal);

			// Close on clicking overlay background
			videoModal.addEventListener('click', (e) => {
				if (e.target === videoModal) {
					closeVideoModal();
				}
			});

			// Close on Escape key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && videoModal.classList.contains('visible')) {
					closeVideoModal();
				}
			});

			// Track if user is authenticated (set by checkAuth)
			let isAuthenticated = false;

			async function loadVideos() {
				try {
					// For anonymous users, include session_id in request
					// Authenticated users are filtered by user_id on backend
					let url = '/api/videos';
					if (!isAuthenticated) {
						const sessionId = getOrCreateSessionId();
						url = `/api/videos?session_id=${encodeURIComponent(sessionId)}`;
					}

					const response = await fetch(url);
					if (!response.ok) {
						const data = await response.json().catch(() => ({}));
						throw new Error(data.error || `HTTP ${response.status}`);
					}
					const data = await response.json();

					loading.style.display = 'none';

					if (!data.videos || data.videos.length === 0) {
						empty.style.display = 'block';
						return;
					}

					videoList.innerHTML = data.videos.map(renderVideo).join('');
					videoList.style.display = 'flex';
					attachRetryHandlers();
					attachViewHandlers();

				} catch (err) {
					loading.style.display = 'none';
					error.textContent = `Failed to load videos: ${err instanceof Error ? err.message : err}`;
					error.style.display = 'block';
				}
			}

			// Don't load videos immediately - wait for auth check

			// Auth handling
			const nav = document.getElementById('nav') as HTMLElement;
			const loginLink = document.getElementById('loginLink') as HTMLElement;
			const registerLink = document.getElementById('registerLink') as HTMLElement;

			async function checkAuth() {
				try {
					const response = await fetch('/api/auth/me');
					if (response.ok) {
						const data = await response.json();
						if (data.user) {
							isAuthenticated = true;
							loginLink.style.display = 'none';
							registerLink.style.display = 'none';

							// Fetch CSRF token for authenticated requests
							await fetchCsrfToken();

							const userSpan = document.createElement('span');
							userSpan.className = 'nav-user';
							userSpan.textContent = data.user.email;
							nav.appendChild(userSpan);

							const securityLink = document.createElement('a');
							securityLink.href = '/security';
							securityLink.className = 'nav-link';
							securityLink.textContent = 'Security';
							nav.appendChild(securityLink);

							const logoutBtn = document.createElement('button');
							logoutBtn.className = 'nav-logout';
							logoutBtn.textContent = 'Log out';
							logoutBtn.addEventListener('click', logout);
							nav.appendChild(logoutBtn);
						}
					}
				} catch (err) {
					// Not logged in
				}

				// Now load videos with correct filtering
				loadVideos();
			}

			async function logout() {
				try {
					await csrfFetch('/api/auth/logout', { method: 'POST' });
					clearCsrfToken();
					window.location.reload();
				} catch (err) {
					console.error('Logout failed:', err);
				}
			}

			// Start auth check (which will then load videos)
			checkAuth();
		</script>
		<CookieConsent />
	</body>
</html>
