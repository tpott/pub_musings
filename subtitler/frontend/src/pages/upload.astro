---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Upload - Subtitler</title>
		<style>
			:root {
				--bg-color: #fafafa;
				--text-color: #1a1a1a;
				--accent-color: #0066cc;
				--secondary-bg: #ffffff;
				--border-color: #e5e5e5;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background-color: var(--bg-color);
				color: var(--text-color);
				line-height: 1.6;
				min-height: 100vh;
			}
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			.header {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.back-link {
				text-decoration: none;
				color: var(--text-color);
				font-size: 1.5rem;
			}
			h1 {
				font-size: 2rem;
				font-weight: 600;
			}
			.dropzone {
				background-color: var(--secondary-bg);
				border: 2px dashed var(--border-color);
				border-radius: 12px;
				padding: 4rem 2rem;
				text-align: center;
				cursor: pointer;
				transition: border-color 0.2s, background-color 0.2s;
			}
			.dropzone:hover,
			.dropzone.dragover {
				border-color: var(--accent-color);
				background-color: #f0f7ff;
			}
			.dropzone-icon {
				font-size: 3rem;
				margin-bottom: 1rem;
			}
			.dropzone-text {
				font-size: 1.25rem;
				color: #666;
				margin-bottom: 0.5rem;
			}
			.dropzone-hint {
				font-size: 0.875rem;
				color: #999;
			}
			.file-input {
				display: none;
			}
			.status {
				margin-top: 2rem;
				padding: 1rem;
				background-color: var(--secondary-bg);
				border-radius: 8px;
				display: none;
			}
			.status.visible {
				display: block;
			}
			.status.error {
				background-color: #fff5f5;
				border: 1px solid #feb2b2;
				color: #c53030;
			}
			.status.success {
				background-color: #f0fff4;
				border: 1px solid #9ae6b4;
				color: #276749;
			}
			.progress-bar {
				width: 100%;
				height: 8px;
				background-color: var(--border-color);
				border-radius: 4px;
				margin-top: 0.5rem;
				overflow: hidden;
			}
			.progress-bar-fill {
				height: 100%;
				background-color: var(--accent-color);
				width: 0%;
				transition: width 0.3s ease;
			}
			.video-preview {
				margin-top: 2rem;
				display: none;
			}
			.video-preview.visible {
				display: block;
			}
			.video-preview video {
				max-width: 100%;
				border-radius: 8px;
			}
			.transcription {
				margin-top: 2rem;
				padding: 1.5rem;
				background-color: var(--secondary-bg);
				border-radius: 8px;
				display: none;
			}
			.transcription.visible {
				display: block;
			}
			.transcription h2 {
				font-size: 1.25rem;
				margin-bottom: 1rem;
			}
			.transcription-status {
				color: #666;
				margin-bottom: 1rem;
			}
			.segments {
				max-height: 400px;
				overflow-y: auto;
				border: 1px solid var(--border-color);
				border-radius: 4px;
			}
			.segment {
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--border-color);
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.segment:hover {
				background-color: #f5f5f5;
			}
			.segment:last-child {
				border-bottom: none;
			}
			.segment.active {
				background-color: #e6f0ff;
				border-left: 3px solid var(--accent-color);
			}
			.segment-time {
				font-size: 0.75rem;
				color: #999;
				font-family: monospace;
				margin-bottom: 0.25rem;
			}
			.segment-text {
				font-size: 0.95rem;
			}
			.current-subtitle {
				margin-top: 1rem;
				padding: 1rem;
				background-color: #1a1a1a;
				color: #fff;
				border-radius: 8px;
				font-size: 1.25rem;
				text-align: center;
				min-height: 3.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.download-btn {
				display: inline-block;
				margin-top: 1rem;
				padding: 0.75rem 1.5rem;
				background-color: var(--accent-color);
				color: #fff;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 500;
				transition: background-color 0.2s;
			}
			.download-btn:hover {
				background-color: #0052a3;
			}
			.actions {
				margin-top: 1rem;
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.full-text {
				margin-top: 1rem;
				padding: 1rem;
				background-color: var(--bg-color);
				border-radius: 4px;
				font-size: 0.95rem;
				line-height: 1.8;
			}
			.nav {
				display: flex;
				justify-content: flex-end;
				padding: 1rem 2rem;
				gap: 1rem;
			}
			.nav-link {
				color: var(--text-color);
				text-decoration: none;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				transition: background-color 0.2s;
			}
			.nav-link:hover {
				background-color: var(--border-color);
			}
			.nav-user {
				color: #666;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
			}
			.nav-logout {
				background: none;
				border: none;
				color: var(--text-color);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.nav-logout:hover {
				background-color: var(--border-color);
			}
		</style>
	</head>
	<body>
		<nav class="nav" id="nav">
			<a href="/login" class="nav-link" id="loginLink">Log in</a>
			<a href="/register" class="nav-link" id="registerLink">Sign up</a>
		</nav>
		<div class="container">
			<div class="header">
				<a href="/" class="back-link">&larr;</a>
				<h1>Upload Video</h1>
			</div>

			<div class="dropzone" id="dropzone">
				<div class="dropzone-icon">📹</div>
				<p class="dropzone-text">Drag and drop your video here</p>
				<p class="dropzone-hint">or click to browse (MP4, MOV, WebM up to 500MB)</p>
				<input type="file" class="file-input" id="fileInput" accept="video/*" />
			</div>

			<div class="video-preview" id="videoPreview">
				<video id="previewVideo" controls></video>
			</div>

			<div class="status" id="status">
				<p id="statusText">Ready to upload</p>
				<div class="progress-bar" id="progressBar" style="display: none;">
					<div class="progress-bar-fill" id="progressFill"></div>
				</div>
			</div>

			<div class="transcription" id="transcription">
				<h2>Transcription</h2>
				<p class="transcription-status" id="transcriptionStatus">Starting transcription...</p>
				<div class="current-subtitle" id="currentSubtitle"></div>
				<div class="segments" id="segments"></div>
				<div class="actions" id="actions" style="display: none;">
					<a href="#" class="download-btn" id="downloadSrt">Download SRT</a>
				</div>
				<div class="full-text" id="fullText"></div>
			</div>
		</div>

		<script>
			const dropzone = document.getElementById('dropzone') as HTMLElement;
			const fileInput = document.getElementById('fileInput') as HTMLInputElement;
			const status = document.getElementById('status') as HTMLElement;
			const statusText = document.getElementById('statusText') as HTMLElement;
			const videoPreview = document.getElementById('videoPreview') as HTMLElement;
			const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;
			const progressBar = document.getElementById('progressBar') as HTMLElement;
			const progressFill = document.getElementById('progressFill') as HTMLElement;
			const transcription = document.getElementById('transcription') as HTMLElement;
			const transcriptionStatus = document.getElementById('transcriptionStatus') as HTMLElement;
			const segments = document.getElementById('segments') as HTMLElement;
			const fullText = document.getElementById('fullText') as HTMLElement;
			const currentSubtitle = document.getElementById('currentSubtitle') as HTMLElement;
			const actions = document.getElementById('actions') as HTMLElement;
			const downloadSrt = document.getElementById('downloadSrt') as HTMLAnchorElement;

			let isUploading = false;
			let currentUploadId: string | null = null;
			let transcriptionSegments: any[] = [];

			dropzone.addEventListener('click', () => fileInput.click());

			dropzone.addEventListener('dragover', (e) => {
				e.preventDefault();
				dropzone.classList.add('dragover');
			});

			dropzone.addEventListener('dragleave', () => {
				dropzone.classList.remove('dragover');
			});

			dropzone.addEventListener('drop', (e) => {
				e.preventDefault();
				dropzone.classList.remove('dragover');
				const files = e.dataTransfer?.files;
				if (files && files.length > 0) {
					handleFile(files[0]);
				}
			});

			fileInput.addEventListener('change', () => {
				const files = fileInput.files;
				if (files && files.length > 0) {
					handleFile(files[0]);
				}
			});

			function handleFile(file: File) {
				if (isUploading) {
					showStatus('Upload already in progress', 'error');
					return;
				}

				if (!file.type.startsWith('video/')) {
					showStatus('Please select a video file', 'error');
					return;
				}

				// Check file size (500 MB max)
				const maxSize = 500 * 1024 * 1024;
				if (file.size > maxSize) {
					showStatus('File too large. Maximum size is 500 MB.', 'error');
					return;
				}

				// Show video preview
				const url = URL.createObjectURL(file);
				previewVideo.src = url;
				videoPreview.classList.add('visible');

				showStatus(`Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`);

				// Start upload
				uploadFile(file);
			}

			function showStatus(message: string, type?: 'error' | 'success') {
				statusText.textContent = message;
				status.classList.add('visible');
				status.classList.remove('error', 'success');
				if (type) {
					status.classList.add(type);
				}
			}

			function showProgress(percent: number) {
				progressBar.style.display = 'block';
				progressFill.style.width = `${percent}%`;
			}

			function hideProgress() {
				progressBar.style.display = 'none';
				progressFill.style.width = '0%';
			}

			async function uploadFile(file: File) {
				isUploading = true;
				const formData = new FormData();
				formData.append('video', file);

				try {
					showStatus('Uploading...');
					showProgress(0);

					// Use XMLHttpRequest for progress tracking
					const xhr = new XMLHttpRequest();

					xhr.upload.addEventListener('progress', (e) => {
						if (e.lengthComputable) {
							const percent = Math.round((e.loaded / e.total) * 100);
							showProgress(percent);
							showStatus(`Uploading... ${percent}%`);
						}
					});

					const uploadPromise = new Promise<any>((resolve, reject) => {
						xhr.onload = () => {
							if (xhr.status >= 200 && xhr.status < 300) {
								try {
									resolve(JSON.parse(xhr.responseText));
								} catch {
									reject(new Error('Invalid JSON response'));
								}
							} else {
								try {
									const error = JSON.parse(xhr.responseText);
									reject(new Error(error.error || 'Upload failed'));
								} catch {
									reject(new Error(`Upload failed: ${xhr.status}`));
								}
							}
						};
						xhr.onerror = () => reject(new Error('Network error'));
					});

					xhr.open('POST', '/api/upload');
					xhr.send(formData);

					const result = await uploadPromise;
					hideProgress();
					showStatus(`Upload complete! Starting transcription...`, 'success');
					console.log('Upload result:', result);

					// Store upload ID and start transcription
					currentUploadId = result.upload_id;
					startTranscription(result.upload_id);

				} catch (error) {
					hideProgress();
					showStatus(`Upload failed: ${error instanceof Error ? error.message : error}`, 'error');
				} finally {
					isUploading = false;
				}
			}

			async function startTranscription(uploadId: string) {
				transcription.classList.add('visible');
				transcriptionStatus.textContent = 'Starting transcription...';
				segments.innerHTML = '';
				fullText.textContent = '';

				try {
					// Start transcription
					const response = await fetch(`/api/transcribe/${uploadId}`, {
						method: 'POST',
					});
					const result = await response.json();
					console.log('Transcription started:', result);

					// Start polling for status
					pollTranscriptionStatus(uploadId);
				} catch (error) {
					transcriptionStatus.textContent = `Failed to start transcription: ${error}`;
				}
			}

			async function pollTranscriptionStatus(uploadId: string) {
				const poll = async () => {
					try {
						const response = await fetch(`/api/transcribe/${uploadId}`);
						const result = await response.json();

						if (result.status === 'processing') {
							transcriptionStatus.textContent = result.message || 'Processing...';
							if (result.progress) {
								transcriptionStatus.textContent += ` (${result.progress}%)`;
							}
							// Continue polling
							setTimeout(poll, 2000);
						} else if (result.status === 'complete') {
							transcriptionStatus.textContent = 'Transcription complete!';
							displayTranscription(result.result);
						} else if (result.status === 'error') {
							transcriptionStatus.textContent = `Error: ${result.message}`;
						} else if (result.status === 'pending') {
							transcriptionStatus.textContent = 'Waiting to start...';
							setTimeout(poll, 2000);
						}
					} catch (error) {
						transcriptionStatus.textContent = `Polling error: ${error}`;
					}
				};

				poll();
			}

			function formatTime(seconds: number): string {
				const hrs = Math.floor(seconds / 3600);
				const mins = Math.floor((seconds % 3600) / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 1000);

				if (hrs > 0) {
					return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
				}
				return `${mins}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
			}

			function displayTranscription(result: any) {
				if (!result) return;

				// Store segments for syncing
				transcriptionSegments = result.segments || [];

				// Display full text
				if (result.text) {
					fullText.textContent = result.text;
				}

				// Display segments with click handlers
				if (transcriptionSegments.length > 0) {
					segments.innerHTML = transcriptionSegments.map((seg: any, index: number) => `
						<div class="segment" data-index="${index}" data-start="${seg.start}" data-end="${seg.end}">
							<div class="segment-time">${formatTime(seg.start)} - ${formatTime(seg.end)}</div>
							<div class="segment-text">${seg.text}</div>
						</div>
					`).join('');

					// Add click handlers for seeking
					segments.querySelectorAll('.segment').forEach(el => {
						el.addEventListener('click', () => {
							const start = parseFloat(el.getAttribute('data-start') || '0');
							previewVideo.currentTime = start;
							previewVideo.play();
						});
					});
				}

				// Show download button
				if (currentUploadId) {
					downloadSrt.href = `/api/videos/${currentUploadId}/subtitles.srt`;
					actions.style.display = 'flex';
				}

				// Load video from server for playback (replacing blob URL)
				if (currentUploadId) {
					previewVideo.src = `/api/videos/${currentUploadId}/video`;
				}

				// Set up video timeupdate handler for subtitle syncing
				setupSubtitleSync();
			}

			function setupSubtitleSync() {
				previewVideo.addEventListener('timeupdate', updateCurrentSubtitle);
			}

			function updateCurrentSubtitle() {
				const currentTime = previewVideo.currentTime;

				// Find the current segment
				let currentSeg = null;
				let currentIndex = -1;

				for (let i = 0; i < transcriptionSegments.length; i++) {
					const seg = transcriptionSegments[i];
					if (currentTime >= seg.start && currentTime <= seg.end) {
						currentSeg = seg;
						currentIndex = i;
						break;
					}
				}

				// Update the current subtitle display
				if (currentSeg) {
					currentSubtitle.textContent = currentSeg.text.trim();
				} else {
					currentSubtitle.textContent = '';
				}

				// Update active segment highlighting
				segments.querySelectorAll('.segment').forEach((el, idx) => {
					if (idx === currentIndex) {
						el.classList.add('active');
						// Scroll the segment into view if needed
						el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					} else {
						el.classList.remove('active');
					}
				});
			}

			// Auth handling
			const nav = document.getElementById('nav') as HTMLElement;
			const loginLink = document.getElementById('loginLink') as HTMLElement;
			const registerLink = document.getElementById('registerLink') as HTMLElement;

			async function checkAuth() {
				try {
					const response = await fetch('/api/auth/me');
					if (response.ok) {
						const data = await response.json();
						if (data.user) {
							loginLink.style.display = 'none';
							registerLink.style.display = 'none';

							const userSpan = document.createElement('span');
							userSpan.className = 'nav-user';
							userSpan.textContent = data.user.email;
							nav.appendChild(userSpan);

							const logoutBtn = document.createElement('button');
							logoutBtn.className = 'nav-logout';
							logoutBtn.textContent = 'Log out';
							logoutBtn.addEventListener('click', logout);
							nav.appendChild(logoutBtn);
						}
					}
				} catch (err) {
					// Not logged in
				}
			}

			async function logout() {
				try {
					await fetch('/api/auth/logout', { method: 'POST' });
					window.location.reload();
				} catch (err) {
					console.error('Logout failed:', err);
				}
			}

			checkAuth();
		</script>
	</body>
</html>
