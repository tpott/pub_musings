						<span class="tooltip-container">
							<span class="tooltip-icon">?</span>
							<span class="tooltip-text">
								<strong>Standard mode:</strong> Best for spoken word, interviews, and presentations. Uses basic text matching.<br><br>
								<strong>Lyrics mode:</strong> Best for music videos and songs. Handles elongated words ("loooove"), vocal substitutions ("you" → "ooh"), and repeated choruses.
							</span>
						</span>
					</div>
					<div class="script-conversion-section">
						<div class="script-conversion-header">
							<input type="checkbox" id="convertScript" />
							<label for="convertScript">Convert to native script (e.g., romanized Hindi → Devanagari)</label>
						</div>
						<div class="script-selectors hidden" id="scriptSelectors">
							<div class="selector-group">
								<label for="languageSelect">Language</label>
								<select id="languageSelect">
									<option value="hi">Hindi</option>
									<option value="ml">Malayalam</option>
									<option value="ta">Tamil</option>
									<option value="te">Telugu</option>
									<option value="kn">Kannada</option>
									<option value="bn">Bengali</option>
									<option value="gu">Gujarati</option>
									<option value="or">Oriya</option>
									<option value="pa">Punjabi</option>
								</select>
							</div>
							<div class="selector-group">
								<label for="scriptSelect">Target Script</label>
								<select id="scriptSelect">
									<option value="Devanagari">Devanagari</option>
								</select>
							</div>
						</div>
						<p class="script-conversion-hint" id="scriptHint"></p>
					</div>
					<button class="align-btn" id="alignBtn">Align Transcript</button>
					<div class="align-status" id="alignStatus"></div>
				</div>
				<div class="actions" id="actions" style="display: none;">
					<button class="edit-btn" id="editBtn">Edit Subtitles</button>
					<div class="download-group">
						<a href="#" class="download-btn" id="downloadSrt" aria-label="Download subtitles in SRT format">Download SRT</a>
						<a href="#" class="download-btn download-btn-secondary" id="downloadVtt" aria-label="Download subtitles in VTT format">VTT</a>
						<a href="#" class="download-btn download-btn-secondary" id="downloadJson" aria-label="Download subtitles in JSON format">JSON</a>
					</div>
					<button class="burn-btn" id="burnBtn">Burn Subtitles into Video</button>
				</div>
				<div class="burn-status" id="burnStatus">
					<p id="burnStatusText">Starting...</p>
					<p id="burnEtaText" class="burn-eta" style="display: none;"></p>
					<div class="progress-bar" id="burnProgressBar">
						<div class="progress-bar-fill" id="burnProgressFill"></div>
					</div>
					<a href="#" class="download-burned-btn" id="downloadBurnedBtn" style="display: none;">Download Video with Subtitles</a>
				</div>
				<div class="full-text" id="fullText"></div>
			</div>
		</div>

		<script>
			import { csrfFetch, fetchCsrfToken, clearCsrfToken, getCsrfToken, CSRF_HEADER } from '../utils/csrf';
			import { getOrCreateSessionId, cleanupStaleUploadSessions, recordUploadSession, removeUploadSessionRecord } from '../utils/session';
			import { parseTimeString } from '../utils/validation';
			import { escapeHtml } from '../utils/html';
			import type {
				TranscriptionSegment,
				TranscriptionResult,
				TranscriptionStatusResponse,
				AlignmentResponse,
				BurnStatusResponse
			} from '../types/transcription';

			const dropzone = document.getElementById('dropzone') as HTMLElement;
			const fileInput = document.getElementById('fileInput') as HTMLInputElement;
			const status = document.getElementById('status') as HTMLElement;
			const statusText = document.getElementById('statusText') as HTMLElement;
			const videoPreview = document.getElementById('videoPreview') as HTMLElement;
			const previewVideo = document.getElementById('previewVideo') as HTMLVideoElement;
			const progressBar = document.getElementById('progressBar') as HTMLElement;
			const progressFill = document.getElementById('progressFill') as HTMLElement;
			const transcription = document.getElementById('transcription') as HTMLElement;
			const transcriptionStatus = document.getElementById('transcriptionStatus') as HTMLElement;
			const segments = document.getElementById('segments') as HTMLElement;
			const fullText = document.getElementById('fullText') as HTMLElement;
			const currentSubtitle = document.getElementById('currentSubtitle') as HTMLElement;
			const actions = document.getElementById('actions') as HTMLElement;
			const downloadSrt = document.getElementById('downloadSrt') as HTMLAnchorElement;
			const downloadVtt = document.getElementById('downloadVtt') as HTMLAnchorElement;
			const downloadJson = document.getElementById('downloadJson') as HTMLAnchorElement;
			const editBtn = document.getElementById('editBtn') as HTMLButtonElement;
			const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
			const cancelBtn = document.getElementById('cancelBtn') as HTMLButtonElement;
			const editActions = document.getElementById('editActions') as HTMLElement;
			const addSegmentBtn = document.getElementById('addSegmentBtn') as HTMLButtonElement;
			const unsavedIndicator = document.getElementById('unsavedIndicator') as HTMLElement;
			const burnBtn = document.getElementById('burnBtn') as HTMLButtonElement;
			const burnStatus = document.getElementById('burnStatus') as HTMLElement;
			const burnStatusText = document.getElementById('burnStatusText') as HTMLElement;
			const burnEtaText = document.getElementById('burnEtaText') as HTMLElement;
			const burnProgressBar = document.getElementById('burnProgressBar') as HTMLElement;
			const burnProgressFill = document.getElementById('burnProgressFill') as HTMLElement;
			const downloadBurnedBtn = document.getElementById('downloadBurnedBtn') as HTMLAnchorElement;
			const pasteTranscript = document.getElementById('pasteTranscript') as HTMLElement;
			const pasteText = document.getElementById('pasteText') as HTMLTextAreaElement;
			const convertScript = document.getElementById('convertScript') as HTMLInputElement;
			const scriptSelectors = document.getElementById('scriptSelectors') as HTMLElement;
			const languageSelect = document.getElementById('languageSelect') as HTMLSelectElement;
			const scriptSelect = document.getElementById('scriptSelect') as HTMLSelectElement;
			const scriptHint = document.getElementById('scriptHint') as HTMLElement;
			const lyricsMode = document.getElementById('lyricsMode') as HTMLInputElement;
			const alignBtn = document.getElementById('alignBtn') as HTMLButtonElement;
			const alignStatus = document.getElementById('alignStatus') as HTMLElement;
			const languageSection = document.getElementById('languageSection') as HTMLElement;
			const transcriptionLanguageSelect = document.getElementById('transcriptionLanguageSelect') as HTMLSelectElement;
			const retranscribeBtn = document.getElementById('retranscribeBtn') as HTMLButtonElement;
			const detectedLanguage = document.getElementById('detectedLanguage') as HTMLElement;
			const detectedLanguageValue = document.getElementById('detectedLanguageValue') as HTMLElement;

			// Language display names for showing detected language
			const languageDisplayNames: Record<string, string> = {
				'auto': 'Auto-detect',
				'en': 'English',
				'es': 'Spanish',
				'fr': 'French',
				'de': 'German',
				'it': 'Italian',
				'pt': 'Portuguese',
				'ru': 'Russian',
				'zh': 'Chinese',
				'ja': 'Japanese',
				'ko': 'Korean',
				'ar': 'Arabic',
				'hi': 'Hindi',
				'nl': 'Dutch',
				'pl': 'Polish',
				'tr': 'Turkish',
				'vi': 'Vietnamese',
				'th': 'Thai',
				'id': 'Indonesian',
				'uk': 'Ukrainian',
				'sv': 'Swedish',
				'cs': 'Czech',
				'el': 'Greek',
				'he': 'Hebrew',
				'hu': 'Hungarian',
				'no': 'Norwegian',
				'da': 'Danish',
				'fi': 'Finnish',
				'ro': 'Romanian',
				'sk': 'Slovak',
				'bg': 'Bulgarian',
				'hr': 'Croatian',
				'lt': 'Lithuanian',
				'lv': 'Latvian',
				'sl': 'Slovenian',
				'et': 'Estonian',
				'ms': 'Malay',
				'tl': 'Filipino',
				'bn': 'Bengali',
				'ta': 'Tamil',
				'te': 'Telugu',
				'ur': 'Urdu',
				'fa': 'Persian',
				'ml': 'Malayalam',
				'sw': 'Swahili'
			};

			// LocalStorage key for preferred language
			const PREFERRED_LANGUAGE_KEY = 'subtitler:transcription_language';

			// Clean up stale upload sessions on page load
			cleanupStaleUploadSessions();

			let isUploading = false;
			let currentUploadId: string | null = null;
			let transcriptionSegments: TranscriptionSegment[] = [];
			let editedSegments: TranscriptionSegment[] = [];
			let isEditMode = false;
			let hasUnsavedChanges = false;

			// Cleanup management for long-running operations
			let transcriptionPollTimeout: ReturnType<typeof setTimeout> | null = null;
			let burnPollTimeout: ReturnType<typeof setTimeout> | null = null;
			let fetchAbortController: AbortController | null = null;

			// Track if subtitle sync is set up
			let subtitleSyncActive = false;

			// Cleanup function to abort pending fetches and clear timeouts
			function cleanupPendingOperations() {
				if (transcriptionPollTimeout !== null) {
					clearTimeout(transcriptionPollTimeout);
					transcriptionPollTimeout = null;
				}
				if (burnPollTimeout !== null) {
					clearTimeout(burnPollTimeout);
					burnPollTimeout = null;
				}
				if (fetchAbortController) {
					fetchAbortController.abort();
					fetchAbortController = null;
				}
			}

			// Cleanup on page unload to prevent memory leaks
			window.addEventListener('beforeunload', () => {
				cleanupPendingOperations();
				// Remove video timeupdate listener if active
				if (subtitleSyncActive && previewVideo) {
					previewVideo.removeEventListener('timeupdate', updateCurrentSubtitle);
					subtitleSyncActive = false;
				}
			});
			// Also cleanup on pagehide (for bfcache-enabled browsers)
			window.addEventListener('pagehide', cleanupPendingOperations);

			// Language to native script mapping
			const languageScriptMap: { [key: string]: string[] } = {
				'hi': ['Devanagari'],
				'ml': ['Malayalam'],
				'ta': ['Tamil'],
				'te': ['Telugu'],
				'kn': ['Kannada'],
				'bn': ['Bengali'],
				'gu': ['Gujarati'],
				'or': ['Oriya'],
				'pa': ['Gurmukhi']
			};

			// Language display names
			const languageNames: { [key: string]: string } = {
				'hi': 'Hindi',
				'ml': 'Malayalam',
				'ta': 'Tamil',
				'te': 'Telugu',
				'kn': 'Kannada',
				'bn': 'Bengali',
				'gu': 'Gujarati',
				'or': 'Oriya',
				'pa': 'Punjabi'
			};

			// Update script options based on selected language
			function updateScriptOptions() {
				const lang = languageSelect.value;
				const scripts = languageScriptMap[lang] || ['Devanagari'];

				scriptSelect.innerHTML = scripts.map(s =>
					`<option value="${s}">${s}</option>`
				).join('');

				// Update hint
				const langName = languageNames[lang] || lang;
				scriptHint.textContent = `Romanized ${langName} text will be converted to ${scripts[0]} script.`;
			}

			// Toggle script selectors visibility
			convertScript.addEventListener('change', () => {
				if (convertScript.checked) {
					scriptSelectors.classList.remove('hidden');
					updateScriptOptions();
				} else {
					scriptSelectors.classList.add('hidden');
					scriptHint.textContent = '';
				}
			});

			// Update scripts when language changes
			languageSelect.addEventListener('change', updateScriptOptions);

			dropzone.addEventListener('click', () => fileInput.click());

			dropzone.addEventListener('dragover', (e) => {
				e.preventDefault();
				dropzone.classList.add('dragover');
			});

			dropzone.addEventListener('dragleave', () => {
				dropzone.classList.remove('dragover');
			});

			dropzone.addEventListener('drop', (e) => {
				e.preventDefault();
				dropzone.classList.remove('dragover');
				const files = e.dataTransfer?.files;
				if (files && files.length > 0) {
					handleFile(files[0]);
				}
			});

			fileInput.addEventListener('change', () => {
				const files = fileInput.files;
				if (files && files.length > 0) {
					handleFile(files[0]);
				}
			});

			function handleFile(file: File) {
				if (isUploading) {
					showStatus('Upload already in progress', 'error');
					return;
				}

				if (!file.type.startsWith('video/')) {
					showStatus('Please select a video file', 'error');
					return;
				}

				// Check file size (500 MB max)
				const maxSize = 500 * 1024 * 1024;
				if (file.size > maxSize) {
					showStatus('File too large. Maximum size is 500 MB.', 'error');
					return;
				}

				// Show video preview
				const url = URL.createObjectURL(file);
				previewVideo.src = url;
				videoPreview.classList.add('visible');

				// Show language section and restore preferred language
				languageSection.style.display = 'block';
				const savedLanguage = localStorage.getItem(PREFERRED_LANGUAGE_KEY);
				if (savedLanguage && transcriptionLanguageSelect.querySelector(`option[value="${savedLanguage}"]`)) {
					transcriptionLanguageSelect.value = savedLanguage;
				}
				// Hide re-transcribe button and detected language (will show after transcription)
				retranscribeBtn.style.display = 'none';
				detectedLanguage.style.display = 'none';

				showStatus(`Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`);

				// Start upload
				uploadFile(file);
			}

			function showStatus(message: string, type?: 'error' | 'success') {
				statusText.textContent = message;
				status.classList.add('visible');
				status.classList.remove('error', 'success');
				if (type) {
					status.classList.add(type);
				}
			}

			function showProgress(percent: number) {
				progressBar.style.display = 'block';
				progressFill.style.width = `${percent}%`;
			}

			function hideProgress() {
				progressBar.style.display = 'none';
				progressFill.style.width = '0%';
			}

			// Chunk size for chunked uploads (50 MB)
			const CHUNK_SIZE = 50 * 1024 * 1024;

			// LocalStorage key for upload session resumability
			const UPLOAD_SESSION_PREFIX = 'subtitler:upload_session:';

			async function uploadFile(file: File) {
				isUploading = true;

				try {
					showStatus('Uploading...');
					showProgress(0);

					// Use chunked upload for files larger than chunk size
					if (file.size > CHUNK_SIZE) {
						await uploadFileChunked(file);
					} else {
						await uploadFileSingle(file);
					}
				} catch (error) {
					hideProgress();
					showStatus(`Upload failed: ${error instanceof Error ? error.message : error}`, 'error');
				} finally {
					isUploading = false;
				}
			}

			// Single-file upload for small files
			async function uploadFileSingle(file: File) {
				const formData = new FormData();
				formData.append('video', file);

				// Use XMLHttpRequest for progress tracking
				const xhr = new XMLHttpRequest();

				xhr.upload.addEventListener('progress', (e) => {
					if (e.lengthComputable) {
						const percent = Math.round((e.loaded / e.total) * 100);
						showProgress(percent);
						showStatus(`Uploading... ${percent}%`);
					}
				});

				const uploadPromise = new Promise<any>((resolve, reject) => {
					xhr.onload = () => {
						if (xhr.status >= 200 && xhr.status < 300) {
							try {
								resolve(JSON.parse(xhr.responseText));
							} catch {
								reject(new Error('Invalid JSON response'));
							}
						} else {
							try {
								const error = JSON.parse(xhr.responseText);
								reject(new Error(error.error || 'Upload failed'));
							} catch {
								reject(new Error(`Upload failed: ${xhr.status}`));
							}
						}
					};
					xhr.onerror = () => reject(new Error('Network error'));
				});

				// For anonymous users, include session_id for tracking
				let uploadUrl = '/api/upload';
				if (!isAuthenticated) {
					const sessionId = getOrCreateSessionId();
					uploadUrl = `/api/upload?session_id=${encodeURIComponent(sessionId)}`;
				}
				xhr.open('POST', uploadUrl);

				// Add CSRF token for authenticated users
				if (isAuthenticated) {
					const csrfToken = await getCsrfToken();
					if (csrfToken) {
						xhr.setRequestHeader(CSRF_HEADER, csrfToken);
					}
				}

				xhr.send(formData);

				const result = await uploadPromise;
				hideProgress();
				showStatus(`Upload complete! Starting transcription...`, 'success');

				// Store upload ID and start transcription
				currentUploadId = result.upload_id;
				startTranscription(result.upload_id);
			}

			// Chunked upload for large files
			async function uploadFileChunked(file: File) {
				const sessionKey = `${UPLOAD_SESSION_PREFIX}${file.name}:${file.size}`;
				let sessionId = localStorage.getItem(sessionKey);
				let uploadSession: any = null;
				let receivedChunks: number[] = [];

				// Check for resumable session
				if (sessionId) {
					try {
						const statusUrl = getSessionQueryUrl(`/api/upload/status/${sessionId}`);
						const statusRes = await fetch(statusUrl);
						if (statusRes.ok) {
							uploadSession = await statusRes.json();
							if (uploadSession.status === 'in_progress') {
								receivedChunks = uploadSession.received_chunks || [];
								showStatus(`Resuming upload... ${uploadSession.progress}% complete`);
								showProgress(uploadSession.progress);
							} else {
								// Session expired or completed, start fresh
								localStorage.removeItem(sessionKey);
								removeUploadSessionRecord(sessionKey);
								sessionId = null;
								uploadSession = null;
							}
						} else {
							// Session not found, start fresh
							localStorage.removeItem(sessionKey);
							removeUploadSessionRecord(sessionKey);
							sessionId = null;
						}
					} catch {
						localStorage.removeItem(sessionKey);
						removeUploadSessionRecord(sessionKey);
						sessionId = null;
					}
				}

				// Initialize new upload session if needed
				if (!sessionId) {
					const initUrl = getSessionQueryUrl('/api/upload/init');
					const initRes = await csrfFetch(initUrl, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							filename: file.name,
							size: file.size,
							content_type: file.type || 'video/mp4',
							chunk_size: CHUNK_SIZE
						})
					});

					if (!initRes.ok) {
						const error = await initRes.json().catch(() => ({ error: 'Failed to initialize upload' }));
						throw new Error(error.error || 'Failed to initialize upload');
					}

					uploadSession = await initRes.json();
					sessionId = uploadSession.upload_session_id;
					localStorage.setItem(sessionKey, sessionId);
					recordUploadSession(sessionKey);
					receivedChunks = [];
				}

				const totalChunks = uploadSession.total_chunks;

				// Upload chunks
				for (let i = 0; i < totalChunks; i++) {
					// Skip already uploaded chunks
					if (receivedChunks.includes(i)) {
						continue;
					}

					const start = i * CHUNK_SIZE;
					const end = Math.min(start + CHUNK_SIZE, file.size);
					const chunk = file.slice(start, end);

					const formData = new FormData();
					formData.append('upload_session_id', sessionId!);
					formData.append('chunk_index', i.toString());
					formData.append('chunk', chunk);

					// Upload chunk with progress tracking
					const xhr = new XMLHttpRequest();

					xhr.upload.addEventListener('progress', (e) => {
						if (e.lengthComputable) {
							// Calculate overall progress including current chunk progress
							const chunkProgress = e.loaded / e.total;
							const overallProgress = ((i + chunkProgress) / totalChunks) * 100;
							showProgress(Math.round(overallProgress));
							showStatus(`Uploading chunk ${i + 1}/${totalChunks}... ${Math.round(chunkProgress * 100)}%`);
						}
					});

					const chunkUrl = getSessionQueryUrl('/api/upload/chunk');

					// Get CSRF token before entering the Promise (for authenticated users)
					const chunkCsrfToken = isAuthenticated ? await getCsrfToken() : null;

					await new Promise<void>((resolve, reject) => {
						xhr.onload = () => {
							if (xhr.status >= 200 && xhr.status < 300) {
								resolve();
							} else {
								try {
									const error = JSON.parse(xhr.responseText);
									reject(new Error(error.error || `Chunk ${i} upload failed`));
								} catch {
									reject(new Error(`Chunk ${i} upload failed: ${xhr.status}`));
								}
							}
						};
						xhr.onerror = () => reject(new Error(`Network error uploading chunk ${i}`));

						xhr.open('POST', chunkUrl);

						// Add CSRF token for authenticated users
						if (chunkCsrfToken) {
							xhr.setRequestHeader(CSRF_HEADER, chunkCsrfToken);
						}

						xhr.send(formData);
					});

					// Update progress after successful chunk
					const progress = Math.round(((i + 1) / totalChunks) * 100);
					showProgress(progress);
					showStatus(`Uploaded chunk ${i + 1}/${totalChunks} (${progress}%)`);
				}

				// Complete the upload
				showStatus('Finalizing upload...');
				const completeUrl = getSessionQueryUrl('/api/upload/complete');
				const completeRes = await csrfFetch(completeUrl, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ upload_session_id: sessionId })
				});

				if (!completeRes.ok) {
					const error = await completeRes.json().catch(() => ({ error: 'Failed to complete upload' }));
					throw new Error(error.error || 'Failed to complete upload');
				}

				const result = await completeRes.json();

				// Clean up localStorage
				localStorage.removeItem(sessionKey);
				removeUploadSessionRecord(sessionKey);

				hideProgress();
				showStatus(`Upload complete! Starting transcription...`, 'success');

				// Store upload ID and start transcription
				currentUploadId = result.upload_id;
				startTranscription(result.upload_id);
			}

			// Helper to add session_id query param for anonymous users
			function getSessionQueryUrl(baseUrl: string): string {
				if (!isAuthenticated) {
					const sessionId = getOrCreateSessionId();
					const separator = baseUrl.includes('?') ? '&' : '?';
					return `${baseUrl}${separator}session_id=${encodeURIComponent(sessionId)}`;
				}
				return baseUrl;
			}

			async function startTranscription(uploadId: string, language?: string) {
				transcription.classList.add('visible');
				transcriptionStatus.textContent = 'Starting transcription...';
				segments.innerHTML = '';
				fullText.textContent = '';

				// Use provided language or get from selector
				const selectedLanguage = language || transcriptionLanguageSelect.value;

				// Save preferred language to localStorage
				if (selectedLanguage && selectedLanguage !== 'auto') {
					localStorage.setItem(PREFERRED_LANGUAGE_KEY, selectedLanguage);
				}

				try {
					// Start transcription with language parameter
					let transcribeUrl = `/api/transcribe/${uploadId}`;
					if (selectedLanguage && selectedLanguage !== 'auto') {
						transcribeUrl += `?language=${encodeURIComponent(selectedLanguage)}`;
					}

					const response = await csrfFetch(transcribeUrl, {
						method: 'POST',
					});
					const result = await response.json();

					// Start polling for status
					pollTranscriptionStatus(uploadId);
				} catch (error) {
					transcriptionStatus.textContent = `Failed to start transcription: ${error}`;
				}
			}

			async function pollTranscriptionStatus(uploadId: string) {
				// Clear any existing poll timeout
				if (transcriptionPollTimeout !== null) {
					clearTimeout(transcriptionPollTimeout);
					transcriptionPollTimeout = null;
				}

				const poll = async () => {
					try {
						// Create a new AbortController for this fetch
						fetchAbortController = new AbortController();
						const response = await fetch(`/api/transcribe/${uploadId}`, {
							signal: fetchAbortController.signal
						});
						const result = await response.json();

						if (result.status === 'processing') {
							transcriptionStatus.textContent = result.message || 'Processing...';
							if (result.progress) {
								transcriptionStatus.textContent += ` (${result.progress}%)`;
							}
							// Continue polling with tracked timeout
							transcriptionPollTimeout = setTimeout(poll, 2000);
						} else if (result.status === 'complete') {
							transcriptionPollTimeout = null;
							transcriptionStatus.textContent = 'Transcription complete!';
							displayTranscription(result.result);
						} else if (result.status === 'error') {
							transcriptionPollTimeout = null;
							transcriptionStatus.textContent = `Error: ${result.message}`;
						} else if (result.status === 'pending') {
							transcriptionStatus.textContent = 'Waiting to start...';
							transcriptionPollTimeout = setTimeout(poll, 2000);
						}
					} catch (error) {
						// Ignore abort errors (expected during cleanup)
						if (error instanceof Error && error.name === 'AbortError') {
							return;
						}
						transcriptionPollTimeout = null;
						transcriptionStatus.textContent = `Polling error: ${error}`;
					}
				};

				poll();
			}

			function formatTime(seconds: number): string {
				const hrs = Math.floor(seconds / 3600);
				const mins = Math.floor((seconds % 3600) / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 1000);

				if (hrs > 0) {
					return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
				}
				return `${mins}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
			}

			// Format duration for estimated time remaining display (human-readable)
			function formatDuration(seconds: number): string {
				if (seconds < 0) seconds = 0;
				const mins = Math.floor(seconds / 60);
				const secs = Math.floor(seconds % 60);
				if (mins > 0) {
					return `${mins}m ${secs}s`;
				}
				return `${secs}s`;
			}

			function displayTranscription(result: TranscriptionResult | null) {
				if (!result) return;

				// Store segments for syncing
				transcriptionSegments = result.segments || [];
				editedSegments = JSON.parse(JSON.stringify(transcriptionSegments)); // Deep copy for editing

				// Display full text
				if (result.text) {
					fullText.textContent = result.text;
				}

				// Display detected language
				if (result.language) {
					const displayName = languageDisplayNames[result.language] || result.language.toUpperCase();
					detectedLanguageValue.textContent = displayName;
					detectedLanguage.style.display = 'block';

					// Show re-transcribe button in case user wants to force a different language
					retranscribeBtn.style.display = 'inline-block';
				}

				// Render segments
				renderSegments();

				// Show download buttons and paste transcript section
				if (currentUploadId) {
					downloadSrt.href = `/api/videos/${currentUploadId}/subtitles.srt`;
					downloadVtt.href = `/api/videos/${currentUploadId}/subtitles.vtt`;
					downloadJson.href = `/api/videos/${currentUploadId}/subtitles.json`;
					actions.style.display = 'flex';
					pasteTranscript.classList.add('visible');
				}

				// Load video from server for playback (replacing blob URL)
				if (currentUploadId) {
					previewVideo.src = `/api/videos/${currentUploadId}/video`;
				}

				// Set up video timeupdate handler for subtitle syncing
				setupSubtitleSync();
			}

			// Align pasted transcript with transcription timing
			async function alignTranscript() {
				if (!currentUploadId) return;

				const text = pasteText.value.trim();
				if (!text) {
					alignStatus.textContent = 'Please paste some text first.';
					alignStatus.className = 'align-status error';
					return;
				}

				alignBtn.disabled = true;
				alignBtn.textContent = 'Aligning...';
				alignStatus.textContent = '';
				alignStatus.className = 'align-status';

				try {
					const mode = lyricsMode.checked ? 'lyrics' : 'standard';

					// Build request payload
					const payload: { text: string; mode: string; convert_to_script?: string; language?: string } = { text, mode };

					// Add script conversion parameters if enabled
					if (convertScript.checked) {
						payload.convert_to_script = scriptSelect.value;
						payload.language = languageSelect.value;
					}

					const response = await csrfFetch(`/api/transcribe/${currentUploadId}/align`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(payload)
					});

					const result = await response.json();

					if (!response.ok) {
						throw new Error(result.error || 'Alignment failed');
					}

					// Refresh the transcription to show aligned segments
					const transcriptionResponse = await fetch(`/api/transcribe/${currentUploadId}`);
					const transcriptionResult = await transcriptionResponse.json();

					if (transcriptionResult.status === 'complete' && transcriptionResult.result) {
						transcriptionSegments = transcriptionResult.result.segments || [];
						editedSegments = JSON.parse(JSON.stringify(transcriptionSegments));
						fullText.textContent = transcriptionSegments.map((s) => s.text).join(' ');
						renderSegments();
					}

					const matchPct = result.stats?.match_rate ? Math.round(result.stats.match_rate * 100) : 0;
					let statusMsg = `Aligned ${result.segments} segments (${matchPct}% match rate, ${result.mode} mode)`;
					if (result.script_converted) {
						statusMsg += ` — converted to ${result.target_script}`;
					}
					alignStatus.textContent = statusMsg;
					alignStatus.className = 'align-status success';
					pasteText.value = ''; // Clear after successful alignment

				} catch (error) {
					alignStatus.textContent = `Error: ${error instanceof Error ? error.message : error}`;
					alignStatus.className = 'align-status error';
				} finally {
					alignBtn.disabled = false;
					alignBtn.textContent = 'Align Transcript';
				}
			}

			alignBtn.addEventListener('click', alignTranscript);

			function renderSegments() {
				const segsToRender = isEditMode ? editedSegments : transcriptionSegments;

				if (segsToRender.length > 0) {
					segments.innerHTML = segsToRender.map((seg, index) => `
						<div class="segment${isEditMode ? ' editing' : ''}" data-index="${index}" data-start="${seg.start}" data-end="${seg.end}">
							<div class="segment-time">${formatTime(seg.start)} - ${formatTime(seg.end)}</div>
							<div class="segment-text">${escapeHtml(seg.text)}</div>
							<div class="segment-edit">
								<div class="time-inputs">
									<label>Start:</label>
									<input type="text" class="time-input-start" value="${formatTimeForInput(seg.start)}" data-index="${index}" aria-describedby="time-error-start-${index}" />
									<label>End:</label>
									<input type="text" class="time-input-end" value="${formatTimeForInput(seg.end)}" data-index="${index}" aria-describedby="time-error-end-${index}" />
								</div>
								<div class="time-error" id="time-error-start-${index}" data-type="start" data-index="${index}" role="alert"></div>
								<div class="time-error" id="time-error-end-${index}" data-type="end" data-index="${index}" role="alert"></div>
								<textarea class="segment-textarea" data-index="${index}">${escapeHtml(seg.text)}</textarea>
								<div class="segment-actions">
									<button class="segment-delete-btn" data-index="${index}">Delete</button>
								</div>
							</div>
						</div>
					`).join('');

					// Add event handlers
					if (isEditMode) {
						setupEditHandlers();
					} else {
						setupClickHandlers();
					}
				}
			}

			function formatTimeForInput(seconds: number): string {
				const hrs = Math.floor(seconds / 3600);
				const mins = Math.floor((seconds % 3600) / 60);
				const secs = Math.floor(seconds % 60);
				const ms = Math.floor((seconds % 1) * 1000);
				return `${hrs.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}.${ms.toString().padStart(3, '0')}`;
			}

			function parseTimeInput(timeStr: string): { seconds: number } | { error: string } {
				return parseTimeString(timeStr);
			}

			function setupClickHandlers() {
				segments.querySelectorAll('.segment').forEach(el => {
					el.addEventListener('click', () => {
						const start = parseFloat(el.getAttribute('data-start') || '0');
						previewVideo.currentTime = start;
						previewVideo.play();
					});
				});
			}

			function setupEditHandlers() {
				// Text editing
				segments.querySelectorAll('.segment-textarea').forEach((textarea: Element) => {
					textarea.addEventListener('input', (e) => {
						const target = e.target as HTMLTextAreaElement;
						const index = parseInt(target.getAttribute('data-index') || '0', 10);
						editedSegments[index].text = target.value;
						markUnsaved();
					});
				});

				// Time inputs
				segments.querySelectorAll('.time-input-start').forEach((input: Element) => {
					input.addEventListener('change', (e) => {
						const target = e.target as HTMLInputElement;
						const index = parseInt(target.getAttribute('data-index') || '0', 10);
						const errorEl = document.getElementById(`time-error-start-${index}`);
						const parsed = parseTimeInput(target.value);

						if ('error' in parsed) {
							target.classList.add('error');
							if (errorEl) {
								errorEl.textContent = parsed.error;
								errorEl.classList.add('visible');
							}
						} else {
							target.classList.remove('error');
							if (errorEl) {
								errorEl.textContent = '';
								errorEl.classList.remove('visible');
							}
							editedSegments[index].start = parsed.seconds;
							markUnsaved();
						}
					});
				});

				segments.querySelectorAll('.time-input-end').forEach((input: Element) => {
					input.addEventListener('change', (e) => {
						const target = e.target as HTMLInputElement;
						const index = parseInt(target.getAttribute('data-index') || '0', 10);
						const errorEl = document.getElementById(`time-error-end-${index}`);
						const parsed = parseTimeInput(target.value);

						if ('error' in parsed) {
							target.classList.add('error');
							if (errorEl) {
								errorEl.textContent = parsed.error;
								errorEl.classList.add('visible');
							}
						} else {
							target.classList.remove('error');
							if (errorEl) {
								errorEl.textContent = '';
								errorEl.classList.remove('visible');
							}
							editedSegments[index].end = parsed.seconds;
							markUnsaved();
						}
					});
				});

				// Delete buttons
				segments.querySelectorAll('.segment-delete-btn').forEach((btn: Element) => {
					btn.addEventListener('click', (e) => {
						e.stopPropagation();
						const index = parseInt(btn.getAttribute('data-index') || '0', 10);
						editedSegments.splice(index, 1);
						// Re-assign IDs
						editedSegments.forEach((seg, i) => seg.id = i);
						markUnsaved();
						renderSegments();
					});
				});
			}

			function markUnsaved() {
				hasUnsavedChanges = true;
				unsavedIndicator.classList.add('visible');
			}

			function clearUnsaved() {
				hasUnsavedChanges = false;
				unsavedIndicator.classList.remove('visible');
			}

			function enterEditMode() {
				isEditMode = true;
				editBtn.classList.add('active');
				editBtn.textContent = 'Editing...';
				editActions.classList.add('visible');
				addSegmentBtn.classList.add('visible');
				fullText.style.display = 'none';
				editedSegments = JSON.parse(JSON.stringify(transcriptionSegments));
				renderSegments();
			}

			function exitEditMode() {
				isEditMode = false;
				editBtn.classList.remove('active');
				editBtn.textContent = 'Edit Subtitles';
				editActions.classList.remove('visible');
				addSegmentBtn.classList.remove('visible');
				fullText.style.display = 'block';
				clearUnsaved();
				renderSegments();
			}

			async function saveSegments() {
				if (!currentUploadId) return;

				saveBtn.disabled = true;
				saveBtn.textContent = 'Saving...';

				try {
					const response = await csrfFetch(`/api/transcribe/${currentUploadId}/segments`, {
						method: 'PUT',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ segments: editedSegments })
					});

					const result = await response.json();

					if (!response.ok) {
						throw new Error(result.error || 'Failed to save');
					}

					// Update the original segments
					transcriptionSegments = JSON.parse(JSON.stringify(editedSegments));
					// Update full text display
					fullText.textContent = editedSegments.map((s) => s.text).join(' ');
					clearUnsaved();
					showStatus('Subtitles saved successfully!', 'success');

					// Exit edit mode after successful save
					exitEditMode();
				} catch (error) {
					showStatus(`Failed to save: ${error instanceof Error ? error.message : error}`, 'error');
				} finally {
					saveBtn.disabled = false;
					saveBtn.textContent = 'Save Changes';
				}
			}

			function addNewSegment() {
				// Get the last segment's end time or 0
				const lastSeg = editedSegments[editedSegments.length - 1];
				const startTime = lastSeg ? lastSeg.end : 0;

				editedSegments.push({
					id: editedSegments.length,
					start: startTime,
					end: startTime + 3, // Default 3 second segment
					text: ''
				});
				markUnsaved();
				renderSegments();

				// Focus the new segment's textarea
				const textareas = segments.querySelectorAll('.segment-textarea');
				const lastTextarea = textareas[textareas.length - 1] as HTMLTextAreaElement;
				if (lastTextarea) {
					lastTextarea.focus();
				}
			}

			// Set up edit mode event handlers
			editBtn.addEventListener('click', () => {
				if (isEditMode) {
					if (hasUnsavedChanges) {
						if (confirm('You have unsaved changes. Discard them?')) {
							exitEditMode();
						}
					} else {
						exitEditMode();
					}
				} else {
					enterEditMode();
				}
			});

			saveBtn.addEventListener('click', saveSegments);

			cancelBtn.addEventListener('click', () => {
				if (hasUnsavedChanges) {
					if (confirm('Discard unsaved changes?')) {
						exitEditMode();
					}
				} else {
					exitEditMode();
				}
			});

			addSegmentBtn.addEventListener('click', addNewSegment);

			function setupSubtitleSync() {
				// Remove existing listener if present to avoid duplicates
				if (subtitleSyncActive) {
					previewVideo.removeEventListener('timeupdate', updateCurrentSubtitle);
				}
				previewVideo.addEventListener('timeupdate', updateCurrentSubtitle);
				subtitleSyncActive = true;
			}

			function updateCurrentSubtitle() {
				const currentTime = previewVideo.currentTime;

				// Find the current segment
				let currentSeg = null;
				let currentIndex = -1;

				for (let i = 0; i < transcriptionSegments.length; i++) {
					const seg = transcriptionSegments[i];
					if (currentTime >= seg.start && currentTime <= seg.end) {
						currentSeg = seg;
						currentIndex = i;
						break;
					}
				}

				// Update the current subtitle display
				if (currentSeg) {
					currentSubtitle.textContent = currentSeg.text.trim();
				} else {
					currentSubtitle.textContent = '';
				}

				// Update active segment highlighting
				segments.querySelectorAll('.segment').forEach((el, idx) => {
					if (idx === currentIndex) {
						el.classList.add('active');
						// Scroll the segment into view if needed
						el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
					} else {
						el.classList.remove('active');
					}
				});
			}

			// Burn subtitles handling
			let isBurning = false;

			async function startBurn() {
				if (!currentUploadId || isBurning) return;

				isBurning = true;
				burnBtn.disabled = true;
				burnBtn.textContent = 'Burning...';
				burnStatus.classList.add('visible');
				burnStatus.classList.remove('complete', 'error');
				burnStatusText.textContent = 'Starting subtitle burn...';
				burnEtaText.textContent = 'Calculating time remaining...';
				burnEtaText.style.display = 'block';
				burnProgressFill.style.width = '0%';
				downloadBurnedBtn.style.display = 'none';

				try {
					const response = await csrfFetch(`/api/videos/${currentUploadId}/burn`, {
						method: 'POST',
					});
					const result = await response.json();

					if (!response.ok) {
						throw new Error(result.error || 'Failed to start burn');
					}

					// Start polling for status
					pollBurnStatus();
				} catch (error) {
					burnStatus.classList.add('error');
					burnStatusText.textContent = `Error: ${error instanceof Error ? error.message : error}`;
					burnBtn.disabled = false;
					burnBtn.textContent = 'Burn Subtitles into Video';
					isBurning = false;
				}
			}

			async function pollBurnStatus() {
				if (!currentUploadId) return;

				// Clear any existing burn poll timeout
				if (burnPollTimeout !== null) {
					clearTimeout(burnPollTimeout);
					burnPollTimeout = null;
				}

				const poll = async () => {
					try {
						// Create a new AbortController for this fetch
						fetchAbortController = new AbortController();
						const response = await fetch(`/api/videos/${currentUploadId}/burn`, {
							signal: fetchAbortController.signal
						});
						const result = await response.json();

						burnStatusText.textContent = result.message || 'Processing...';
						burnProgressFill.style.width = `${result.progress || 0}%`;

						// Display estimated time remaining if available
						if (result.estimated_remaining_seconds !== undefined && result.estimated_remaining_seconds > 0) {
							burnEtaText.textContent = `Estimated time remaining: ${formatDuration(result.estimated_remaining_seconds)}`;
							burnEtaText.style.display = 'block';
						} else if (result.status === 'processing' && result.progress < 20) {
							burnEtaText.textContent = 'Calculating time remaining...';
							burnEtaText.style.display = 'block';
						} else {
							burnEtaText.style.display = 'none';
						}

						if (result.status === 'processing') {
							burnPollTimeout = setTimeout(poll, 2000);
						} else if (result.status === 'complete') {
							burnPollTimeout = null;
							burnStatus.classList.add('complete');
							burnStatusText.textContent = 'Subtitles burned successfully!';
							burnEtaText.style.display = 'none';
							burnProgressFill.style.width = '100%';
							downloadBurnedBtn.href = `/api/videos/${currentUploadId}/burned`;
							downloadBurnedBtn.style.display = 'inline-block';
							burnBtn.disabled = false;
							burnBtn.textContent = 'Burn Again';
							isBurning = false;
						} else if (result.status === 'error') {
							burnPollTimeout = null;
							burnStatus.classList.add('error');
							burnStatusText.textContent = `Error: ${result.message}`;
							burnEtaText.style.display = 'none';
							burnBtn.disabled = false;
							burnBtn.textContent = 'Retry Burn';
							isBurning = false;
						}
					} catch (error) {
						// Ignore abort errors (expected during cleanup)
						if (error instanceof Error && error.name === 'AbortError') {
							return;
						}
						burnPollTimeout = null;
						burnStatus.classList.add('error');
						burnStatusText.textContent = `Polling error: ${error}`;
						burnBtn.disabled = false;
						burnBtn.textContent = 'Retry Burn';
						isBurning = false;
					}
				};

				poll();
			}

			burnBtn.addEventListener('click', startBurn);

			// Auth handling
			const nav = document.getElementById('nav') as HTMLElement;
			const loginLink = document.getElementById('loginLink') as HTMLElement;
			const registerLink = document.getElementById('registerLink') as HTMLElement;
			let isAuthenticated = false;

			async function checkAuth() {
				try {
					const response = await fetch('/api/auth/me');
					if (response.ok) {
						const data = await response.json();
						if (data.user) {
							isAuthenticated = true;
							loginLink.style.display = 'none';
							registerLink.style.display = 'none';

							// Fetch CSRF token for authenticated requests
							await fetchCsrfToken();

							const userSpan = document.createElement('span');
							userSpan.className = 'nav-user';
							userSpan.textContent = data.user.email;
							nav.appendChild(userSpan);

							const logoutBtn = document.createElement('button');
							logoutBtn.className = 'nav-logout';
							logoutBtn.textContent = 'Log out';
							logoutBtn.addEventListener('click', logout);
							nav.appendChild(logoutBtn);
						}
					}
				} catch (err) {
					// Not logged in
				}
			}

			async function logout() {
				try {
					await csrfFetch('/api/auth/logout', { method: 'POST' });
					clearCsrfToken();
					window.location.reload();
				} catch (err) {
					console.error('Logout failed:', err);
				}
			}

			// Re-transcribe with selected language
			async function retranscribe() {
				if (!currentUploadId) return;

				const selectedLanguage = transcriptionLanguageSelect.value;
				if (selectedLanguage === 'auto') {
					// Show warning that re-transcribing with auto is redundant
					if (!confirm('Auto-detect will likely produce the same result. Are you sure you want to re-transcribe?')) {
						return;
					}
				}

				// Disable button during re-transcription
				retranscribeBtn.disabled = true;
				retranscribeBtn.textContent = 'Re-transcribing...';

				// Clear previous transcription display
				transcriptionSegments = [];
				editedSegments = [];
				segments.innerHTML = '';
				fullText.textContent = '';
				currentSubtitle.textContent = '';
				actions.style.display = 'none';
				pasteTranscript.classList.remove('visible');
				detectedLanguage.style.display = 'none';

				try {
					// Start new transcription with selected language
					await startTranscription(currentUploadId, selectedLanguage);
				} finally {
					retranscribeBtn.disabled = false;
					retranscribeBtn.textContent = 'Re-transcribe';
				}
			}

			retranscribeBtn.addEventListener('click', retranscribe);

			// Load existing video if ?id= param is present
			async function loadExistingVideo() {
				const urlParams = new URLSearchParams(window.location.search);
				const videoId = urlParams.get('id');
				if (!videoId) return;

				currentUploadId = videoId;

				try {
					// Load video metadata and transcription
					const response = await fetch(`/api/transcribe/${videoId}`);
					const result = await response.json();

					if (result.status === 'complete' && result.result) {
						// Show video preview
						previewVideo.src = `/api/videos/${videoId}/video`;
						videoPreview.classList.add('visible');

						// Show language section
						languageSection.style.display = 'block';
						retranscribeBtn.style.display = 'inline-block';

						// Display transcription
						transcription.classList.add('visible');
						transcriptionStatus.textContent = 'Transcription complete!';
						displayTranscription(result.result);

						// Hide dropzone since we're viewing an existing video
						dropzone.style.display = 'none';
					} else if (result.status === 'processing' || result.status === 'pending') {
						// Show video preview
						previewVideo.src = `/api/videos/${videoId}/video`;
						videoPreview.classList.add('visible');

						// Show language section
						languageSection.style.display = 'block';

						// Hide dropzone
						dropzone.style.display = 'none';

						// Start polling
						transcription.classList.add('visible');
						pollTranscriptionStatus(videoId);
					} else if (result.status === 'error') {
						// Show video preview
						previewVideo.src = `/api/videos/${videoId}/video`;
						videoPreview.classList.add('visible');
						dropzone.style.display = 'none';

						transcription.classList.add('visible');
						transcriptionStatus.textContent = `Error: ${result.message || 'Transcription failed'}`;
					}
				} catch (err) {
					console.error('Failed to load video:', err);
				}
			}

			checkAuth();
			loadExistingVideo();
		</script>
		<CookieConsent />
	</body>
</html>
