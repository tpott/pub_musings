---
import Nav from '../components/Nav.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Subtitler - Upload Your Video</title>
		<style>
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				min-height: 100vh;
				padding: 20px;
			}

			.page-wrapper {
				max-width: 900px;
				margin: 0 auto;
			}

			.main-content {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: calc(100vh - 120px);
			}

			.container {
				background: white;
				border-radius: 12px;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
				padding: 40px;
				max-width: 600px;
				width: 100%;
			}

			h1 {
				color: #333;
				margin-bottom: 10px;
				font-size: 28px;
			}

			.subtitle {
				color: #666;
				margin-bottom: 30px;
				font-size: 14px;
			}

			.upload-area {
				border: 2px dashed #667eea;
				border-radius: 8px;
				padding: 40px;
				text-align: center;
				background: #f8f9ff;
				transition: all 0.3s ease;
				cursor: pointer;
			}

			.upload-area:hover {
				border-color: #764ba2;
				background: #f0f2ff;
			}

			.upload-area.dragging {
				border-color: #764ba2;
				background: #e8ebff;
			}

			.file-input {
				display: none;
			}

			.upload-icon {
				font-size: 48px;
				margin-bottom: 16px;
			}

			.upload-text {
				color: #333;
				font-size: 16px;
				margin-bottom: 8px;
			}

			.upload-hint {
				color: #666;
				font-size: 12px;
			}

			.file-info {
				margin-top: 20px;
				padding: 16px;
				background: #f0f2ff;
				border-radius: 8px;
				display: none;
			}

			.file-info.visible {
				display: block;
			}

			.file-name {
				font-weight: 600;
				color: #333;
				margin-bottom: 4px;
			}

			.file-size {
				color: #666;
				font-size: 14px;
			}

			.submit-btn {
				width: 100%;
				padding: 14px;
				margin-top: 20px;
				background: #667eea;
				color: white;
				border: none;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.3s ease;
				display: none;
			}

			.submit-btn.visible {
				display: block;
			}

			.submit-btn:hover:not(:disabled) {
				background: #764ba2;
			}

			.submit-btn:disabled {
				background: #ccc;
				cursor: not-allowed;
			}

			.progress-bar {
				width: 100%;
				height: 8px;
				background: #e0e0e0;
				border-radius: 4px;
				margin-top: 20px;
				overflow: hidden;
				display: none;
			}

			.progress-bar.visible {
				display: block;
			}

			.progress-fill {
				height: 100%;
				background: #667eea;
				transition: width 0.3s ease;
				width: 0%;
			}

			.message {
				margin-top: 20px;
				padding: 16px;
				border-radius: 8px;
				display: none;
			}

			.message.visible {
				display: block;
			}

			.message.success {
				background: #d4edda;
				color: #155724;
				border: 1px solid #c3e6cb;
			}

			.message.error {
				background: #f8d7da;
				color: #721c24;
				border: 1px solid #f5c6cb;
			}

			.reset-btn {
				width: 100%;
				padding: 14px;
				margin-top: 12px;
				background: white;
				color: #667eea;
				border: 2px solid #667eea;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.3s ease;
				display: none;
			}

			.reset-btn.visible {
				display: block;
			}

			.reset-btn:hover {
				background: #667eea;
				color: white;
			}
		</style>
	</head>
	<body>
		<div class="page-wrapper">
			<Nav />
			<div class="main-content">
				<div class="container">
					<h1>Subtitler</h1>
			<p class="subtitle">Upload your video or audio file to generate subtitles</p>

			<form id="upload-form">
				<div class="upload-area" id="upload-area">
					<div class="upload-icon">📁</div>
					<div class="upload-text">Click to select or drag and drop your file</div>
					<div class="upload-hint">Supports: MP4, WebM, MP3, WAV, M4A (max 200MB)</div>
					<input type="file" id="file-input" class="file-input" accept=".mp3,.wav,.m4a,.ogg,.flac,.mp4,.webm,.mkv,.avi,.mov" />
				</div>

				<div class="file-info" id="file-info">
					<div class="file-name" id="file-name"></div>
					<div class="file-size" id="file-size"></div>
				</div>

				<button type="submit" class="submit-btn" id="submit-btn">Upload File</button>

				<div class="progress-bar" id="progress-bar">
					<div class="progress-fill" id="progress-fill"></div>
				</div>

				<div class="message" id="message"></div>

				<button type="button" class="reset-btn" id="reset-btn">Upload Another File</button>
			</form>
				</div>
			</div>
		</div>

		<script>
			import { trackPageView, trackEvent } from '../lib/analytics';

			// Track page view on load
			trackPageView();

			const uploadArea = document.getElementById('upload-area');
			const fileInput = document.getElementById('file-input');
			const fileInfo = document.getElementById('file-info');
			const fileName = document.getElementById('file-name');
			const fileSize = document.getElementById('file-size');
			const submitBtn = document.getElementById('submit-btn');
			const progressBar = document.getElementById('progress-bar');
			const progressFill = document.getElementById('progress-fill');
			const message = document.getElementById('message');
			const resetBtn = document.getElementById('reset-btn');
			const uploadForm = document.getElementById('upload-form');

			const MAX_FILE_SIZE = 200 * 1024 * 1024; // 200MB
			let selectedFile = null;

			// Click to upload
			uploadArea.addEventListener('click', () => {
				fileInput.click();
			});

			// Drag and drop handlers
			uploadArea.addEventListener('dragover', (e) => {
				e.preventDefault();
				uploadArea.classList.add('dragging');
			});

			uploadArea.addEventListener('dragleave', () => {
				uploadArea.classList.remove('dragging');
			});

			uploadArea.addEventListener('drop', (e) => {
				e.preventDefault();
				uploadArea.classList.remove('dragging');
				const files = e.dataTransfer.files;
				if (files.length > 0) {
					handleFileSelect(files[0]);
				}
			});

			// File input change
			fileInput.addEventListener('change', (e) => {
				if (e.target.files.length > 0) {
					handleFileSelect(e.target.files[0]);
				}
			});

			function handleFileSelect(file) {
				selectedFile = file;

				// Display file info
				fileName.textContent = file.name;
				fileSize.textContent = formatFileSize(file.size);
				fileInfo.classList.add('visible');
				submitBtn.classList.add('visible');

				// Validate file size
				if (file.size > MAX_FILE_SIZE) {
					showMessage('File size exceeds 200MB limit', 'error');
					submitBtn.disabled = true;
				} else {
					hideMessage();
					submitBtn.disabled = false;
				}
			}

			function formatFileSize(bytes) {
				if (bytes === 0) return '0 Bytes';
				const k = 1024;
				const sizes = ['Bytes', 'KB', 'MB', 'GB'];
				const i = Math.floor(Math.log(bytes) / Math.log(k));
				return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
			}

			function showMessage(text, type) {
				message.textContent = text;
				message.className = `message visible ${type}`;
			}

			function hideMessage() {
				message.classList.remove('visible');
			}

			uploadForm.addEventListener('submit', async (e) => {
				e.preventDefault();

				if (!selectedFile) {
					showMessage('Please select a file first', 'error');
					return;
				}

				// Prepare form data
				const formData = new FormData();
				formData.append('file', selectedFile);

				// Show progress bar
				progressBar.classList.add('visible');
				progressFill.style.width = '0%';
				submitBtn.disabled = true;
				hideMessage();

				try {
					const xhr = new XMLHttpRequest();

					// Track upload progress
					xhr.upload.addEventListener('progress', (e) => {
						if (e.lengthComputable) {
							const percentComplete = (e.loaded / e.total) * 100;
							progressFill.style.width = percentComplete + '%';
						}
					});

					// Handle completion
					xhr.addEventListener('load', () => {
						progressBar.classList.remove('visible');
						submitBtn.disabled = false;

						if (xhr.status === 200) {
							const response = JSON.parse(xhr.responseText);
							showMessage('File uploaded successfully: ' + response.filename, 'success');
							resetBtn.classList.add('visible');
							submitBtn.classList.remove('visible');
						} else {
							const response = JSON.parse(xhr.responseText);
							showMessage('Upload failed: ' + (response.message || 'Unknown error'), 'error');
						}
					});

					// Handle errors
					xhr.addEventListener('error', () => {
						progressBar.classList.remove('visible');
						submitBtn.disabled = false;
						showMessage('Network error. Please check if the server is running.', 'error');
					});

					// Use relative path - proxied through Astro server
					xhr.open('POST', '/api/upload');
					xhr.send(formData);
				} catch (error) {
					progressBar.classList.remove('visible');
					submitBtn.disabled = false;
					showMessage('Error: ' + error.message, 'error');
				}
			});

			resetBtn.addEventListener('click', () => {
				// Reset form
				selectedFile = null;
				fileInput.value = '';
				fileInfo.classList.remove('visible');
				submitBtn.classList.remove('visible');
				submitBtn.classList.add('visible');
				resetBtn.classList.remove('visible');
				hideMessage();
				submitBtn.disabled = false;
			});
		</script>
	</body>
</html>
