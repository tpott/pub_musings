---
import DevConsoleForwarder from '../components/DevConsoleForwarder.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/theme.css';
---

<html lang="en">
	<head>
		<ThemeInit />
		<DevConsoleForwarder />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Subtitler</title>
		<style>
			.nav {
				display: flex;
				justify-content: flex-end;
				padding: 1rem 2rem;
				gap: 1rem;
			}
			.nav-link {
				color: var(--text-color);
				text-decoration: none;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				transition: background-color 0.2s;
			}
			.nav-link:hover {
				background-color: var(--border-color);
			}
			.nav-user {
				color: var(--text-secondary);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
			}
			.nav-logout {
				background: none;
				border: none;
				color: var(--text-color);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.nav-logout:hover {
				background-color: var(--border-color);
			}
			.container {
				max-width: 800px;
				margin: 0 auto;
				padding: 4rem 2rem;
			}
			h1 {
				font-size: 3rem;
				font-weight: 600;
				margin-bottom: 1rem;
			}
			.tagline {
				font-size: 1.25rem;
				color: var(--text-secondary);
				margin-bottom: 3rem;
			}
			.cta {
				display: inline-block;
				background-color: var(--text-color);
				color: white;
				padding: 1rem 2rem;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 500;
				transition: opacity 0.2s;
			}
			.cta:hover {
				opacity: 0.9;
			}
			.buttons {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.cta.secondary {
				background-color: transparent;
				color: var(--text-color);
				border: 2px solid var(--text-color);
			}
			.cta.secondary:hover {
				background-color: var(--text-color);
				color: var(--bg-color);
			}
			/* Mobile responsive styles */
			@media (max-width: 480px) {
				.nav {
					padding: 0.75rem 1rem;
					gap: 0.5rem;
				}
				.nav-link, .nav-logout {
					padding: 0.5rem 0.75rem;
					font-size: 0.85rem;
					min-height: 44px;
					display: flex;
					align-items: center;
				}
				.container {
					padding: 2rem 1rem;
				}
				h1 {
					font-size: 2rem;
				}
				.tagline {
					font-size: 1rem;
				}
				.buttons {
					flex-direction: column;
				}
				.cta {
					width: 100%;
					text-align: center;
					min-height: 44px;
					display: flex;
					align-items: center;
					justify-content: center;
				}
			}
			@media (max-width: 375px) {
				h1 {
					font-size: 1.75rem;
				}
				.container {
					padding: 1.5rem 0.75rem;
				}
			}
		</style>
	</head>
	<body>
		<nav class="nav" id="nav">
			<ThemeToggle />
			<a href="/login" class="nav-link" id="loginLink">Log in</a>
			<a href="/register" class="nav-link" id="registerLink">Sign up</a>
		</nav>
		<div class="container">
			<h1>Subtitler</h1>
			<p class="tagline">Generate accurate subtitles for your videos in seconds.</p>
			<div class="buttons">
				<a href="/upload" class="cta">Upload a Video</a>
				<a href="/videos" class="cta secondary">My Videos</a>
			</div>
		</div>

		<script>
			import { csrfFetch, fetchCsrfToken, clearCsrfToken } from '../utils/csrf';

			const nav = document.getElementById('nav') as HTMLElement;
			const loginLink = document.getElementById('loginLink') as HTMLElement;
			const registerLink = document.getElementById('registerLink') as HTMLElement;

			async function checkAuth() {
				try {
					const response = await fetch('/api/auth/me');
					if (response.ok) {
						const data = await response.json();
						if (data.user) {
							// User is logged in - show logout
							loginLink.style.display = 'none';
							registerLink.style.display = 'none';

							// Fetch CSRF token for authenticated requests
							await fetchCsrfToken();

							const userSpan = document.createElement('span');
							userSpan.className = 'nav-user';
							userSpan.textContent = data.user.email;
							nav.appendChild(userSpan);

							const logoutBtn = document.createElement('button');
							logoutBtn.className = 'nav-logout';
							logoutBtn.textContent = 'Log out';
							logoutBtn.addEventListener('click', logout);
							nav.appendChild(logoutBtn);
						}
					}
				} catch (err) {
					// Not logged in, show login/register links
				}
			}

			async function logout() {
				try {
					await csrfFetch('/api/auth/logout', { method: 'POST' });
					clearCsrfToken();
					window.location.reload();
				} catch (err) {
					console.error('Logout failed:', err);
				}
			}

			checkAuth();
		</script>
		<CookieConsent />
	</body>
</html>
