---
import Nav from '../components/Nav.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Subtitler - Upload Your Video</title>
		<style>
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				min-height: 100vh;
				padding: 20px;
			}

			.page-wrapper {
				max-width: 900px;
				margin: 0 auto;
			}

			.main-content {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: calc(100vh - 120px);
			}

			.container {
				background: white;
				border-radius: 12px;
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
				padding: 40px;
				max-width: 600px;
				width: 100%;
			}

			h1 {
				color: #333;
				margin-bottom: 10px;
				font-size: 28px;
			}

			.subtitle {
				color: #666;
				margin-bottom: 30px;
				font-size: 14px;
			}

			.upload-area {
				border: 2px dashed #667eea;
				border-radius: 8px;
				padding: 40px;
				text-align: center;
				background: #f8f9ff;
				transition: all 0.3s ease;
				cursor: pointer;
			}

			.upload-area:hover {
				border-color: #764ba2;
				background: #f0f2ff;
			}

			.upload-area.dragging {
				border-color: #764ba2;
				background: #e8ebff;
			}

			.file-input {
				display: none;
			}

			.upload-icon {
				font-size: 48px;
				margin-bottom: 16px;
			}

			.upload-text {
				color: #333;
				font-size: 16px;
				margin-bottom: 8px;
			}

			.upload-hint {
				color: #666;
				font-size: 12px;
			}

			.file-info {
				margin-top: 20px;
				padding: 16px;
				background: #f0f2ff;
				border-radius: 8px;
				display: none;
			}

			.file-info.visible {
				display: block;
			}

			.file-name {
				font-weight: 600;
				color: #333;
				margin-bottom: 4px;
			}

			.file-size {
				color: #666;
				font-size: 14px;
			}

			.file-list {
				margin-top: 20px;
				display: none;
			}

			.file-list.visible {
				display: block;
			}

			.file-list-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 12px;
			}

			.file-list-title {
				font-weight: 600;
				color: #333;
				font-size: 14px;
			}

			.file-list-summary {
				color: #666;
				font-size: 12px;
			}

			.file-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 10px 12px;
				background: #f8f9ff;
				border-radius: 6px;
				margin-bottom: 8px;
			}

			.file-item:last-child {
				margin-bottom: 0;
			}

			.file-item-info {
				flex: 1;
				min-width: 0;
			}

			.file-item-name {
				font-weight: 500;
				color: #333;
				font-size: 14px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.file-item-size {
				color: #666;
				font-size: 12px;
			}

			.file-item-remove {
				background: none;
				border: none;
				color: #dc3545;
				cursor: pointer;
				padding: 4px 8px;
				font-size: 18px;
				line-height: 1;
				opacity: 0.7;
				transition: opacity 0.2s;
			}

			.file-item-remove:hover {
				opacity: 1;
			}

			.file-item-error {
				background: #fff5f5;
				border: 1px solid #f5c6cb;
			}

			.file-item-error .file-item-name {
				color: #721c24;
			}

			.file-item-error-msg {
				color: #721c24;
				font-size: 11px;
				margin-top: 2px;
			}

			.submit-btn {
				width: 100%;
				padding: 14px;
				margin-top: 20px;
				background: #667eea;
				color: white;
				border: none;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.3s ease;
				display: none;
			}

			.submit-btn.visible {
				display: block;
			}

			.submit-btn:hover:not(:disabled) {
				background: #764ba2;
			}

			.submit-btn:disabled {
				background: #ccc;
				cursor: not-allowed;
			}

			.progress-bar {
				width: 100%;
				height: 8px;
				background: #e0e0e0;
				border-radius: 4px;
				margin-top: 20px;
				overflow: hidden;
				display: none;
			}

			.progress-bar.visible {
				display: block;
			}

			.progress-fill {
				height: 100%;
				background: #667eea;
				transition: width 0.3s ease;
				width: 0%;
			}

			.message {
				margin-top: 20px;
				padding: 16px;
				border-radius: 8px;
				display: none;
			}

			.message.visible {
				display: block;
			}

			.message.success {
				background: #d4edda;
				color: #155724;
				border: 1px solid #c3e6cb;
			}

			.message.error {
				background: #f8d7da;
				color: #721c24;
				border: 1px solid #f5c6cb;
			}

			.reset-btn {
				width: 100%;
				padding: 14px;
				margin-top: 12px;
				background: white;
				color: #667eea;
				border: 2px solid #667eea;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.3s ease;
				display: none;
			}

			.reset-btn.visible {
				display: block;
			}

			.reset-btn:hover {
				background: #667eea;
				color: white;
			}

			.options-section {
				margin-top: 20px;
				display: none;
			}

			.options-section.visible {
				display: block;
			}

			.options-section label {
				display: block;
				color: #333;
				font-weight: 600;
				margin-bottom: 8px;
				font-size: 14px;
			}

			.options-section select {
				width: 100%;
				padding: 12px;
				border: 1px solid #ddd;
				border-radius: 8px;
				font-size: 14px;
				background: white;
				color: #333;
				cursor: pointer;
				transition: border-color 0.3s ease;
			}

			.options-section select:hover {
				border-color: #667eea;
			}

			.options-section select:focus {
				outline: none;
				border-color: #667eea;
				box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.2);
			}

			.options-hint {
				color: #666;
				font-size: 12px;
				margin-top: 6px;
			}
		</style>
	</head>
	<body>
		<div class="page-wrapper">
			<Nav />
			<div class="main-content">
				<div class="container">
					<h1>Subtitler</h1>
			<p class="subtitle">Upload your video or audio file to generate subtitles</p>

			<form id="upload-form">
				<div class="upload-area" id="upload-area">
					<div class="upload-icon">📁</div>
					<div class="upload-text">Click to select or drag and drop your files</div>
					<div class="upload-hint">Supports: MP4, WebM, MP3, WAV, M4A (max 200MB each, up to 10 files)</div>
					<input type="file" id="file-input" class="file-input" accept=".mp3,.wav,.m4a,.ogg,.flac,.mp4,.webm,.mkv,.avi,.mov" multiple />
				</div>

				<div class="file-list" id="file-list">
					<div class="file-list-header">
						<span class="file-list-title">Selected Files</span>
						<span class="file-list-summary" id="file-list-summary"></span>
					</div>
					<div id="file-list-items"></div>
				</div>

				<div class="options-section" id="options-section">
					<label for="language-select">Language (optional)</label>
					<select id="language-select">
						<option value="">Auto-detect</option>
						<optgroup label="Common Languages">
							<option value="en">English</option>
							<option value="es">Spanish</option>
							<option value="fr">French</option>
							<option value="de">German</option>
							<option value="it">Italian</option>
							<option value="pt">Portuguese</option>
							<option value="zh">Chinese</option>
							<option value="ja">Japanese</option>
							<option value="ko">Korean</option>
							<option value="ru">Russian</option>
							<option value="ar">Arabic</option>
							<option value="hi">Hindi</option>
						</optgroup>
						<optgroup label="European Languages">
							<option value="nl">Dutch</option>
							<option value="pl">Polish</option>
							<option value="sv">Swedish</option>
							<option value="da">Danish</option>
							<option value="no">Norwegian</option>
							<option value="fi">Finnish</option>
							<option value="el">Greek</option>
							<option value="cs">Czech</option>
							<option value="ro">Romanian</option>
							<option value="hu">Hungarian</option>
							<option value="uk">Ukrainian</option>
							<option value="tr">Turkish</option>
							<option value="ca">Catalan</option>
							<option value="hr">Croatian</option>
							<option value="sk">Slovak</option>
							<option value="bg">Bulgarian</option>
							<option value="sr">Serbian</option>
							<option value="lt">Lithuanian</option>
							<option value="lv">Latvian</option>
							<option value="et">Estonian</option>
							<option value="sl">Slovenian</option>
							<option value="is">Icelandic</option>
						</optgroup>
						<optgroup label="Asian Languages">
							<option value="th">Thai</option>
							<option value="vi">Vietnamese</option>
							<option value="id">Indonesian</option>
							<option value="ms">Malay</option>
							<option value="tl">Tagalog</option>
							<option value="ta">Tamil</option>
							<option value="te">Telugu</option>
							<option value="bn">Bengali</option>
							<option value="ur">Urdu</option>
							<option value="fa">Persian</option>
							<option value="he">Hebrew</option>
						</optgroup>
						<optgroup label="Other Languages">
							<option value="af">Afrikaans</option>
							<option value="sw">Swahili</option>
							<option value="cy">Welsh</option>
							<option value="gl">Galician</option>
							<option value="eu">Basque</option>
							<option value="la">Latin</option>
						</optgroup>
					</select>
					<div class="options-hint">Select a language for better accuracy, or leave as auto-detect</div>
				</div>

				<button type="submit" class="submit-btn" id="submit-btn">Upload Files</button>

				<div class="progress-bar" id="progress-bar">
					<div class="progress-fill" id="progress-fill"></div>
				</div>

				<div class="message" id="message"></div>

				<button type="button" class="reset-btn" id="reset-btn">Upload More Files</button>
			</form>
				</div>
			</div>
		</div>

		<script>
			import { trackPageView, trackEvent } from '../lib/analytics';

			// Track page view on load
			trackPageView();

			const uploadArea = document.getElementById('upload-area');
			const fileInput = document.getElementById('file-input');
			const fileList = document.getElementById('file-list');
			const fileListItems = document.getElementById('file-list-items');
			const fileListSummary = document.getElementById('file-list-summary');
			const submitBtn = document.getElementById('submit-btn');
			const progressBar = document.getElementById('progress-bar');
			const progressFill = document.getElementById('progress-fill');
			const message = document.getElementById('message');
			const resetBtn = document.getElementById('reset-btn');
			const uploadForm = document.getElementById('upload-form');
			const optionsSection = document.getElementById('options-section');
			const languageSelect = document.getElementById('language-select');

			const MAX_FILE_SIZE = 200 * 1024 * 1024; // 200MB
			const MAX_FILES = 10;
			let selectedFiles = []; // Array of {file, valid, error} objects

			// Click to upload
			uploadArea.addEventListener('click', () => {
				fileInput.click();
			});

			// Drag and drop handlers
			uploadArea.addEventListener('dragover', (e) => {
				e.preventDefault();
				uploadArea.classList.add('dragging');
			});

			uploadArea.addEventListener('dragleave', () => {
				uploadArea.classList.remove('dragging');
			});

			uploadArea.addEventListener('drop', (e) => {
				e.preventDefault();
				uploadArea.classList.remove('dragging');
				const files = Array.from(e.dataTransfer.files);
				handleFilesSelect(files);
			});

			// File input change
			fileInput.addEventListener('change', (e) => {
				const files = Array.from(e.target.files);
				handleFilesSelect(files);
			});

			function handleFilesSelect(files) {
				// Add new files to selection (avoid duplicates by name)
				const existingNames = new Set(selectedFiles.map(f => f.file.name));

				for (const file of files) {
					if (existingNames.has(file.name)) continue; // Skip duplicates
					if (selectedFiles.length >= MAX_FILES) {
						showMessage(`Maximum ${MAX_FILES} files allowed`, 'error');
						break;
					}

					const valid = file.size <= MAX_FILE_SIZE;
					const error = valid ? null : 'File exceeds 200MB limit';
					selectedFiles.push({ file, valid, error });
					existingNames.add(file.name);
				}

				updateFileListDisplay();
			}

			function removeFile(index) {
				selectedFiles.splice(index, 1);
				updateFileListDisplay();
			}

			function updateFileListDisplay() {
				if (selectedFiles.length === 0) {
					fileList.classList.remove('visible');
					optionsSection.classList.remove('visible');
					submitBtn.classList.remove('visible');
					hideMessage();
					return;
				}

				// Show file list and options
				fileList.classList.add('visible');
				optionsSection.classList.add('visible');
				submitBtn.classList.add('visible');

				// Calculate totals
				const totalSize = selectedFiles.reduce((sum, f) => sum + f.file.size, 0);
				const validCount = selectedFiles.filter(f => f.valid).length;

				// Update summary
				fileListSummary.textContent = `${selectedFiles.length} file${selectedFiles.length > 1 ? 's' : ''} (${formatFileSize(totalSize)})`;

				// Render file items
				fileListItems.innerHTML = selectedFiles.map((item, index) => `
					<div class="file-item ${item.valid ? '' : 'file-item-error'}">
						<div class="file-item-info">
							<div class="file-item-name">${escapeHtml(item.file.name)}</div>
							<div class="file-item-size">${formatFileSize(item.file.size)}</div>
							${item.error ? `<div class="file-item-error-msg">${escapeHtml(item.error)}</div>` : ''}
						</div>
						<button type="button" class="file-item-remove" data-index="${index}" title="Remove file">&times;</button>
					</div>
				`).join('');

				// Add event listeners for remove buttons
				fileListItems.querySelectorAll('.file-item-remove').forEach(btn => {
					btn.addEventListener('click', (e) => {
						const index = parseInt(e.target.dataset.index);
						removeFile(index);
					});
				});

				// Update submit button state
				submitBtn.disabled = validCount === 0;
				if (validCount === 0 && selectedFiles.length > 0) {
					showMessage('No valid files to upload', 'error');
				} else {
					hideMessage();
				}

				// Update button text based on count
				submitBtn.textContent = validCount === 1 ? 'Upload File' : `Upload ${validCount} Files`;
			}

			function escapeHtml(text) {
				const div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			function formatFileSize(bytes) {
				if (bytes === 0) return '0 Bytes';
				const k = 1024;
				const sizes = ['Bytes', 'KB', 'MB', 'GB'];
				const i = Math.floor(Math.log(bytes) / Math.log(k));
				return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
			}

			function showMessage(text, type) {
				message.textContent = text;
				message.className = `message visible ${type}`;
			}

			function hideMessage() {
				message.classList.remove('visible');
			}

			uploadForm.addEventListener('submit', async (e) => {
				e.preventDefault();

				const validFiles = selectedFiles.filter(f => f.valid);
				if (validFiles.length === 0) {
					showMessage('Please select valid files first', 'error');
					return;
				}

				// Prepare form data with all valid files
				const formData = new FormData();
				validFiles.forEach(item => {
					formData.append('file', item.file);
				});

				// Add language if selected
				const selectedLanguage = languageSelect.value;
				if (selectedLanguage) {
					formData.append('language', selectedLanguage);
				}

				// Show progress bar
				progressBar.classList.add('visible');
				progressFill.style.width = '0%';
				submitBtn.disabled = true;
				hideMessage();

				try {
					const xhr = new XMLHttpRequest();

					// Track upload progress
					xhr.upload.addEventListener('progress', (e) => {
						if (e.lengthComputable) {
							const percentComplete = (e.loaded / e.total) * 100;
							progressFill.style.width = percentComplete + '%';
						}
					});

					// Handle completion
					xhr.addEventListener('load', () => {
						progressBar.classList.remove('visible');

						try {
							const response = JSON.parse(xhr.responseText);

							if (xhr.status === 201 && response.success) {
								// Success - show message and redirect to dashboard
								let msg = response.message;
								if (response.failed_files && response.failed_files.length > 0) {
									msg += '. Failed: ' + response.failed_files.map(f => f.filename).join(', ');
								}
								showMessage(msg, 'success');
								resetBtn.classList.add('visible');
								submitBtn.classList.remove('visible');

								// Redirect to dashboard after a brief delay
								setTimeout(() => {
									window.location.href = '/dashboard';
								}, 1500);
							} else {
								// Error
								let errorMsg = response.message || 'Unknown error';
								if (response.failed_files && response.failed_files.length > 0) {
									errorMsg += ': ' + response.failed_files.map(f => `${f.filename} (${f.error})`).join(', ');
								}
								showMessage('Upload failed: ' + errorMsg, 'error');
								submitBtn.disabled = false;
							}
						} catch (parseErr) {
							showMessage('Upload failed: Invalid server response', 'error');
							submitBtn.disabled = false;
						}
					});

					// Handle errors
					xhr.addEventListener('error', () => {
						progressBar.classList.remove('visible');
						submitBtn.disabled = false;
						showMessage('Network error. Please check if the server is running.', 'error');
					});

					// Use relative path - proxied through Astro server
					xhr.open('POST', '/api/upload');
					xhr.send(formData);
				} catch (error) {
					progressBar.classList.remove('visible');
					submitBtn.disabled = false;
					showMessage('Error: ' + error.message, 'error');
				}
			});

			resetBtn.addEventListener('click', () => {
				// Reset form
				selectedFiles = [];
				fileInput.value = '';
				fileList.classList.remove('visible');
				optionsSection.classList.remove('visible');
				languageSelect.value = '';
				submitBtn.classList.remove('visible');
				submitBtn.classList.add('visible');
				submitBtn.textContent = 'Upload Files';
				resetBtn.classList.remove('visible');
				hideMessage();
				submitBtn.disabled = false;
			});
		</script>
	</body>
</html>
