---
import DevConsoleForwarder from '../components/DevConsoleForwarder.astro';
---

<html lang="en">
	<head>
		<DevConsoleForwarder />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Security Settings - Subtitler</title>
		<style>
			:root {
				--bg-color: #fafafa;
				--text-color: #1a1a1a;
				--accent-color: #0066cc;
				--secondary-bg: #ffffff;
				--border-color: #e5e5e5;
				--error-color: #c53030;
				--error-bg: #fff5f5;
				--success-color: #276749;
				--success-bg: #c6f6d5;
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			body {
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background-color: var(--bg-color);
				color: var(--text-color);
				line-height: 1.6;
				min-height: 100vh;
			}
			.container {
				max-width: 600px;
				margin: 0 auto;
				padding: 2rem;
			}
			.header {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 2rem;
			}
			.back-link {
				text-decoration: none;
				color: var(--text-color);
				font-size: 1.5rem;
			}
			h1 {
				font-size: 2rem;
				font-weight: 600;
			}
			.nav {
				display: flex;
				justify-content: flex-end;
				padding: 1rem 2rem;
				gap: 1rem;
			}
			.nav-link {
				color: var(--text-color);
				text-decoration: none;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				transition: background-color 0.2s;
			}
			.nav-link:hover {
				background-color: var(--border-color);
			}
			.nav-user {
				color: #666;
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
			}
			.nav-logout {
				background: none;
				border: none;
				color: var(--text-color);
				font-size: 0.9rem;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				cursor: pointer;
				transition: background-color 0.2s;
			}
			.nav-logout:hover {
				background-color: var(--border-color);
			}
			.card {
				background-color: var(--secondary-bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1.5rem;
				margin-bottom: 1.5rem;
			}
			.card-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1rem;
			}
			.card-title {
				font-size: 1.25rem;
				font-weight: 600;
			}
			.status-badge {
				display: inline-block;
				padding: 0.25rem 0.75rem;
				border-radius: 4px;
				font-size: 0.8rem;
				font-weight: 500;
			}
			.status-enabled {
				background-color: var(--success-bg);
				color: var(--success-color);
			}
			.status-disabled {
				background-color: #e2e8f0;
				color: #64748b;
			}
			.card-description {
				color: #666;
				font-size: 0.95rem;
				margin-bottom: 1rem;
			}
			.btn {
				padding: 0.75rem 1.25rem;
				border: none;
				border-radius: 6px;
				font-size: 0.95rem;
				font-weight: 500;
				cursor: pointer;
				transition: background-color 0.2s, opacity 0.2s;
			}
			.btn-primary {
				background-color: var(--accent-color);
				color: white;
			}
			.btn-primary:hover:not(:disabled) {
				background-color: #0052a3;
			}
			.btn-danger {
				background-color: var(--error-color);
				color: white;
			}
			.btn-danger:hover:not(:disabled) {
				background-color: #9b2c2c;
			}
			.btn:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
			.loading {
				text-align: center;
				padding: 3rem;
				color: #666;
			}
			.error-message {
				background-color: var(--error-bg);
				border: 1px solid #feb2b2;
				color: var(--error-color);
				padding: 0.75rem 1rem;
				border-radius: 6px;
				margin-bottom: 1rem;
				font-size: 0.9rem;
			}
			.success-message {
				background-color: var(--success-bg);
				border: 1px solid #9ae6b4;
				color: var(--success-color);
				padding: 0.75rem 1rem;
				border-radius: 6px;
				margin-bottom: 1rem;
				font-size: 0.9rem;
			}
			.hidden {
				display: none !important;
			}
			.setup-section {
				margin-top: 1.5rem;
			}
			.qr-container {
				text-align: center;
				margin: 1.5rem 0;
			}
			.qr-placeholder {
				background-color: var(--bg-color);
				border: 1px solid var(--border-color);
				border-radius: 8px;
				padding: 1rem;
				display: inline-block;
			}
			.secret-display {
				font-family: 'Menlo', 'Monaco', monospace;
				font-size: 1.1rem;
				letter-spacing: 0.1rem;
				background-color: var(--bg-color);
				padding: 0.75rem 1rem;
				border-radius: 6px;
				text-align: center;
				margin: 1rem 0;
				user-select: all;
			}
			.form-group {
				margin-bottom: 1.25rem;
			}
			label {
				display: block;
				font-weight: 500;
				margin-bottom: 0.5rem;
				font-size: 0.9rem;
			}
			input[type="text"],
			input[type="password"] {
				width: 100%;
				padding: 0.75rem 1rem;
				border: 1px solid var(--border-color);
				border-radius: 6px;
				font-size: 1rem;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			input:focus {
				outline: none;
				border-color: var(--accent-color);
				box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
			}
			input.input-error {
				border-color: var(--error-color);
			}
			input.input-error:focus {
				box-shadow: 0 0 0 3px rgba(197, 48, 48, 0.1);
			}
			.field-error {
				color: var(--error-color);
				font-size: 0.8rem;
				margin-top: 0.25rem;
				display: none;
			}
			.totp-input {
				font-family: 'Menlo', 'Monaco', monospace;
				font-size: 1.5rem;
				letter-spacing: 0.3rem;
				text-align: center;
			}
			.setup-instructions {
				font-size: 0.9rem;
				color: #666;
				margin-bottom: 1rem;
			}
			.setup-instructions ol {
				margin-left: 1.5rem;
			}
			.setup-instructions li {
				margin-bottom: 0.5rem;
			}
			.qr-code {
				width: 200px;
				height: 200px;
			}
			.btn-group {
				display: flex;
				gap: 0.75rem;
				margin-top: 1rem;
			}
			.btn-secondary {
				background-color: var(--bg-color);
				color: var(--text-color);
				border: 1px solid var(--border-color);
			}
			.btn-secondary:hover:not(:disabled) {
				background-color: #f0f0f0;
			}
			.recovery-codes-section {
				margin-top: 1.5rem;
			}
			.recovery-warning {
				background-color: #fef3c7;
				border: 1px solid #f59e0b;
				color: #92400e;
				padding: 0.75rem 1rem;
				border-radius: 6px;
				margin-bottom: 1rem;
				font-size: 0.9rem;
			}
			.recovery-warning strong {
				display: block;
				margin-bottom: 0.25rem;
			}
			.recovery-codes-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.5rem;
				margin: 1rem 0;
			}
			.recovery-code {
				font-family: 'Menlo', 'Monaco', monospace;
				font-size: 1.1rem;
				background-color: var(--bg-color);
				padding: 0.5rem 0.75rem;
				border-radius: 4px;
				text-align: center;
				user-select: all;
			}
			.recovery-actions {
				display: flex;
				gap: 0.5rem;
				margin-top: 1rem;
			}
			.confirmation-checkbox {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-top: 1.5rem;
				padding: 0.75rem 1rem;
				background-color: var(--bg-color);
				border-radius: 6px;
			}
			.confirmation-checkbox input[type="checkbox"] {
				width: 18px;
				height: 18px;
				cursor: pointer;
			}
			.confirmation-checkbox label {
				margin-bottom: 0;
				cursor: pointer;
				font-size: 0.95rem;
			}
			/* Sessions management */
			.session-list {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}
			.session-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.75rem;
				background-color: var(--bg-color);
				border-radius: 6px;
			}
			.session-item.current {
				border: 2px solid var(--accent-color);
				background-color: rgba(0, 102, 204, 0.05);
			}
			.session-info {
				flex: 1;
			}
			.session-device {
				font-weight: 500;
				font-size: 0.95rem;
				margin-bottom: 0.25rem;
			}
			.session-meta {
				font-size: 0.8rem;
				color: #666;
			}
			.session-current-badge {
				display: inline-block;
				background-color: var(--accent-color);
				color: white;
				padding: 0.125rem 0.5rem;
				border-radius: 3px;
				font-size: 0.7rem;
				margin-left: 0.5rem;
				font-weight: 500;
			}
			.btn-revoke {
				padding: 0.375rem 0.75rem;
				font-size: 0.8rem;
				background-color: var(--error-bg);
				color: var(--error-color);
				border: 1px solid #feb2b2;
			}
			.btn-revoke:hover:not(:disabled) {
				background-color: #fecaca;
			}
			.no-sessions {
				color: #666;
				font-size: 0.9rem;
				text-align: center;
				padding: 1rem;
			}
		</style>
	</head>
	<body>
		<nav class="nav" id="nav">
			<a href="/login" class="nav-link" id="loginLink">Log in</a>
			<a href="/register" class="nav-link" id="registerLink">Sign up</a>
		</nav>
		<div class="container">
			<div class="header">
				<a href="/videos" class="back-link">&larr;</a>
				<h1>Security Settings</h1>
			</div>

			<div id="loading" class="loading">Loading...</div>
			<div id="notLoggedIn" class="card hidden">
				<p>Please <a href="/login">log in</a> to manage your security settings.</p>
			</div>

			<div id="content" class="hidden">
				<div id="errorMessage" class="error-message hidden"></div>
				<div id="successMessage" class="success-message hidden"></div>

				<div class="card">
					<div class="card-header">
						<h2 class="card-title">Two-Factor Authentication</h2>
						<span id="totpStatus" class="status-badge status-disabled">Disabled</span>
					</div>
					<p class="card-description">
						Add an extra layer of security to your account by requiring a verification code from your authenticator app when signing in.
					</p>

					<div id="enableSection">
						<button id="startSetupBtn" class="btn btn-primary">Enable 2FA</button>
					</div>

					<div id="setupSection" class="setup-section hidden">
						<div class="setup-instructions">
							<p><strong>Set up your authenticator app:</strong></p>
							<ol>
								<li>Download an authenticator app like Google Authenticator, Authy, or 1Password</li>
								<li>Scan the QR code below or manually enter the secret key</li>
								<li>Enter the 6-digit code from your app to verify</li>
							</ol>
						</div>

						<div class="qr-container">
							<div class="qr-placeholder">
								<img id="qrCode" class="qr-code" alt="QR Code for 2FA setup" />
							</div>
						</div>

						<p style="text-align: center; font-size: 0.9rem; color: #666;">Or enter this secret manually:</p>
						<div id="secretDisplay" class="secret-display">Loading...</div>

						<form id="verifyForm">
							<div class="form-group">
								<label for="verifyCode">Verification Code</label>
								<input type="text" id="verifyCode" class="totp-input" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" placeholder="000000" required />
								<div id="verifyCodeError" class="field-error"></div>
							</div>
							<div class="btn-group">
								<button type="submit" class="btn btn-primary" id="verifyBtn">Verify & Enable</button>
								<button type="button" class="btn btn-secondary" id="cancelSetupBtn">Cancel</button>
							</div>
						</form>
					</div>

					<div id="recoveryCodesSection" class="recovery-codes-section hidden">
						<div class="recovery-warning">
							<strong>Save your recovery codes!</strong>
							These codes can be used to access your account if you lose your authenticator device. Each code can only be used once. Store them in a safe place.
						</div>
						<div id="recoveryCodesGrid" class="recovery-codes-grid"></div>
						<div class="recovery-actions">
							<button type="button" class="btn btn-secondary" id="copyCodesBtn">Copy All Codes</button>
						</div>
						<div class="confirmation-checkbox">
							<input type="checkbox" id="savedCodesCheckbox" />
							<label for="savedCodesCheckbox">I have saved my recovery codes in a safe place</label>
						</div>
						<div class="btn-group" style="margin-top: 1rem;">
							<button type="button" class="btn btn-primary" id="continueBtn" disabled>Continue</button>
						</div>
					</div>

					<div id="disableSection" class="hidden">
						<div id="managementOptions">
							<div style="margin-bottom: 1.5rem;">
								<h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Recovery Codes</h3>
								<p class="card-description" style="margin-top: 0;">
									Recovery codes can be used to access your account if you lose your authenticator device.
								</p>
								<button type="button" class="btn btn-secondary" id="startRegenBtn">Regenerate Recovery Codes</button>
							</div>

							<div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
								<h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Disable 2FA</h3>
								<p class="card-description" style="margin-top: 0;">
									Remove two-factor authentication from your account.
								</p>
								<button type="button" class="btn btn-danger" id="startDisableBtn">Disable 2FA</button>
							</div>
						</div>

						<div id="regenSection" class="hidden">
							<p class="card-description" style="margin-top: 0;">
								To regenerate recovery codes, enter your current password and a code from your authenticator app.
							</p>
							<form id="regenForm">
								<div class="form-group">
									<label for="regenPassword">Password</label>
									<input type="password" id="regenPassword" autocomplete="current-password" required />
									<div id="regenPasswordError" class="field-error"></div>
								</div>
								<div class="form-group">
									<label for="regenCode">Authentication Code</label>
									<input type="text" id="regenCode" class="totp-input" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" placeholder="000000" required />
									<div id="regenCodeError" class="field-error"></div>
								</div>
								<div class="btn-group">
									<button type="submit" class="btn btn-primary" id="regenBtn">Regenerate Codes</button>
									<button type="button" class="btn btn-secondary" id="cancelRegenBtn">Cancel</button>
								</div>
							</form>
						</div>

						<div id="disableFormSection" class="hidden">
							<p class="card-description" style="margin-top: 0;">
								To disable 2FA, enter your current password and a code from your authenticator app.
							</p>
							<form id="disableForm">
								<div class="form-group">
									<label for="disablePassword">Password</label>
									<input type="password" id="disablePassword" autocomplete="current-password" required />
									<div id="disablePasswordError" class="field-error"></div>
								</div>
								<div class="form-group">
									<label for="disableCode">Authentication Code</label>
									<input type="text" id="disableCode" class="totp-input" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" placeholder="000000" required />
									<div id="disableCodeError" class="field-error"></div>
								</div>
								<div class="btn-group">
									<button type="submit" class="btn btn-danger" id="disableBtn">Disable 2FA</button>
									<button type="button" class="btn btn-secondary" id="cancelDisableBtn">Cancel</button>
								</div>
							</form>
						</div>
					</div>
				</div>

				<div class="card">
					<div class="card-header">
						<h2 class="card-title">Active Sessions</h2>
					</div>
					<p class="card-description">
						Manage your active login sessions. You can revoke access from other devices if you notice suspicious activity.
					</p>
					<div id="sessionsLoading" class="loading" style="padding: 1rem;">Loading sessions...</div>
					<div id="sessionsList" class="session-list hidden"></div>
				</div>
			</div>
		</div>

		<script>
			import { validatePassword, validateTotpCode } from '../utils/validation';

			const loading = document.getElementById('loading') as HTMLElement;
			const notLoggedIn = document.getElementById('notLoggedIn') as HTMLElement;
			const content = document.getElementById('content') as HTMLElement;
			const totpStatus = document.getElementById('totpStatus') as HTMLElement;
			const enableSection = document.getElementById('enableSection') as HTMLElement;
			const setupSection = document.getElementById('setupSection') as HTMLElement;
			const disableSection = document.getElementById('disableSection') as HTMLElement;
			const errorMessage = document.getElementById('errorMessage') as HTMLElement;
			const successMessage = document.getElementById('successMessage') as HTMLElement;
			const startSetupBtn = document.getElementById('startSetupBtn') as HTMLButtonElement;
			const cancelSetupBtn = document.getElementById('cancelSetupBtn') as HTMLButtonElement;
			const verifyForm = document.getElementById('verifyForm') as HTMLFormElement;
			const verifyBtn = document.getElementById('verifyBtn') as HTMLButtonElement;
			const verifyCode = document.getElementById('verifyCode') as HTMLInputElement;
			const verifyCodeError = document.getElementById('verifyCodeError') as HTMLElement;
			const disableForm = document.getElementById('disableForm') as HTMLFormElement;
			const disableBtn = document.getElementById('disableBtn') as HTMLButtonElement;
			const disablePassword = document.getElementById('disablePassword') as HTMLInputElement;
			const disablePasswordError = document.getElementById('disablePasswordError') as HTMLElement;
			const disableCode = document.getElementById('disableCode') as HTMLInputElement;
			const disableCodeError = document.getElementById('disableCodeError') as HTMLElement;
			const qrCode = document.getElementById('qrCode') as HTMLImageElement;
			const secretDisplay = document.getElementById('secretDisplay') as HTMLElement;
			const nav = document.getElementById('nav') as HTMLElement;
			const loginLink = document.getElementById('loginLink') as HTMLElement;
			const registerLink = document.getElementById('registerLink') as HTMLElement;
			const recoveryCodesSection = document.getElementById('recoveryCodesSection') as HTMLElement;
			const recoveryCodesGrid = document.getElementById('recoveryCodesGrid') as HTMLElement;
			const copyCodesBtn = document.getElementById('copyCodesBtn') as HTMLButtonElement;
			const savedCodesCheckbox = document.getElementById('savedCodesCheckbox') as HTMLInputElement;
			const continueBtn = document.getElementById('continueBtn') as HTMLButtonElement;

			// New elements for regenerate/disable flow
			const managementOptions = document.getElementById('managementOptions') as HTMLElement;
			const regenSection = document.getElementById('regenSection') as HTMLElement;
			const disableFormSection = document.getElementById('disableFormSection') as HTMLElement;
			const startRegenBtn = document.getElementById('startRegenBtn') as HTMLButtonElement;
			const startDisableBtn = document.getElementById('startDisableBtn') as HTMLButtonElement;
			const cancelRegenBtn = document.getElementById('cancelRegenBtn') as HTMLButtonElement;
			const cancelDisableBtn = document.getElementById('cancelDisableBtn') as HTMLButtonElement;
			const regenForm = document.getElementById('regenForm') as HTMLFormElement;
			const regenBtn = document.getElementById('regenBtn') as HTMLButtonElement;
			const regenPassword = document.getElementById('regenPassword') as HTMLInputElement;
			const regenPasswordError = document.getElementById('regenPasswordError') as HTMLElement;
			const regenCode = document.getElementById('regenCode') as HTMLInputElement;
			const regenCodeError = document.getElementById('regenCodeError') as HTMLElement;

			let isRegenerating = false;

			let currentUser: { id: string; email: string; totp_enabled: boolean } | null = null;
			let setupSecret: string = '';
			let recoveryCodes: string[] = [];

			function clearFieldError(input: HTMLInputElement, errorEl: HTMLElement) {
				input.classList.remove('input-error');
				errorEl.style.display = 'none';
				errorEl.textContent = '';
			}

			function showFieldError(input: HTMLInputElement, errorEl: HTMLElement, message: string) {
				input.classList.add('input-error');
				errorEl.textContent = message;
				errorEl.style.display = 'block';
			}

			// Add blur validation for verify code
			verifyCode.addEventListener('blur', () => {
				const error = validateTotpCode(verifyCode.value);
				if (error) {
					showFieldError(verifyCode, verifyCodeError, error);
				} else {
					clearFieldError(verifyCode, verifyCodeError);
				}
			});
			verifyCode.addEventListener('input', () => clearFieldError(verifyCode, verifyCodeError));

			// Add blur validation for disable form
			disablePassword.addEventListener('blur', () => {
				const error = validatePassword(disablePassword.value);
				if (error) {
					showFieldError(disablePassword, disablePasswordError, error);
				} else {
					clearFieldError(disablePassword, disablePasswordError);
				}
			});
			disablePassword.addEventListener('input', () => clearFieldError(disablePassword, disablePasswordError));

			disableCode.addEventListener('blur', () => {
				const error = validateTotpCode(disableCode.value);
				if (error) {
					showFieldError(disableCode, disableCodeError, error);
				} else {
					clearFieldError(disableCode, disableCodeError);
				}
			});
			disableCode.addEventListener('input', () => clearFieldError(disableCode, disableCodeError));

			// Add blur validation for regen form
			regenPassword.addEventListener('blur', () => {
				const error = validatePassword(regenPassword.value);
				if (error) {
					showFieldError(regenPassword, regenPasswordError, error);
				} else {
					clearFieldError(regenPassword, regenPasswordError);
				}
			});
			regenPassword.addEventListener('input', () => clearFieldError(regenPassword, regenPasswordError));

			regenCode.addEventListener('blur', () => {
				const error = validateTotpCode(regenCode.value);
				if (error) {
					showFieldError(regenCode, regenCodeError, error);
				} else {
					clearFieldError(regenCode, regenCodeError);
				}
			});
			regenCode.addEventListener('input', () => clearFieldError(regenCode, regenCodeError));

			function showError(message: string) {
				errorMessage.textContent = message;
				errorMessage.classList.remove('hidden');
				successMessage.classList.add('hidden');
			}

			function showSuccess(message: string) {
				successMessage.textContent = message;
				successMessage.classList.remove('hidden');
				errorMessage.classList.add('hidden');
			}

			function hideMessages() {
				errorMessage.classList.add('hidden');
				successMessage.classList.add('hidden');
			}

			function updateUI() {
				if (!currentUser) return;

				if (currentUser.totp_enabled) {
					totpStatus.textContent = 'Enabled';
					totpStatus.className = 'status-badge status-enabled';
					enableSection.classList.add('hidden');
					setupSection.classList.add('hidden');
					disableSection.classList.remove('hidden');
					// Show management options, hide forms
					managementOptions.classList.remove('hidden');
					regenSection.classList.add('hidden');
					disableFormSection.classList.add('hidden');
				} else {
					totpStatus.textContent = 'Disabled';
					totpStatus.className = 'status-badge status-disabled';
					enableSection.classList.remove('hidden');
					setupSection.classList.add('hidden');
					disableSection.classList.add('hidden');
				}
			}

			async function checkAuth() {
				try {
					const response = await fetch('/api/auth/me');
					loading.classList.add('hidden');

					if (response.ok) {
						const data = await response.json();
						if (data.user) {
							currentUser = data.user;
							content.classList.remove('hidden');
							updateUI();

							// Update nav
							loginLink.style.display = 'none';
							registerLink.style.display = 'none';

							const userSpan = document.createElement('span');
							userSpan.className = 'nav-user';
							userSpan.textContent = data.user.email;
							nav.appendChild(userSpan);

							const logoutBtn = document.createElement('button');
							logoutBtn.className = 'nav-logout';
							logoutBtn.textContent = 'Log out';
							logoutBtn.addEventListener('click', logout);
							nav.appendChild(logoutBtn);
							return;
						}
					}

					notLoggedIn.classList.remove('hidden');
				} catch (err) {
					loading.classList.add('hidden');
					notLoggedIn.classList.remove('hidden');
				}
			}

			async function logout() {
				try {
					await fetch('/api/auth/logout', { method: 'POST' });
					window.location.href = '/login';
				} catch (err) {
					console.error('Logout failed:', err);
				}
			}

			async function startSetup() {
				hideMessages();
				startSetupBtn.disabled = true;
				startSetupBtn.textContent = 'Setting up...';

				try {
					const response = await fetch('/api/auth/totp/setup', {
						method: 'POST',
					});

					const data = await response.json();

					if (!response.ok) {
						showError(data.error || 'Failed to start setup');
						startSetupBtn.disabled = false;
						startSetupBtn.textContent = 'Enable 2FA';
						return;
					}

					setupSecret = data.secret;
					secretDisplay.textContent = data.secret_display;

					// Use QR code from backend (self-hosted, no external requests)
					qrCode.src = data.qr_code;

					enableSection.classList.add('hidden');
					setupSection.classList.remove('hidden');
					verifyCode.focus();

				} catch (err) {
					showError('Network error. Please try again.');
					startSetupBtn.disabled = false;
					startSetupBtn.textContent = 'Enable 2FA';
				}
			}

			function cancelSetup() {
				hideMessages();
				setupSecret = '';
				verifyCode.value = '';
				setupSection.classList.add('hidden');
				enableSection.classList.remove('hidden');
				startSetupBtn.disabled = false;
				startSetupBtn.textContent = 'Enable 2FA';
			}

			function displayRecoveryCodes(codes: string[]) {
				recoveryCodes = codes;
				recoveryCodesGrid.innerHTML = '';
				codes.forEach(code => {
					const codeDiv = document.createElement('div');
					codeDiv.className = 'recovery-code';
					codeDiv.textContent = code;
					recoveryCodesGrid.appendChild(codeDiv);
				});
				setupSection.classList.add('hidden');
				recoveryCodesSection.classList.remove('hidden');
				savedCodesCheckbox.checked = false;
				continueBtn.disabled = true;
			}

			async function copyAllCodes() {
				const codesText = recoveryCodes.join('\n');
				try {
					await navigator.clipboard.writeText(codesText);
					copyCodesBtn.textContent = 'Copied!';
					setTimeout(() => {
						copyCodesBtn.textContent = 'Copy All Codes';
					}, 2000);
				} catch (err) {
					// Fallback for browsers without clipboard API
					const textarea = document.createElement('textarea');
					textarea.value = codesText;
					document.body.appendChild(textarea);
					textarea.select();
					document.execCommand('copy');
					document.body.removeChild(textarea);
					copyCodesBtn.textContent = 'Copied!';
					setTimeout(() => {
						copyCodesBtn.textContent = 'Copy All Codes';
					}, 2000);
				}
			}

			function onSavedCodesChange() {
				continueBtn.disabled = !savedCodesCheckbox.checked;
			}

			function finishSetup() {
				recoveryCodesSection.classList.add('hidden');
				recoveryCodes = [];
				if (isRegenerating) {
					isRegenerating = false;
					showSuccess('Recovery codes have been regenerated successfully!');
					regenBtn.disabled = false;
					regenBtn.textContent = 'Regenerate Codes';
				} else {
					showSuccess('Two-factor authentication has been enabled successfully!');
				}
				updateUI();
			}

			async function verifyAndEnable(e: Event) {
				e.preventDefault();
				hideMessages();

				const code = verifyCode.value.trim();
				const codeValidation = validateTotpCode(code);
				if (codeValidation) {
					showFieldError(verifyCode, verifyCodeError, codeValidation);
					return;
				}

				verifyBtn.disabled = true;
				verifyBtn.textContent = 'Verifying...';

				try {
					const response = await fetch('/api/auth/totp/verify', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ code }),
					});

					const data = await response.json();

					if (!response.ok) {
						showError(data.error || 'Verification failed');
						verifyBtn.disabled = false;
						verifyBtn.textContent = 'Verify & Enable';
						return;
					}

					// Success - now display recovery codes
					if (currentUser) {
						currentUser.totp_enabled = true;
					}
					setupSecret = '';
					verifyCode.value = '';

					// Show recovery codes if returned
					if (data.recovery_codes && data.recovery_codes.length > 0) {
						displayRecoveryCodes(data.recovery_codes);
					} else {
						showSuccess('Two-factor authentication has been enabled successfully!');
						updateUI();
					}

				} catch (err) {
					showError('Network error. Please try again.');
					verifyBtn.disabled = false;
					verifyBtn.textContent = 'Verify & Enable';
				}
			}

			async function disable2FA(e: Event) {
				e.preventDefault();
				hideMessages();

				const password = disablePassword.value;
				const code = disableCode.value.trim();

				let hasErrors = false;

				const passwordValidation = validatePassword(password);
				if (passwordValidation) {
					showFieldError(disablePassword, disablePasswordError, passwordValidation);
					hasErrors = true;
				}

				const codeValidation = validateTotpCode(code);
				if (codeValidation) {
					showFieldError(disableCode, disableCodeError, codeValidation);
					hasErrors = true;
				}

				if (hasErrors) {
					return;
				}

				disableBtn.disabled = true;
				disableBtn.textContent = 'Disabling...';

				try {
					const response = await fetch('/api/auth/totp/disable', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ password, code }),
					});

					const data = await response.json();

					if (!response.ok) {
						showError(data.error || 'Failed to disable 2FA');
						disableBtn.disabled = false;
						disableBtn.textContent = 'Disable 2FA';
						return;
					}

					// Success!
					if (currentUser) {
						currentUser.totp_enabled = false;
					}
					disablePassword.value = '';
					disableCode.value = '';
					showSuccess('Two-factor authentication has been disabled.');
					updateUI();

				} catch (err) {
					showError('Network error. Please try again.');
				} finally {
					disableBtn.disabled = false;
					disableBtn.textContent = 'Disable 2FA';
				}
			}

		// Show regenerate form
			function showRegenForm() {
				hideMessages();
				managementOptions.classList.add('hidden');
				regenSection.classList.remove('hidden');
				disableFormSection.classList.add('hidden');
				regenPassword.focus();
			}

			// Show disable form
			function showDisableForm() {
				hideMessages();
				managementOptions.classList.add('hidden');
				regenSection.classList.add('hidden');
				disableFormSection.classList.remove('hidden');
				disablePassword.focus();
			}

			// Cancel regenerate
			function cancelRegen() {
				hideMessages();
				regenPassword.value = '';
				regenCode.value = '';
				managementOptions.classList.remove('hidden');
				regenSection.classList.add('hidden');
			}

			// Cancel disable
			function cancelDisable() {
				hideMessages();
				disablePassword.value = '';
				disableCode.value = '';
				managementOptions.classList.remove('hidden');
				disableFormSection.classList.add('hidden');
			}

			// Regenerate recovery codes
			async function regenerateCodes(e: Event) {
				e.preventDefault();
				hideMessages();

				const password = regenPassword.value;
				const code = regenCode.value.trim();

				let hasErrors = false;

				const passwordValidation = validatePassword(password);
				if (passwordValidation) {
					showFieldError(regenPassword, regenPasswordError, passwordValidation);
					hasErrors = true;
				}

				const codeValidation = validateTotpCode(code);
				if (codeValidation) {
					showFieldError(regenCode, regenCodeError, codeValidation);
					hasErrors = true;
				}

				if (hasErrors) {
					return;
				}

				regenBtn.disabled = true;
				regenBtn.textContent = 'Regenerating...';

				try {
					const response = await fetch('/api/auth/totp/codes', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ password, code }),
					});

					const data = await response.json();

					if (!response.ok) {
						showError(data.error || 'Failed to regenerate recovery codes');
						regenBtn.disabled = false;
						regenBtn.textContent = 'Regenerate Codes';
						return;
					}

					// Success - show the new recovery codes
					regenPassword.value = '';
					regenCode.value = '';
					regenSection.classList.add('hidden');
					isRegenerating = true;
					displayRecoveryCodes(data.recovery_codes);

				} catch (err) {
					showError('Network error. Please try again.');
					regenBtn.disabled = false;
					regenBtn.textContent = 'Regenerate Codes';
				}
			}

			startSetupBtn.addEventListener('click', startSetup);
			cancelSetupBtn.addEventListener('click', cancelSetup);
			verifyForm.addEventListener('submit', verifyAndEnable);
			disableForm.addEventListener('submit', disable2FA);
			copyCodesBtn.addEventListener('click', copyAllCodes);
			savedCodesCheckbox.addEventListener('change', onSavedCodesChange);
			continueBtn.addEventListener('click', finishSetup);

			// New event listeners for regenerate/disable flow
			startRegenBtn.addEventListener('click', showRegenForm);
			startDisableBtn.addEventListener('click', showDisableForm);
			cancelRegenBtn.addEventListener('click', cancelRegen);
			cancelDisableBtn.addEventListener('click', cancelDisable);
			regenForm.addEventListener('submit', regenerateCodes);

			// Sessions management elements
			const sessionsLoading = document.getElementById('sessionsLoading') as HTMLElement;
			const sessionsList = document.getElementById('sessionsList') as HTMLElement;

			interface Session {
				id: string;
				ip_address: string;
				user_agent: string;
				created_at: string;
				expires_at: string;
				is_current: boolean;
			}

			function parseUserAgent(ua: string): string {
				if (!ua) return 'Unknown device';
				// Simple user agent parsing
				if (ua.includes('Chrome')) return 'Chrome Browser';
				if (ua.includes('Firefox')) return 'Firefox Browser';
				if (ua.includes('Safari') && !ua.includes('Chrome')) return 'Safari Browser';
				if (ua.includes('Edge')) return 'Edge Browser';
				if (ua.includes('MSIE') || ua.includes('Trident')) return 'Internet Explorer';
				return 'Web Browser';
			}

			function formatDate(dateStr: string): string {
				const date = new Date(dateStr);
				return date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
			}

			async function loadSessions() {
				try {
					const response = await fetch('/api/auth/sessions');
					if (!response.ok) {
						sessionsLoading.textContent = 'Failed to load sessions';
						return;
					}

					const data = await response.json();
					const sessions: Session[] = data.sessions || [];

					sessionsLoading.classList.add('hidden');
					sessionsList.classList.remove('hidden');

					if (sessions.length === 0) {
						sessionsList.innerHTML = '<div class="no-sessions">No active sessions found</div>';
						return;
					}

					sessionsList.innerHTML = sessions.map(session => `
						<div class="session-item ${session.is_current ? 'current' : ''}" data-id="${session.id}">
							<div class="session-info">
								<div class="session-device">
									${parseUserAgent(session.user_agent)}
									${session.is_current ? '<span class="session-current-badge">Current</span>' : ''}
								</div>
								<div class="session-meta">
									${session.ip_address || 'Unknown IP'} · Created ${formatDate(session.created_at)}
								</div>
							</div>
							${!session.is_current ? `<button class="btn btn-revoke" data-session-id="${session.id}">Revoke</button>` : ''}
						</div>
					`).join('');

					// Add click handlers for revoke buttons
					sessionsList.querySelectorAll('.btn-revoke').forEach(btn => {
						btn.addEventListener('click', async (e) => {
							const target = e.target as HTMLButtonElement;
							const sessionId = target.dataset.sessionId;
							if (!sessionId) return;

							target.disabled = true;
							target.textContent = 'Revoking...';

							try {
								const response = await fetch(`/api/auth/sessions/${sessionId}`, {
									method: 'DELETE',
								});

								if (!response.ok) {
									const data = await response.json();
									showError(data.error || 'Failed to revoke session');
									target.disabled = false;
									target.textContent = 'Revoke';
									return;
								}

								showSuccess('Session revoked successfully');
								loadSessions(); // Refresh the list
							} catch (err) {
								showError('Network error. Please try again.');
								target.disabled = false;
								target.textContent = 'Revoke';
							}
						});
					});

				} catch (err) {
					sessionsLoading.textContent = 'Failed to load sessions';
				}
			}

			// Modify checkAuth to also load sessions after successful auth
			const originalCheckAuth = checkAuth;
			checkAuth = async function() {
				await originalCheckAuth();
				if (currentUser) {
					loadSessions();
				}
			};

			checkAuth();
		</script>
	</body>
</html>
