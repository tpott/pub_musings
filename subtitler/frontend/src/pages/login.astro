---
import DevConsoleForwarder from '../components/DevConsoleForwarder.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/theme.css';
---

<html lang="en">
	<head>
		<ThemeInit />
		<DevConsoleForwarder />
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Login - Subtitler</title>
		<style>
			body {
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.theme-toggle-wrapper {
				position: fixed;
				top: 1rem;
				right: 1rem;
			}
			.container {
				max-width: 400px;
				width: 100%;
				padding: 2rem;
			}
			.card {
				background-color: var(--secondary-bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 2rem;
			}
			.header {
				text-align: center;
				margin-bottom: 2rem;
			}
			.logo-link {
				text-decoration: none;
				color: var(--text-color);
			}
			h1 {
				font-size: 1.75rem;
				font-weight: 600;
				margin-bottom: 0.5rem;
			}
			.subtitle {
				color: var(--text-secondary);
				font-size: 0.95rem;
			}
			.form-group {
				margin-bottom: 1.25rem;
			}
			label {
				display: block;
				font-weight: 500;
				margin-bottom: 0.5rem;
				font-size: 0.9rem;
			}
			input[type="email"],
			input[type="password"],
			input[type="text"] {
				width: 100%;
				padding: 0.75rem 1rem;
				border: 1px solid var(--border-color);
				border-radius: 6px;
				font-size: 1rem;
				transition: border-color 0.2s, box-shadow 0.2s;
			}
			.totp-input {
				font-family: 'Menlo', 'Monaco', monospace;
				font-size: 1.5rem;
				letter-spacing: 0.3rem;
				text-align: center;
			}
			.hidden {
				display: none !important;
			}
			.totp-info {
				text-align: center;
				margin-bottom: 1rem;
				font-size: 0.9rem;
				color: var(--text-secondary);
			}
			input:focus {
				outline: none;
				border-color: var(--accent-color);
				box-shadow: 0 0 0 3px var(--focus-ring);
			}
			input.input-error {
				border-color: var(--error-color);
			}
			input.input-error:focus {
				box-shadow: 0 0 0 3px var(--error-focus-ring);
			}
			.field-error {
				color: var(--error-color);
				font-size: 0.8rem;
				margin-top: 0.25rem;
				display: none;
			}
			.btn {
				width: 100%;
				padding: 0.875rem 1rem;
				border: none;
				border-radius: 6px;
				font-size: 1rem;
				font-weight: 500;
				cursor: pointer;
				transition: background-color 0.2s, opacity 0.2s;
			}
			.btn-primary {
				background-color: var(--text-color);
				color: white;
			}
			.btn-primary:hover:not(:disabled) {
				opacity: 0.9;
			}
			.btn:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
			.btn:focus {
				outline: 2px solid var(--accent-color);
				outline-offset: 2px;
			}
			.error-message {
				background-color: var(--error-bg);
				border: 1px solid var(--error-border);
				color: var(--error-color);
				padding: 0.75rem 1rem;
				border-radius: 6px;
				margin-bottom: 1.25rem;
				font-size: 0.9rem;
				display: none;
			}
			.footer {
				text-align: center;
				margin-top: 1.5rem;
				font-size: 0.9rem;
				color: var(--text-secondary);
			}
			.footer a {
				color: var(--accent-color);
				text-decoration: none;
			}
			.footer a:hover {
				text-decoration: underline;
			}
			.recovery-link {
				text-align: center;
				margin-top: 1rem;
				font-size: 0.85rem;
			}
			.recovery-link a {
				color: var(--accent-color);
				text-decoration: none;
				cursor: pointer;
			}
			.recovery-link a:hover {
				text-decoration: underline;
			}
			.recovery-code-input {
				font-family: 'Menlo', 'Monaco', monospace;
				font-size: 1.2rem;
				letter-spacing: 0.1rem;
				text-align: center;
			}
			.back-link {
				display: block;
				text-align: center;
				margin-top: 0.75rem;
				font-size: 0.85rem;
				color: var(--accent-color);
				text-decoration: none;
				cursor: pointer;
			}
			.back-link:hover {
				text-decoration: underline;
			}
			.success-message {
				background-color: var(--success-bg);
				border: 1px solid var(--success-border);
				color: var(--success-color);
				padding: 0.75rem 1rem;
				border-radius: 6px;
				margin-bottom: 1.25rem;
				font-size: 0.9rem;
				display: none;
			}
			.warning-message {
				background-color: var(--warning-bg, #fffbeb);
				border: 1px solid var(--warning-border, #fde68a);
				color: var(--warning-color, #92400e);
				padding: 0.75rem 1rem;
				border-radius: 6px;
				margin-bottom: 1.25rem;
				font-size: 0.9rem;
				display: none;
			}
			.warning-message button {
				background: none;
				border: none;
				color: inherit;
				text-decoration: underline;
				cursor: pointer;
				padding: 0;
				font: inherit;
			}
			.warning-message button:hover {
				text-decoration: none;
			}
			.forgot-link {
				text-align: right;
				margin-top: -0.5rem;
				margin-bottom: 1.25rem;
				font-size: 0.85rem;
			}
			.forgot-link a {
				color: var(--accent-color);
				text-decoration: none;
			}
			.forgot-link a:hover {
				text-decoration: underline;
			}
			.link-button {
				background: none;
				border: none;
				padding: 0;
				font: inherit;
				color: var(--accent-color);
				cursor: pointer;
				text-decoration: none;
			}
			.link-button:hover {
				text-decoration: underline;
			}
			.link-button:focus {
				outline: 2px solid var(--accent-color);
				outline-offset: 2px;
			}
			/* Mobile responsive styles */
			@media (max-width: 480px) {
				.container {
					padding: 1rem;
				}
				.card {
					padding: 1.5rem;
				}
				h1 {
					font-size: 1.5rem;
				}
				.btn {
					min-height: 44px;
				}
				.totp-input {
					font-size: 1.25rem;
					letter-spacing: 0.2rem;
				}
			}
			@media (max-width: 375px) {
				.container {
					padding: 0.75rem;
				}
				.card {
					padding: 1.25rem;
				}
				h1 {
					font-size: 1.25rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="theme-toggle-wrapper">
			<ThemeToggle />
		</div>
		<div class="container">
			<div class="card">
				<div class="header">
					<a href="/" class="logo-link">
						<h1>Subtitler</h1>
					</a>
					<p class="subtitle">Welcome back</p>
				</div>

				<div id="error" class="error-message" role="alert" aria-live="assertive"></div>
				<div id="success" class="success-message" role="status" aria-live="polite"></div>
				<div id="verifyWarning" class="warning-message" role="alert">
					Please verify your email address before logging in.
					<button type="button" id="resendVerifyBtn">Resend verification email</button>
				</div>

				<form id="loginForm">
					<div id="credentialsSection">
						<div class="form-group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" required autocomplete="email" />
							<div id="emailError" class="field-error"></div>
						</div>
						<div class="form-group">
							<label for="password">Password</label>
							<input type="password" id="password" name="password" required autocomplete="current-password" />
							<div id="passwordError" class="field-error"></div>
						</div>
						<div class="forgot-link">
							<a href="/forgot-password">Forgot password?</a>
						</div>
					</div>
					<div id="totpSection" class="hidden">
						<p class="totp-info">Enter the 6-digit code from your authenticator app</p>
						<div class="form-group">
							<label for="totpCode">Authentication Code</label>
							<input type="text" id="totpCode" name="totpCode" class="totp-input" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code" />
							<div id="totpError" class="field-error"></div>
						</div>
						<div class="recovery-link">
							<button type="button" id="showRecoveryLink" class="link-button">Lost access to authenticator?</button>
						</div>
					</div>
					<div id="recoverySection" class="hidden">
						<p class="totp-info">Enter one of your recovery codes to disable 2FA and log in</p>
						<div class="form-group">
							<label for="recoveryCode">Recovery Code</label>
							<input type="text" id="recoveryCode" name="recoveryCode" class="recovery-code-input" maxlength="9" placeholder="XXXX-XXXX" autocomplete="off" />
						</div>
						<button type="button" id="backToTotpLink" class="back-link link-button">Back to authenticator code</button>
					</div>
					<button type="submit" class="btn btn-primary" id="submitBtn">Log in</button>
				</form>

				<div class="footer">
					<p>Don't have an account? <a href="/register">Sign up</a></p>
				</div>
			</div>
		</div>

		<script>
			import { validateEmail, validatePassword, validateTotpCode } from '../utils/validation';

			const form = document.getElementById('loginForm') as HTMLFormElement;
			const errorDiv = document.getElementById('error') as HTMLElement;
			const successDiv = document.getElementById('success') as HTMLElement;
			const verifyWarningDiv = document.getElementById('verifyWarning') as HTMLElement;
			const resendVerifyBtn = document.getElementById('resendVerifyBtn') as HTMLButtonElement;
			const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
			const emailInput = document.getElementById('email') as HTMLInputElement;
			const passwordInput = document.getElementById('password') as HTMLInputElement;
			const totpInput = document.getElementById('totpCode') as HTMLInputElement;
			const recoveryCodeInput = document.getElementById('recoveryCode') as HTMLInputElement;
			const credentialsSection = document.getElementById('credentialsSection') as HTMLElement;
			const totpSection = document.getElementById('totpSection') as HTMLElement;
			const recoverySection = document.getElementById('recoverySection') as HTMLElement;
			const showRecoveryLink = document.getElementById('showRecoveryLink') as HTMLButtonElement;
			const backToTotpLink = document.getElementById('backToTotpLink') as HTMLButtonElement;
			const emailError = document.getElementById('emailError') as HTMLElement;
			const passwordError = document.getElementById('passwordError') as HTMLElement;
			const totpError = document.getElementById('totpError') as HTMLElement;

			let totpRequired = false;
			let recoveryMode = false;
			let unverifiedEmail = '';

			function clearFieldError(input: HTMLInputElement, errorEl: HTMLElement) {
				input.classList.remove('input-error');
				errorEl.style.display = 'none';
				errorEl.textContent = '';
			}

			function showFieldError(input: HTMLInputElement, errorEl: HTMLElement, message: string) {
				input.classList.add('input-error');
				errorEl.textContent = message;
				errorEl.style.display = 'block';
			}

			// Add blur validation
			emailInput.addEventListener('blur', () => {
				const error = validateEmail(emailInput.value);
				if (error) {
					showFieldError(emailInput, emailError, error);
				} else {
					clearFieldError(emailInput, emailError);
				}
			});

			passwordInput.addEventListener('blur', () => {
				const error = validatePassword(passwordInput.value);
				if (error) {
					showFieldError(passwordInput, passwordError, error);
				} else {
					clearFieldError(passwordInput, passwordError);
				}
			});

			totpInput.addEventListener('blur', () => {
				if (totpRequired && totpInput.value) {
					const error = validateTotpCode(totpInput.value);
					if (error) {
						showFieldError(totpInput, totpError, error);
					} else {
						clearFieldError(totpInput, totpError);
					}
				}
			});

			// Clear errors on input
			emailInput.addEventListener('input', () => clearFieldError(emailInput, emailError));
			passwordInput.addEventListener('input', () => clearFieldError(passwordInput, passwordError));
			totpInput.addEventListener('input', () => clearFieldError(totpInput, totpError));

			function showError(message: string) {
				errorDiv.textContent = message;
				errorDiv.style.display = 'block';
				successDiv.style.display = 'none';
			}

			function showSuccess(message: string) {
				successDiv.textContent = message;
				successDiv.style.display = 'block';
				errorDiv.style.display = 'none';
			}

			function hideMessages() {
				errorDiv.style.display = 'none';
				successDiv.style.display = 'none';
				verifyWarningDiv.style.display = 'none';
			}

			function showVerifyWarning(email: string) {
				unverifiedEmail = email;
				verifyWarningDiv.style.display = 'block';
				errorDiv.style.display = 'none';
				successDiv.style.display = 'none';
			}

			// Resend verification email
			resendVerifyBtn.addEventListener('click', async () => {
				if (!unverifiedEmail) return;

				resendVerifyBtn.disabled = true;
				resendVerifyBtn.textContent = 'Sending...';

				try {
					const response = await fetch('/api/auth/resend-verification', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({ email: unverifiedEmail }),
					});

					if (response.ok) {
						resendVerifyBtn.textContent = 'Sent!';
						setTimeout(() => {
							resendVerifyBtn.textContent = 'Resend verification email';
							resendVerifyBtn.disabled = false;
						}, 3000);
					} else {
						resendVerifyBtn.textContent = 'Failed';
						setTimeout(() => {
							resendVerifyBtn.textContent = 'Resend verification email';
							resendVerifyBtn.disabled = false;
						}, 3000);
					}
				} catch (err) {
					resendVerifyBtn.textContent = 'Failed';
					setTimeout(() => {
						resendVerifyBtn.textContent = 'Resend verification email';
						resendVerifyBtn.disabled = false;
					}, 3000);
				}
			});

			function setLoading(loading: boolean) {
				submitBtn.disabled = loading;
				if (recoveryMode) {
					submitBtn.textContent = loading ? 'Recovering...' : 'Recover Account';
				} else {
					submitBtn.textContent = loading ? 'Logging in...' : 'Log in';
				}
			}

			function showTotpInput() {
				totpRequired = true;
				recoveryMode = false;
				credentialsSection.classList.add('hidden');
				totpSection.classList.remove('hidden');
				recoverySection.classList.add('hidden');
				submitBtn.textContent = 'Log in';
				totpInput.focus();
			}

			function showRecoveryInput() {
				recoveryMode = true;
				totpSection.classList.add('hidden');
				recoverySection.classList.remove('hidden');
				submitBtn.textContent = 'Recover Account';
				recoveryCodeInput.focus();
			}

			function backToTotp() {
				recoveryMode = false;
				recoverySection.classList.add('hidden');
				totpSection.classList.remove('hidden');
				submitBtn.textContent = 'Log in';
				recoveryCodeInput.value = '';
				totpInput.focus();
			}

			showRecoveryLink.addEventListener('click', showRecoveryInput);
			backToTotpLink.addEventListener('click', backToTotp);

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				hideMessages();

				const email = emailInput.value.trim();
				const password = passwordInput.value;
				const totpCode = totpInput.value.trim();
				const recoveryCode = recoveryCodeInput.value.trim().toUpperCase();

				// Validate fields
				let hasErrors = false;

				const emailValidation = validateEmail(email);
				if (emailValidation) {
					showFieldError(emailInput, emailError, emailValidation);
					hasErrors = true;
				}

				const passwordValidation = validatePassword(password);
				if (passwordValidation) {
					showFieldError(passwordInput, passwordError, passwordValidation);
					hasErrors = true;
				}

				if (totpRequired && !recoveryMode) {
					const totpValidation = validateTotpCode(totpCode);
					if (totpValidation) {
						showFieldError(totpInput, totpError, totpValidation);
						hasErrors = true;
					}
				}

				if (hasErrors) {
					return;
				}

				setLoading(true);

				// Handle recovery mode
				if (recoveryMode) {
					if (!recoveryCode) {
						showError('Please enter a recovery code');
						setLoading(false);
						return;
					}

					try {
						const response = await fetch('/api/auth/totp/recover', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
							},
							body: JSON.stringify({
								email,
								password,
								recovery_code: recoveryCode,
							}),
						});

						const data = await response.json();

						if (!response.ok) {
							showError(data.error || 'Recovery failed');
							setLoading(false);
							return;
						}

						// Recovery successful - 2FA has been disabled, redirect to videos
						window.location.href = '/videos';
					} catch (err) {
						showError('Network error. Please try again.');
						setLoading(false);
					}
					return;
				}

				// Normal login flow

				try {
					const body: { email: string; password: string; totp_code?: string } = { email, password };
					if (totpRequired && totpCode) {
						body.totp_code = totpCode;
					}

					const response = await fetch('/api/auth/login', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify(body),
					});

					const data = await response.json();

					if (!response.ok) {
						// Check if 2FA is required
						if (data.totp_required) {
							showTotpInput();
							setLoading(false);
							return;
						}
						// Check if email verification is required
						if (data.email_not_verified) {
							showVerifyWarning(email);
							setLoading(false);
							return;
						}
						showError(data.error || 'Login failed');
						setLoading(false);
						return;
					}

					// Login successful - redirect to videos page
					window.location.href = '/videos';
				} catch (err) {
					showError('Network error. Please try again.');
					setLoading(false);
				}
			});
		</script>
	</body>
</html>
