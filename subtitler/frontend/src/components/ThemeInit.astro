---
// ThemeInit component - inlines a script that runs immediately to set theme before render
// This prevents flash of wrong theme on page load
---

<script is:inline>
	// Run immediately to set theme class before any styles are applied
	(function() {
		var THEME_KEY = 'subtitler:theme';
		var savedTheme = localStorage.getItem(THEME_KEY);
		var systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

		if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
			document.documentElement.classList.add('dark');
		}
	})();
</script>
