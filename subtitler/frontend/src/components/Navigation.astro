---
// Navigation component - renders the main navigation bar with auth-aware links
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	showSettings?: boolean;
}

const { showSettings = false } = Astro.props;
---

<nav class="nav" id="nav" data-show-settings={showSettings}>
	<ThemeToggle />
	<a href="/login" class="nav-link" id="loginLink">Log in</a>
	<a href="/register" class="nav-link" id="registerLink">Sign up</a>
</nav>

<style>
	.nav {
		display: flex;
		justify-content: flex-end;
		padding: 1rem 2rem;
		gap: 1rem;
	}

	.nav-link {
		color: var(--text-color);
		text-decoration: none;
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
		border-radius: 6px;
		transition: background-color 0.2s;
	}

	.nav-link:hover {
		background-color: var(--border-color);
	}

	.nav-link:focus-visible {
		outline: 2px solid var(--accent-color);
		outline-offset: 2px;
	}

	.nav-user {
		color: var(--text-secondary);
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
	}

	.nav-logout {
		background: none;
		border: none;
		color: var(--text-color);
		font-size: 0.9rem;
		padding: 0.5rem 1rem;
		border-radius: 6px;
		cursor: pointer;
		transition: background-color 0.2s;
	}

	.nav-logout:hover {
		background-color: var(--border-color);
	}

	.nav-logout:focus-visible {
		outline: 2px solid var(--accent-color);
		outline-offset: 2px;
	}

	@media (max-width: 480px) {
		.nav {
			padding: 0.75rem 1rem;
			gap: 0.5rem;
			flex-wrap: wrap;
		}

		.nav-link,
		.nav-logout {
			padding: 0.5rem 0.75rem;
			font-size: 0.85rem;
			min-height: 44px;
			display: flex;
			align-items: center;
		}
	}
</style>
